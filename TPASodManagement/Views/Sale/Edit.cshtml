@model TpaSodManagement.ViewModels.Sale.SaleEditViewModel

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? false;
    ViewData["Title"] = isDetailsView ? "Sale Details" : "Edit Sale";
    string disabledAttr = isDetailsView ? "disabled" : null;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@(isDetailsView ? "Sale Details" : "Edit Sale")</h5>
                </div>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="SaleId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SaleNumber" class="form-label">Sale Number <span class="text-danger">*</span></label>
                                <input asp-for="SaleNumber" class="form-control" disabled="@disabledAttr" required />
                                <span asp-validation-for="SaleNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="InvoiceNumber" class="form-label">Invoice Number</label>
                                <input asp-for="InvoiceNumber" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
                            </div>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PurchaseOrderNumber" class="form-label">Purchase Order Number</label>
                                    <input asp-for="PurchaseOrderNumber" class="form-control" disabled="@disabledAttr" />
                                    <span asp-validation-for="PurchaseOrderNumber" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="PurchaseOrderNumber" />
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserId" class="form-label">User <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select" asp-items="Model.Users" disabled="@disabledAttr" required>
                                    <option value="">-- Select User --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmId" class="form-label">Farm <span class="text-danger">*</span></label>
                                <select asp-for="FarmId" class="form-select" asp-items="Model.Farms" disabled="@disabledAttr" required>
                                    <option value="">-- Select Farm --</option>
                                </select>
                                <span asp-validation-for="FarmId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerId" class="form-label">Customer <span class="text-danger">*</span></label>
                                <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers" id="customerSelect" disabled="@disabledAttr" required>
                                    <option value="">-- Select Customer --</option>
                                    <option value="__create_new__">+ Create New Customer</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FieldId" class="form-label">Field <span class="text-danger">*</span></label>
                                <select asp-for="FieldId" class="form-select" asp-items="Model.Fields" disabled="@disabledAttr" required>
                                    <option value="">-- Select Field --</option>
                                </select>
                                <span asp-validation-for="FieldId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SaleTypeId" class="form-label">Sale Type <span class="text-danger">*</span></label>
                                <select asp-for="SaleTypeId" class="form-select" asp-items="Model.SaleTypes" disabled="@disabledAttr" required>
                                    <option value="">-- Select Sale Type --</option>
                                </select>
                                <span asp-validation-for="SaleTypeId" class="text-danger"></span>
                            </div>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="StatusId" class="form-label">Status <span class="text-danger">*</span></label>
                                    <select asp-for="StatusId" class="form-select" asp-items="Model.Statuses" disabled="@disabledAttr" required>
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="StatusId" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="StatusId" />
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SaleDate" class="form-label">Sale Date <span class="text-danger">*</span></label>
                                <input asp-for="SaleDate" type="date" class="form-control" disabled="@disabledAttr" required />
                                <span asp-validation-for="SaleDate" class="text-danger"></span>
                            </div>

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DueDate" class="form-label">Due Date</label>
                                    <input asp-for="DueDate" type="date" class="form-control" disabled="@disabledAttr" />
                                    <span asp-validation-for="DueDate" class="text-danger"></span>
                                </div>
                            }
                        </div>
                        @if (!User.IsInRole("SuperAdmin"))
                        {
                            <input type="hidden" asp-for="DueDate" />
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CurrencyId" class="form-label">Currency <span class="text-danger">*</span></label>
                                <select asp-for="CurrencyId" class="form-select" asp-items="Model.Currencies" disabled="@disabledAttr" required>
                                    <option value="">-- Select Currency --</option>
                                </select>
                                <span asp-validation-for="CurrencyId" class="text-danger"></span>
                            </div>

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PaymentTermsDays" class="form-label">Payment Terms Days</label>
                                    <input asp-for="PaymentTermsDays" type="number" class="form-control" disabled="@disabledAttr" />
                                    <span asp-validation-for="PaymentTermsDays" class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" asp-for="PaymentTermsDays" />
                            }
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="SubtotalAmount" class="form-label">Subtotal Amount <span class="text-danger">*</span></label>
                                    <input asp-for="SubtotalAmount" type="number" step="0.01" class="form-control" disabled="@disabledAttr" required />
                                    <span asp-validation-for="SubtotalAmount" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="TaxAmount" class="form-label">Tax Amount <span class="text-danger">*</span></label>
                                    <input asp-for="TaxAmount" type="number" step="0.01" class="form-control" disabled="@disabledAttr" required />
                                    <span asp-validation-for="TaxAmount" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DiscountAmount" class="form-label">Discount Amount <span class="text-danger">*</span></label>
                                    <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control" disabled="@disabledAttr" required />
                                    <span asp-validation-for="DiscountAmount" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="TotalAmount" class="form-label">Total Amount <span class="text-danger">*</span></label>
                                    <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" disabled="@disabledAttr" required />
                                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="SubtotalAmount" />
                            <input type="hidden" asp-for="TaxAmount" />
                            <input type="hidden" asp-for="DiscountAmount" />
                            <input type="hidden" asp-for="TotalAmount" />
                        }

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" rows="3" class="form-control" disabled="@disabledAttr"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" disabled="@disabledAttr" />
                            </div>
                        </div>

                        @if (isDetailsView)
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CreatedDate" class="form-label">Created Date</label>
                                    <input type="text" class="form-control" value="@(Model.CreatedDate?.ToString("MM/dd/yyyy"))" readonly />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="UpdatedDate" class="form-label">Updated Date</label>
                                    <input type="text" class="form-control" value="@(Model.UpdatedDate?.ToString("MM/dd/yyyy"))" readonly />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UpdatedByUserId" class="form-label">Updated By User</label>
                                <select asp-for="UpdatedByUserId" class="form-select" asp-items="ViewBag.UpdatedByUserId" disabled>
                                    <option value="">-- Select User --</option>
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="UpdatedByUserId" />
                            <input type="hidden" asp-for="CreatedDate" />
                            <input type="hidden" asp-for="UpdatedDate" />
                        }

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">@(isDetailsView ? "Back" : "Cancel")</a>

                            @if (!isDetailsView)
                            {
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            }
                            else
                            {
                                @if (User.HasPermission("Sale.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.SaleId" class="btn btn-warning">Edit</a>
                                }
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isDetailsView)
    {
        <partial name="_ValidationScriptsPartial" />
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var customerSelect = document.getElementById('customerSelect');
                if (customerSelect && !customerSelect.disabled) {
                    customerSelect.addEventListener('change', function() {
                        if (this.value === '__create_new__') {
                            var returnUrl = '@Url.Action("Edit", "Sale", new { id = Model.SaleId })';
                            window.location.href = '@Url.Action("Create", "Customer")' + '?returnUrl=' + encodeURIComponent(returnUrl);
                        }
                    });
                }
            });
        </script>
    }
}
