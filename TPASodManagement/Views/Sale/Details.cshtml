@model TpaSodManagement.Models.Db.Sale

@{
    ViewData["Title"] = "Details";
}
<br />
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Details</h1>
</div>

<div>
    <h4>Sale</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Sale Number
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SaleNumber)
        </dd>
        <dt class = "col-sm-2">
            Invoice Number
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.InvoiceNumber)
        </dd>
        <dt class = "col-sm-2">
            Purchase Order Number
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrderNumber)
        </dd>
        <dt class = "col-sm-2">
            Sale Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SaleDate)
        </dd>
        <dt class = "col-sm-2">
            Due Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DueDate)
        </dd>
        <dt class = "col-sm-2">
            Subtotal Amount
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SubtotalAmount)
        </dd>
        <dt class = "col-sm-2">
            Tax Amount
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TaxAmount)
        </dd>
        <dt class = "col-sm-2">
            Discount Amount
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DiscountAmount)
        </dd>
        <dt class = "col-sm-2">
            Total Amount
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TotalAmount)
        </dd>
        <dt class = "col-sm-2">
            Payment Terms Days
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentTermsDays)
        </dd>
        <dt class = "col-sm-2">
            Notes
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
        <dt class = "col-sm-2">
            Created Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class = "col-sm-2">
            Updated Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UpdatedDate)
        </dd>
