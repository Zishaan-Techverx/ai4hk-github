        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Currency.CurrencyId)
        </dd>
        <dt class = "col-sm-2">
            Customer
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.CustomerId)
        </dd>
        <dt class = "col-sm-2">
            Farm
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Farm.FarmId)
        </dd>
        <dt class = "col-sm-2">
            Sale Type
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SaleType.SaleTypeId)
        </dd>
        <dt class = "col-sm-2">
            Status
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status.StatusId)
        </dd>
        <dt class = "col-sm-2">
