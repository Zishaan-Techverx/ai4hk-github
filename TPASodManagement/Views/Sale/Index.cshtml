@model IEnumerable<TpaSodManagement.ViewModels.Sale.SaleItemViewModel>

@{
    ViewData["Title"] = "Index";
    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
}

<br/>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Sales</h1>

    @if (User.HasPermission("Sale.Create"))
    {
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    }
</div>
<br />

<!-- Column Filter and Page Size Controls -->
<div class="row mb-3">
    <div class="col-md-6">
        <label for="columnFilterSelect" class="form-label">Hide Columns</label>
        <div class="d-flex align-items-start gap-2">
            <select id="columnFilterSelect" class="form-select" style="width: auto; min-width: 200px;">
                <option value="">-- Select Column to Hide --</option>
            </select>
            <button type="button" class="btn btn-sm btn-secondary" onclick="clearColumnFilter()">Show All</button>
        </div>
        <div id="hiddenColumnsBadges" class="mt-2 d-flex flex-wrap gap-1"></div>
    </div>
    <div class="col-md-6 text-end">
        <label for="pageSizeSelect" class="form-label">Page Size</label>
        <select id="pageSizeSelect" class="form-select d-inline-block" style="width: auto;"
            onchange="changePageSize(this.value)">
            <option value="10" selected="@(pageSize == 10)">10</option>
            <option value="15" selected="@(pageSize == 15)">15</option>
            <option value="20" selected="@(pageSize == 20)">20</option>
            <option value="25" selected="@(pageSize == 25)">25</option>
            <option value="50" selected="@(pageSize == 50)">50</option>
            <option value="100" selected="@(pageSize == 100)">100</option>
        </select>
    </div>
</div>

<div class="card card-body shadow-sm">
    <div class="table-responsive">
        <table class="table" id="dataTable">
            <thead>
                <tr>
                    <th data-column="SaleNumber">Sale Number</th>
                    <th data-column="InvoiceNumber">Invoice Number</th>
                    <th data-column="PurchaseOrderNumber">Purchase Order Number</th>
                    <th data-column="SaleDate">Sale Date</th>
                    <th data-column="DueDate">Due Date</th>
                    <th data-column="SubtotalAmount">Subtotal Amount</th>
                    <th data-column="TaxAmount">Tax Amount</th>
                    <th data-column="DiscountAmount">Discount Amount</th>
                    <th data-column="TotalAmount">Total Amount</th>
                    <th data-column="PaymentTermsDays">Payment Terms Days</th>
                    <th data-column="Notes">Notes</th>
                    <th data-column="CreatedDate">Created Date</th>
                    <th data-column="UpdatedDate">Updated Date</th>
                    <th data-column="Currency">Currency</th>
                    <th data-column="Customer">Customer</th>
                    <th data-column="Farm">Farm</th>
                    <th data-column="SaleType">Sale Type</th>
                    <th data-column="Status">Status</th>
                    <th data-column="UpdatedByUser">Updated By User</th>
                    <th data-column="User">User</th>
                    <th data-column="Actions" class="no-hide-column">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr id="row-@item.SaleId">
                        <td data-column="SaleNumber">@Html.DisplayFor(modelItem => item.SaleNumber)</td>
                        <td data-column="InvoiceNumber">@Html.DisplayFor(modelItem => item.InvoiceNumber)</td>
                        <td data-column="PurchaseOrderNumber">@Html.DisplayFor(modelItem => item.PurchaseOrderNumber)</td>
                        <td data-column="SaleDate">@Html.DisplayFor(modelItem => item.SaleDate)</td>
                        <td data-column="DueDate">@Html.DisplayFor(modelItem => item.DueDate)</td>
                        <td data-column="SubtotalAmount">@Html.DisplayFor(modelItem => item.SubtotalAmount)</td>
                        <td data-column="TaxAmount">@Html.DisplayFor(modelItem => item.TaxAmount)</td>
                        <td data-column="DiscountAmount">@Html.DisplayFor(modelItem => item.DiscountAmount)</td>
                        <td data-column="TotalAmount">@Html.DisplayFor(modelItem => item.TotalAmount)</td>
                        <td data-column="PaymentTermsDays">@Html.DisplayFor(modelItem => item.PaymentTermsDays)</td>
                        <td data-column="Notes">@Html.DisplayFor(modelItem => item.Notes)</td>
                        <td data-column="CreatedDate">@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                        <td data-column="UpdatedDate">@Html.DisplayFor(modelItem => item.UpdatedDate)</td>
                        <td data-column="Currency">@(item.CurrencyName ?? "N/A")</td>
                        <td data-column="Customer">@(item.CustomerDisplay ?? $"Customer #{item.CustomerId}")</td>
                        <td data-column="Farm">@(item.FarmDisplay ?? $"Farm #{item.FarmId}")</td>
                        <td data-column="SaleType">@(item.SaleTypeName ?? "N/A")</td>
                        <td data-column="Status">@(item.StatusName ?? "N/A")</td>
                        <td data-column="UpdatedByUser">@(item.UpdatedByUserName ?? "N/A")</td>
                        <td data-column="User">@(item.UserName ?? "N/A")</td>
                        <td style="display: flex; gap: 8px; align-items: center;">
                            @if (User.HasPermission("Sale.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.SaleId">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </a>
                            }

                            @if (User.HasPermission("Sale.Detail"))
                            {
                                <a asp-action="Details" asp-route-id="@item.SaleId">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>
                            }

                            @if (User.HasPermission("Sale.Delete"))
                            {
                                <a href="#" class="delete-btn" data-id="@item.SaleId" 
                                    data-name="@(!string.IsNullOrEmpty(item.SaleNumber) ? item.SaleNumber : $"Sale #{item.SaleId}")"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete">
                                    <i class="fa-solid fa-trash-can" style="color: #ff0000;"></i>
                                </a>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<br />
<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
            <a class="page-link"
                href="@Url.Action("Index", new { pageNumber = pageNumber - 1, pageSize = pageSize })">Previous</a>
        </li>

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = pageSize })">@i</a>
            </li>
        }

        <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
            <a class="page-link"
                href="@Url.Action("Index", new { pageNumber = pageNumber + 1, pageSize = pageSize })">Next</a>
        </li>
    </ul>
</nav>

<div class="text-muted mt-2">
    Showing @((pageNumber - 1) * pageSize + 1) to @Math.Min(pageNumber * pageSize, totalCount) of @totalCount records
</div>

<br />
<br />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const moduleName = 'Sale';
        const storageKey = `hiddenColumns_${moduleName}`;
        const table = document.getElementById('dataTable');
        const filterSelect = document.getElementById('columnFilterSelect');
        const hiddenColumnsBadges = document.getElementById('hiddenColumnsBadges');
        
        if (!table || !filterSelect) return;
        
        // Get all column headers except Actions
        const headers = table.querySelectorAll('thead th[data-column]:not([data-column="Actions"])');
        const columnMap = new Map(); // Store column name -> display name mapping
        
        // Populate dropdown
        headers.forEach(header => {
            const columnName = header.getAttribute('data-column');
            const displayName = header.textContent.trim();
            columnMap.set(columnName, displayName);
            
            const option = document.createElement('option');
            option.value = columnName;
            option.textContent = displayName;
            filterSelect.appendChild(option);
        });
        
        // Load saved preferences
        let hiddenColumns = JSON.parse(localStorage.getItem(storageKey) || '[]');
        
        // Update UI based on saved preferences
        updateHiddenColumnsUI(hiddenColumns, columnMap);
        applyColumnVisibility(hiddenColumns);
        
        // Handle dropdown selection
        filterSelect.addEventListener('change', function() {
            const selectedColumn = this.value;
            if (!selectedColumn) return;
            
            // Toggle column visibility
            if (hiddenColumns.includes(selectedColumn)) {
                // Column is already hidden, show it
                hiddenColumns = hiddenColumns.filter(col => col !== selectedColumn);
            } else {
                // Hide the column
                hiddenColumns.push(selectedColumn);
            }
            
            // Save to localStorage
            localStorage.setItem(storageKey, JSON.stringify(hiddenColumns));
            
            // Update UI
            updateHiddenColumnsUI(hiddenColumns, columnMap);
            applyColumnVisibility(hiddenColumns);
            
            // Reset dropdown
            this.value = '';
        });
        
        function updateHiddenColumnsUI(hiddenCols, colMap) {
            hiddenColumnsBadges.innerHTML = '';
            hiddenCols.forEach(columnName => {
                const displayName = colMap.get(columnName);
                const badge = document.createElement('span');
                badge.className = 'badge bg-secondary me-1 mb-1';
                badge.style.cursor = 'pointer';
                badge.innerHTML = displayName + ' <i class="fa-solid fa-times ms-1"></i>';
                badge.addEventListener('click', function() {
                    hiddenColumns = hiddenColumns.filter(col => col !== columnName);
                    localStorage.setItem(storageKey, JSON.stringify(hiddenColumns));
                    updateHiddenColumnsUI(hiddenColumns, columnMap);
                    applyColumnVisibility(hiddenColumns);
                });
                hiddenColumnsBadges.appendChild(badge);
            });
        }
        
        function applyColumnVisibility(hiddenCols) {
            headers.forEach(header => {
                const columnName = header.getAttribute('data-column');
                const isHidden = hiddenCols.includes(columnName);
                
                // Hide/show header
                header.style.display = isHidden ? 'none' : '';
                
                // Hide/show all cells in this column
                const cells = table.querySelectorAll(`tbody td[data-column="${columnName}"]`);
                cells.forEach(cell => {
                    cell.style.display = isHidden ? 'none' : '';
                });
            });
            
            // Ensure Actions column is always visible
            const actionsHeaders = table.querySelectorAll('thead th[data-column="Actions"]');
            const actionsCells = table.querySelectorAll('tbody td[data-column="Actions"]');
            actionsHeaders.forEach(header => header.style.display = '');
            actionsCells.forEach(cell => cell.style.display = '');
        }

        document.getElementById('pageSizeSelect').value = '@pageSize';

        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const saleIdInput = document.getElementById('saleIdToDelete');
        const saleNamePlaceholder = document.getElementById('saleNamePlaceholder');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const deleteErrorAlert = document.getElementById('deleteError');
        const deleteSuccessToast = new bootstrap.Toast(document.getElementById('deleteSuccessToast'));

        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const saleId = this.getAttribute('data-id');
                const saleName = this.getAttribute('data-name');

                saleIdInput.value = saleId;
                saleNamePlaceholder.innerText = saleName;
                deleteErrorAlert.classList.add('d-none');
                confirmDeleteBtn.disabled = false;
                confirmDeleteBtn.innerHTML = 'Delete';
            });
        });

        confirmDeleteBtn.addEventListener('click', function () {
            const saleId = saleIdInput.value;
            if (!saleId) {
                deleteErrorAlert.innerText = 'Error: Sale ID not found.';
                deleteErrorAlert.classList.remove('d-none');
                return;
            }

            confirmDeleteBtn.disabled = true;
            confirmDeleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Deleting...';

            const requestBody = 'id=' + encodeURIComponent(saleId) +
                '&__RequestVerificationToken=' + encodeURIComponent(antiForgeryToken);

            fetch('@Url.Action("Delete", "Sale")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: requestBody
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const rowToRemove = document.getElementById('row-' + saleId);
                        if (rowToRemove) {
                            rowToRemove.remove();
                        }
                        deleteModal.hide();
                        deleteSuccessToast.show();
                    } else {
                        deleteErrorAlert.innerText = data.message || 'Error deleting the record. Please try again.';
                        deleteErrorAlert.classList.remove('d-none');
                    }
                })
                .catch(error => {
                    console.error('Delete failed:', error);
                    deleteErrorAlert.innerText = 'Deletion failed: ' + error.message;
                    deleteErrorAlert.classList.remove('d-none');
                })
                .finally(() => {
                    confirmDeleteBtn.disabled = false;
                    confirmDeleteBtn.innerHTML = 'Delete';
                });
        });
        
        // Make clearColumnFilter accessible and update hiddenColumns variable
        window.clearColumnFilter = function() {
            // Reset hiddenColumns variable to empty array
            hiddenColumns = [];
            
            // Clear localStorage
            localStorage.setItem(storageKey, JSON.stringify([]));
            
            // Show all columns
            headers.forEach(header => {
                const columnName = header.getAttribute('data-column');
                header.style.display = '';
                
                const cells = table.querySelectorAll(`tbody td[data-column="${columnName}"]`);
                cells.forEach(cell => {
                    cell.style.display = '';
                });
            });
            
            // Ensure Actions column is always visible
            const actionsHeaders = table.querySelectorAll('thead th[data-column="Actions"]');
            const actionsCells = table.querySelectorAll('tbody td[data-column="Actions"]');
            actionsHeaders.forEach(header => header.style.display = '');
            actionsCells.forEach(cell => cell.style.display = '');
            
            // Clear badges and update UI
            updateHiddenColumnsUI(hiddenColumns, columnMap);
            
            // Reset dropdown
            filterSelect.value = '';
        };
    });
    
    function changePageSize(size) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', size);
        url.searchParams.set('pageNumber', '1');
        window.location.href = url.toString();
    }
</script>

<!-- Toast for success message -->
<div aria-live="polite" aria-atomic="true" class="position-relative">
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="deleteSuccessToast" class="toast align-items-center text-white bg-success border-0" role="alert"
            aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    Sale deleted successfully!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                    aria-label="Close"></button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the sale: <strong id="saleNamePlaceholder"></strong>?</p>
                <div class="alert alert-danger d-none" role="alert" id="deleteError">
                    Error deleting the record. Please try again.
                </div>

                <input type="hidden" id="saleIdToDelete" />

                @Html.AntiForgeryToken()
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>