@model TpaSodManagement.Models.Db.Sale

@{
    ViewData["Title"] = "Create";
}
<br />
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Create</h1>
</div>

<h4>Sale</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label">User Id</label>
                <select asp-for="UserId" class ="form-control" asp-items="ViewBag.UserId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="FarmId" class="control-label">Farm Id</label>
                <select asp-for="FarmId" class ="form-control" asp-items="ViewBag.FarmId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="CustomerId" class="control-label">Customer Id</label>
                <select asp-for="CustomerId" class ="form-control" asp-items="ViewBag.CustomerId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="SaleTypeId" class="control-label">Sale Type Id</label>
                <select asp-for="SaleTypeId" class ="form-control" asp-items="ViewBag.SaleTypeId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="SaleNumber" class="control-label">Sale Number</label>
                <input asp-for="SaleNumber" class="form-control" />
                <span asp-validation-for="SaleNumber" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="InvoiceNumber" class="control-label">Invoice Number</label>
                <input asp-for="InvoiceNumber" class="form-control" />
                <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="PurchaseOrderNumber" class="control-label">Purchase Order Number</label>
                <input asp-for="PurchaseOrderNumber" class="form-control" />
                <span asp-validation-for="PurchaseOrderNumber" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="SaleDate" class="control-label">Sale Date</label>
                <input asp-for="SaleDate" class="form-control" />
                <span asp-validation-for="SaleDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="DueDate" class="control-label">Due Date</label>
                <input asp-for="DueDate" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="SubtotalAmount" class="control-label">Subtotal Amount</label>
                <input asp-for="SubtotalAmount" class="form-control" />
                <span asp-validation-for="SubtotalAmount" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="TaxAmount" class="control-label">Tax Amount</label>
                <input asp-for="TaxAmount" class="form-control" />
                <span asp-validation-for="TaxAmount" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="DiscountAmount" class="control-label">Discount Amount</label>
                <input asp-for="DiscountAmount" class="form-control" />
                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="TotalAmount" class="control-label">Total Amount</label>
                <input asp-for="TotalAmount" class="form-control" />
                <span asp-validation-for="TotalAmount" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="CurrencyId" class="control-label">Currency Id</label>
                <select asp-for="CurrencyId" class ="form-control" asp-items="ViewBag.CurrencyId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="PaymentTermsDays" class="control-label">Payment Terms Days</label>
                <input asp-for="PaymentTermsDays" class="form-control" />
                <span asp-validation-for="PaymentTermsDays" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="StatusId" class="control-label">Status Id</label>
                <select asp-for="StatusId" class ="form-control" asp-items="ViewBag.StatusId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Notes" class="control-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="UpdatedByUserId" class="control-label">Updated By UserId</label>
                <select asp-for="UpdatedByUserId" class ="form-control" asp-items="ViewBag.UpdatedByUserId"></select>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<br />
<br />
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
