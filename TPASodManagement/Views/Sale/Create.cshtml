@model TpaSodManagement.ViewModels.Sale.SaleEditViewModel

@{
    ViewData["Title"] = "Create Sale";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Create Sale</h5>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserId" class="form-label">User <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select" asp-items="Model.Users" required>
                                    <option value="">-- Select User --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmId" class="form-label">Farm <span class="text-danger">*</span></label>
                                <select asp-for="FarmId" class="form-select" asp-items="Model.Farms" required>
                                    <option value="">-- Select Farm --</option>
                                </select>
                                <span asp-validation-for="FarmId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerId" class="form-label">Customer <span class="text-danger">*</span></label>
                                <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers" id="customerSelect" required>
                                    <option value="">-- Select Customer --</option>
                                    <option value="__create_new__">+ Create New Customer</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SaleTypeId" class="form-label">Sale Type <span class="text-danger">*</span></label>
                                <select asp-for="SaleTypeId" class="form-select" asp-items="Model.SaleTypes" required>
                                    <option value="">-- Select Sale Type --</option>
                                </select>
                                <span asp-validation-for="SaleTypeId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SaleNumber" class="form-label">Sale Number <span class="text-danger">*</span></label>
                                <input asp-for="SaleNumber" class="form-control" required />
                                <span asp-validation-for="SaleNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="InvoiceNumber" class="form-label">Invoice Number</label>
                                <input asp-for="InvoiceNumber" class="form-control" />
                                <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
                            </div>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PurchaseOrderNumber" class="form-label">Purchase Order Number</label>
                                    <input asp-for="PurchaseOrderNumber" class="form-control" />
                                    <span asp-validation-for="PurchaseOrderNumber" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="PurchaseOrderNumber" />
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CurrencyId" class="form-label">Currency <span class="text-danger">*</span></label>
                                <select asp-for="CurrencyId" class="form-select" asp-items="Model.Currencies" required>
                                    <option value="">-- Select Currency --</option>
                                </select>
                                <span asp-validation-for="CurrencyId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SaleDate" class="form-label">Sale Date <span class="text-danger">*</span></label>
                                <input asp-for="SaleDate" type="date" class="form-control" required />
                                <span asp-validation-for="SaleDate" class="text-danger"></span>
                            </div>
                        </div>

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DueDate" class="form-label">Due Date</label>
                                    <input asp-for="DueDate" type="date" class="form-control" />
                                    <span asp-validation-for="DueDate" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="DueDate" />
                        }

                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="SubtotalAmount" class="form-label">Subtotal Amount <span class="text-danger">*</span></label>
                                    <input asp-for="SubtotalAmount" type="number" step="0.01" class="form-control" required />
                                    <span asp-validation-for="SubtotalAmount" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="TaxAmount" class="form-label">Tax Amount <span class="text-danger">*</span></label>
                                    <input asp-for="TaxAmount" type="number" step="0.01" class="form-control" required />
                                    <span asp-validation-for="TaxAmount" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DiscountAmount" class="form-label">Discount Amount <span class="text-danger">*</span></label>
                                    <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control" required />
                                    <span asp-validation-for="DiscountAmount" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="TotalAmount" class="form-label">Total Amount <span class="text-danger">*</span></label>
                                    <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" required />
                                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PaymentTermsDays" class="form-label">Payment Terms Days</label>
                                    <input asp-for="PaymentTermsDays" type="number" class="form-control" />
                                    <span asp-validation-for="PaymentTermsDays" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="StatusId" class="form-label">Status <span class="text-danger">*</span></label>
                                    <select asp-for="StatusId" class="form-select" asp-items="Model.Statuses" required>
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="StatusId" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="SubtotalAmount" value="0" />
                            <input type="hidden" asp-for="TaxAmount" value="0" />
                            <input type="hidden" asp-for="DiscountAmount" value="0" />
                            <input type="hidden" asp-for="TotalAmount" value="0" />
                            <input type="hidden" asp-for="PaymentTermsDays" />
                            <input type="hidden" asp-for="StatusId" value="@(Model.Statuses?.FirstOrDefault(s => !string.IsNullOrEmpty(s.Value))?.Value ?? "1")" />
                        }

                        @* <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UpdatedByUserId" class="form-label">Updated By User</label>
                                <select asp-for="UpdatedByUserId" class="form-select" asp-items="ViewBag.UpdatedByUserId">
                                    <option value="">-- Select User --</option>
                                </select>
                                <span asp-validation-for="UpdatedByUserId" class="text-danger"></span>
                            </div>
                        </div> *@

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" checked />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var customerSelect = document.getElementById('customerSelect');
            if (customerSelect) {
                customerSelect.addEventListener('change', function() {
                    if (this.value === '__create_new__') {
                        var returnUrl = '@Url.Action("Create", "Sale")';
                        window.location.href = '@Url.Action("Create", "Customer")' + '?returnUrl=' + encodeURIComponent(returnUrl);
                    }
                });
            }
        });
    </script>
}
