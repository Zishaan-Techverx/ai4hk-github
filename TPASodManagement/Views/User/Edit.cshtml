@model TpaSodManagement.Areas.Identity.Data.TpaSodManagementUser
@using TpaSodManagement.Models.Db

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? false;
    ViewData["Title"] = isDetailsView ? "User Details" : "Edit User";
    string disabledAttr = isDetailsView ? "disabled" : null;
    Person? person = ViewBag.Person as Person;
    Address? address = ViewBag.Address as Address;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@(isDetailsView ? "User Details" : "Edit User")</h5>
                </div>

                <div class="card-body">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @* Remove or comment out the generic validation errors section *@
                    @* @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    } *@

                    <form asp-action="Edit" method="post">

                        @Html.AntiForgeryToken()

                        @* Hidden Fields *@
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" asp-for="EmailConfirmed" />
                        <input type="hidden" asp-for="PhoneNumberConfirmed" />
                        <input type="hidden" asp-for="TwoFactorEnabled" />
                        <input type="hidden" asp-for="LockoutEnabled" />
                        <input type="hidden" asp-for="AccessFailedCount" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserName" class="form-label"></label>
                                <input asp-for="UserName" class="form-control" readonly style="background-color: #e9ecef; cursor: not-allowed;" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" type="email" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        @* Person Fields (FirstName, LastName) *@
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">First Name</label>
                                <input name="firstName" class="form-control" value="@(person?.FirstName ?? "")" disabled="@disabledAttr" />
                                <span class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Last Name</label>
                                <input name="lastName" class="form-control" value="@(person?.LastName ?? "")" disabled="@disabledAttr" />
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PrimaryContact" class="form-label">Primary Contact</label>
                                <input asp-for="PrimaryContact" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="PrimaryContact" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizationName" class="form-label">Organization Name</label>
                                <select asp-for="OrganizationName" class="form-select" asp-items="ViewBag.Organizations" disabled="@disabledAttr">
                                    <option value="">-- Select Organization --</option>
                                </select>
                                <span asp-validation-for="OrganizationName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        @* Address Fields *@
                        <h6 class="mt-4 mb-3">Address Information</h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Address Type</label>
                                <select name="addressTypeId" class="form-select" asp-items="ViewBag.AddressTypes" disabled="@disabledAttr">
                                    <option value="">-- Select Address Type --</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">State/Province</label>
                                <input list="stateProvinceList" name="stateProvinceName" id="stateProvinceInput" 
                                       class="form-control" 
                                       value="@(address?.StateProvince?.StateName ?? "")"
                                       placeholder="Type to search State/Province..." 
                                       disabled="@disabledAttr" />
                                <datalist id="stateProvinceList">
                                    @if (ViewBag.StateProvinces != null)
                                    {
                                        foreach (var item in (SelectList)ViewBag.StateProvinces)
                                        {
                                            <option value="@item.Text" data-id="@item.Value">@item.Text</option>
                                        }
                                    }
                                </datalist>
                                <input type="hidden" name="stateProvinceId" id="stateProvinceIdHidden" value="@(address?.StateProvinceId?.ToString() ?? "")" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address Line 1</label>
                            <input name="addressLine1" class="form-control" value="@(address?.AddressLine1 ?? "")" disabled="@disabledAttr" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">City</label>
                                <input name="city" class="form-control" value="@(address?.City ?? "")" disabled="@disabledAttr" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Postal Code</label>
                                <input name="postalCode" class="form-control" value="@(address?.PostalCode ?? "")" disabled="@disabledAttr" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label me-3 mb-0">Is Active</label>
                            <div class="form-check form-switch d-inline-block">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" id="isActiveSwitch" disabled="@disabledAttr" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">@(isDetailsView ? "Back" : "Cancel")</a>

                            @if (!isDetailsView)
                            {
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            }
                            else
                            {
                                @if (User.HasPermission("User.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                                }
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isDetailsView)
    {
        <partial name="_ValidationScriptsPartial" />
        
        <!-- Select2 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
        
        <!-- Select2 JS -->
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const stateProvinceInput = document.getElementById('stateProvinceInput');
                const stateProvinceIdHidden = document.getElementById('stateProvinceIdHidden');
                const stateProvinceList = document.getElementById('stateProvinceList');
                
                // Map StateName to StateProvinceId
                const stateProvinceMap = {};
                @if (ViewBag.StateProvinces != null)
                {
                    foreach (var item in (SelectList)ViewBag.StateProvinces)
                    {
                        <text>
                        stateProvinceMap['@item.Text'] = '@item.Value';
                        </text>
                    }
                }
                
                // When user selects from datalist or types and matches
                stateProvinceInput.addEventListener('input', function() {
                    const selectedName = this.value;
                    if (stateProvinceMap[selectedName]) {
                        stateProvinceIdHidden.value = stateProvinceMap[selectedName];
                    } else {
                        // If user types something that doesn't match, clear the hidden field
                        stateProvinceIdHidden.value = '';
                    }
                });
                
                // Handle datalist selection
                stateProvinceInput.addEventListener('change', function() {
                    const selectedName = this.value;
                    if (stateProvinceMap[selectedName]) {
                        stateProvinceIdHidden.value = stateProvinceMap[selectedName];
                    }
                });

                // Initialize Select2 for State/Province dropdown
                $('#stateProvinceSelect').select2({
                    theme: 'bootstrap-5',
                    placeholder: '-- Select State/Province --',
                    allowClear: true,
                    width: '100%'
                });

                // Handle disabled state
                @if (isDetailsView)
                {
                    <text>
                    $('#stateProvinceSelect').prop('disabled', true).trigger('change');
                    </text>
                }

                const organizationSelect = document.querySelector('select[name="OrganizationName"]');
                const firstNameInput = document.querySelector('input[name="firstName"]');
                const userNameInput = document.querySelector('input[name="UserName"]');
                
                const originalUsername = userNameInput ? userNameInput.value : '';
                
                function generateUsername(organizationName, firstName) {
                    if (!organizationName || !firstName) {
                        return originalUsername;
                    }
                    
                    const rawOrgName = organizationName.replace(/\s+/g, '');
                    const orgPrefixLength = 5;
                    const orgPrefix = rawOrgName.length >= orgPrefixLength 
                        ? rawOrgName.substring(0, orgPrefixLength).toUpperCase()
                        : rawOrgName.toUpperCase();
                    
                    const nameParts = firstName.trim().split(/\s+/);
                    let userInitials;
                    
                    if (nameParts.length >= 2) {
                        userInitials = (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase();
                    } else if (firstName.length >= 2) {
                        userInitials = firstName.substring(0, 2).toUpperCase();
                    } else {
                        userInitials = firstName.toUpperCase();
                    }
                    
                    const baseUsername = `${orgPrefix}-${userInitials}`;
                    
                    return baseUsername;
                }
                
                function updateUsername() {
                    if (!organizationSelect || !firstNameInput || !userNameInput) return;
                    
                    const orgName = organizationSelect.value;
                    const firstName = firstNameInput.value;
                    
                    if (orgName && firstName) {
                        const newUsername = generateUsername(orgName, firstName);
                        userNameInput.value = newUsername;
                    }
                }
                
                if (organizationSelect) {
                    organizationSelect.addEventListener('change', updateUsername);
                }
                
                if (firstNameInput) {
                    firstNameInput.addEventListener('input', updateUsername);
                    firstNameInput.addEventListener('change', updateUsername);
                }
            });
        </script>
    }
}
