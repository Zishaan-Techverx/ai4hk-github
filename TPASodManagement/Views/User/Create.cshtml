@model TpaSodManagement.ViewModels.User.UserEditViewModel

@{
    ViewData["Title"] = "Create User";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Create User</h5>
                </div>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" required />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="LastName" class="form-control" required />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmId" class="form-label">Farm <span class="text-danger">*</span></label>
                                <select asp-for="FarmId" class="form-select" asp-items="Model.Farms" required>
                                    <option value="">-- Select Farm --</option>
                                </select>
                                <span asp-validation-for="FarmId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                                <input asp-for="Password" type="password" class="form-control" required minlength="6" />
                                <small class="form-text text-muted">Minimum 6 characters required</small>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" required minlength="6" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PrimaryContact" class="form-label">Primary Contact</label>
                                <input asp-for="PrimaryContact" class="form-control" />
                                <span asp-validation-for="PrimaryContact" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">User Name</label>
                                <input asp-for="UserName" class="form-control" readonly style="background-color: #e9ecef; cursor: not-allowed;" />
                                <small class="form-text text-muted">Auto-generated based on Farm and First Name</small>
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                        </div>

                        @* Address Fields *@
                        <h6 class="mt-4 mb-3">Address Information (Optional)</h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Address Type</label>
                                <select asp-for="AddressTypeId" class="form-select" asp-items="Model.AddressTypes">
                                    <option value="">-- Select Address Type --</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">State/Province</label>
                                <input list="stateProvinceList" name="stateProvinceName" id="stateProvinceInput" 
                                       class="form-control" 
                                       value="@(Model.StateProvinceName ?? "")"
                                       placeholder="Type to search State/Province..." />
                                <datalist id="stateProvinceList">
                                    @if (Model.StateProvinces != null)
                                    {
                                        foreach (var item in Model.StateProvinces)
                                        {
                                            <option value="@item.Text" data-id="@item.Value">@item.Text</option>
                                        }
                                    }
                                </datalist>
                                <input type="hidden" asp-for="StateProvinceId" id="stateProvinceIdHidden" value="@(Model.StateProvinceId?.ToString() ?? "")" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address Line 1</label>
                            <input asp-for="AddressLine1" class="form-control" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Postal Code</label>
                                <input asp-for="PostalCode" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label me-3 mb-0">Is Active</label>
                            <div class="form-check form-switch d-inline-block">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" checked />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const stateProvinceInput = document.getElementById('stateProvinceInput');
            const stateProvinceIdHidden = document.getElementById('stateProvinceIdHidden');
            
            // Map StateName to StateProvinceId
            const stateProvinceMap = {};
            @if (Model.StateProvinces != null)
            {
                foreach (var item in (SelectList)Model.StateProvinces)
                {
                    <text>
                    stateProvinceMap['@item.Text'] = '@item.Value';
                    </text>
                }
            }
            
            // When user selects from datalist or types and matches
            if (stateProvinceInput) {
                stateProvinceInput.addEventListener('input', function() {
                    const selectedName = this.value;
                    if (stateProvinceMap[selectedName]) {
                        stateProvinceIdHidden.value = stateProvinceMap[selectedName];
                    } else {
                        stateProvinceIdHidden.value = '';
                    }
                });
                
                stateProvinceInput.addEventListener('change', function() {
                    const selectedName = this.value;
                    if (stateProvinceMap[selectedName]) {
                        stateProvinceIdHidden.value = stateProvinceMap[selectedName];
                    }
                });
            }

            // Auto-generate username based on Organization and First Name
            const farmSelect = document.querySelector('select[name="FarmId"]');
            const firstNameInput = document.querySelector('input[name="FirstName"]');
            const userNameInput = document.querySelector('input[name="UserName"]');
            
            function generateUsername(farmName, firstName) {
                if (!farmName || !firstName) {
                    return '';
                }
                
                const rawFarmName = farmName.replace(/\s+/g, '');
                const farmPrefixLength = 5;
                const farmPrefix = rawFarmName.length >= farmPrefixLength 
                    ? rawFarmName.substring(0, farmPrefixLength).toUpperCase()
                    : rawFarmName.toUpperCase();
                
                const nameParts = firstName.trim().split(/\s+/);
                let userInitials;
                
                if (nameParts.length >= 2) {
                    userInitials = (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase();
                } else if (firstName.length >= 2) {
                    userInitials = firstName.substring(0, 2).toUpperCase();
                } else {
                    userInitials = firstName.toUpperCase();
                }
                
                return `${farmPrefix}-${userInitials}`;
            }
            
            function updateUsername() {
                if (!farmSelect || !firstNameInput || !userNameInput) return;
                
                // Get farm name from selected option text
                const selectedOption = farmSelect.options[farmSelect.selectedIndex];
                const farmName = selectedOption ? selectedOption.text : '';
                const firstName = firstNameInput.value;
                
                if (farmName && firstName) {
                    const newUsername = generateUsername(farmName, firstName);
                    userNameInput.value = newUsername;
                }
            }
            
            if (farmSelect) {
                farmSelect.addEventListener('change', updateUsername);
            }
            
            if (firstNameInput) {
                firstNameInput.addEventListener('input', updateUsername);
                firstNameInput.addEventListener('change', updateUsername);
            }

            // Password confirmation validation
            const passwordInput = document.querySelector('input[name="Password"]');
            const confirmPasswordInput = document.querySelector('input[name="ConfirmPassword"]');
            
            if (passwordInput && confirmPasswordInput) {
                function validatePasswordMatch() {
                    if (confirmPasswordInput.value && passwordInput.value !== confirmPasswordInput.value) {
                        confirmPasswordInput.setCustomValidity('Passwords do not match');
                    } else {
                        confirmPasswordInput.setCustomValidity('');
                    }
                }
                
                passwordInput.addEventListener('input', validatePasswordMatch);
                confirmPasswordInput.addEventListener('input', validatePasswordMatch);
            }
        });
    </script>
}
