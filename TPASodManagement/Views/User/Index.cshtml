@model List<TpaSodManagement.Areas.Identity.Data.TpaSodManagementUser>
@using TpaSodManagement.Services.Interfaces
@using TpaSodManagement.Models.Db
@inject IAdminService AdminService
@inject IRegistrationService RegistrationService

@{
    ViewData["Title"] = "User Management";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>User Management</h1>
                @if (User.HasPermission("User.Create"))
                {
                    <a asp-action="Create" class="btn btn-primary">Create New</a>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error!</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">All Users</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>User Name</th>
                                    <th>Email</th>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Phone Number</th>
                                    <th>Address</th>
                                    <th>City</th>
                                    <th>State</th>
                                    <th>Postal Code</th>
                                    <th>Is Active</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    var person = await RegistrationService.GetUserPersonAsync(user.Id.ToString());
                                    var address = await RegistrationService.GetUserAddressAsync(user.Id.ToString());
                                    
                                    <tr>
                                        <td>@user.UserName</td>
                                        <td>@user.Email</td>
                                        <td>@(person?.FirstName ?? "N/A")</td>
                                        <td>@(person?.LastName ?? "N/A")</td>
                                        <td>@user.PhoneNumber</td>
                                        <td>@(address?.AddressLine1 ?? "N/A")</td>
                                        <td>@(address?.City ?? "N/A")</td>
                                        <td>@(address?.StateProvince?.StateName ?? "N/A")</td>
                                        <td>@(address?.PostalCode ?? "N/A")</td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">

                                                <!-- DETAILS BUTTON -->
                                                @if (User.HasPermission("User.Detail"))
                                                {
                                                    <a class="btn btn-info"
                                                       asp-action="Details"
                                                       asp-route-id="@user.Id">
                                                        Details
                                                    </a>
                                                }

                                                <!-- EDIT BUTTON -->
                                                @if (User.HasPermission("User.Edit"))
                                                {
                                                    <a class="btn btn-warning"
                                                       asp-action="Edit"
                                                       asp-route-id="@user.Id">
                                                        Edit
                                                    </a>
                                                }

                                                <!-- DELETE BUTTON -->
                                                @if (User.HasPermission("User.Delete"))
                                                {
                                                    <a href="#" class="btn btn-danger delete-user-btn"
                                                       data-user-id="@user.Id"
                                                       data-user-name="@user.UserName"
                                                       data-user-email="@user.Email"
                                                       data-bs-toggle="modal"
                                                       data-bs-target="#deleteUserModal"
                                                       title="Delete User">
                                                        Delete
                                                    </a>
                                                }

                                            </div>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteUserModalLabel">Confirm User Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Are you sure you want to delete the user:
                    <strong id="userNamePlaceholder"></strong> (<span id="userEmailPlaceholder"></span>)?
                </p>

                <div class="alert alert-warning" role="alert">
                    <strong>Warning!</strong> Deleting this user will permanently remove all associated data. This
                    action cannot be undone.
                </div>

                <div class="alert alert-danger d-none" role="alert" id="deleteUserError">
                    Error deleting the user. Please try again.
                </div>

                <input type="hidden" id="userIdToDelete" />

                @Html.AntiForgeryToken()
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmUserDeleteBtn">Delete User</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                const alerts = document.querySelectorAll('.alert-success, .alert-danger');
                alerts.forEach(alert => {
                    if (typeof bootstrap !== 'undefined' && bootstrap.Alert) {
                        const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                        bsAlert.close();
                    }
                });
            }, 5000);

            // Modal and delete button elements
            const deleteUserModalEl = document.getElementById('deleteUserModal');
            const userIdInput = document.getElementById('userIdToDelete');
            const userNamePlaceholder = document.getElementById('userNamePlaceholder');
            const userEmailPlaceholder = document.getElementById('userEmailPlaceholder');
            const confirmDeleteBtn = document.getElementById('confirmUserDeleteBtn');
            const deleteErrorAlert = document.getElementById('deleteUserError');

            // Anti-Forgery Token
            const antiForgeryTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const antiForgeryToken = antiForgeryTokenInput ? antiForgeryTokenInput.value : '';

            // Handle all delete user buttons
            document.querySelectorAll('.delete-user-btn').forEach(function (deleteBtn) {
                deleteBtn.addEventListener('click', function (e) {
                    e.preventDefault();

                    // Get user data from button attributes
                    const userId = this.getAttribute('data-user-id');
                    const userName = this.getAttribute('data-user-name');
                    const userEmail = this.getAttribute('data-user-email');

                    // Set user info in modal
                    if (userIdInput) {
                        userIdInput.value = userId || '';
                    }
                    if (userNamePlaceholder) {
                        userNamePlaceholder.textContent = userName || 'Unknown User';
                    }
                    if (userEmailPlaceholder) {
                        userEmailPlaceholder.textContent = userEmail || '';
                    }

                    // Reset modal state
                    if (deleteErrorAlert) {
                        deleteErrorAlert.classList.add('d-none');
                    }
                    if (confirmDeleteBtn) {
                        confirmDeleteBtn.disabled = false;
                        confirmDeleteBtn.innerHTML = 'Delete User';
                    }
                });
            });

            // Delete confirmation button click
            if (confirmDeleteBtn) {
                confirmDeleteBtn.addEventListener('click', function () {
                    const userId = userIdInput.value;

                    if (!userId || !antiForgeryToken) {
                        if (deleteErrorAlert) {
                            deleteErrorAlert.innerText = 'Error: User ID or Anti-Forgery Token is missing.';
                            deleteErrorAlert.classList.remove('d-none');
                        }
                        console.error('Missing userId or antiForgeryToken');
                        return;
                    }

                    console.log('Deleting user:', userId);

                    // Show loading state
                    confirmDeleteBtn.disabled = true;
                    confirmDeleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Deleting...';
                    if (deleteErrorAlert) {
                        deleteErrorAlert.classList.add('d-none');
                    }

                    // Prepare request body
                    const requestBody = 'id=' + encodeURIComponent(userId) +
                        '&__RequestVerificationToken=' + encodeURIComponent(antiForgeryToken);

                    console.log('Sending request to:', '@Url.Action("DeleteUser", "User")');

                    // Send AJAX POST request
                    fetch('@Url.Action("DeleteUser", "User")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: requestBody
                    })
                        .then(response => {
                            console.log('Response status:', response.status);
                            console.log('Response ok:', response.ok);
                            
                            if (response.ok) {
                                return response.json().catch(() => response.text());
                            } else {
                                // Try to get error message
                                return response.json()
                                    .then(err => { throw new Error(err.message || 'Server returned an error.'); })
                                    .catch(() => response.text().then(text => { throw new Error(text || 'Server returned an error.'); }));
                            }
                        })
                        .then(data => {
                            console.log('Delete successful:', data);
                            // Deletion successful, refresh the page
                            window.location.reload();
                        })
                        .catch(error => {
                            console.error('User Deletion failed:', error);

                            // Show error in modal
                            if (deleteErrorAlert) {
                                deleteErrorAlert.innerText = 'Deletion failed: ' + (error.message || 'Unknown error.');
                                deleteErrorAlert.classList.remove('d-none');
                            }

                            // Restore button state
                            confirmDeleteBtn.disabled = false;
                            confirmDeleteBtn.innerHTML = 'Delete User';
                        });
                });
            }
        });
    </script>
}