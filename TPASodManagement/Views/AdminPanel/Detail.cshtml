@model TpaSodManagement.ViewModels.Admin.RoleDetailsViewModel
@using TpaSodManagement.Areas.Identity.Data

@{
    ViewData["Title"] = "Role Details";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                </a>

                <h1 class="ms-4 mb-0">Role Details</h1>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Role Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Role Name:</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Role ID:</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Normalized Name:</dt>
                        <dd class="col-sm-9">@Model.NormalizedName</dd>
                    </dl>

                    @if (Model.UsersWithRoles != null && Model.UsersWithRoles.Any())
                    {
                        <div class="mt-4">
                            <h5>Users in this Role</h5>
                            <ul class="list-group">
                                @foreach (var user in Model.UsersWithRoles)
                                {
                                    <li class="list-group-item">
                                        <div class="fw-semibold">@user.UserName (@user.Email)</div>
                                        @if (user.Roles.Any())
                                        {
                                            <div class="small text-muted">Roles: @string.Join(", ", user.Roles)</div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-3">
                            No users are currently assigned to this role.
                        </div>
                    }

                    <div class="mb-3">
                        <a href="@Url.Action("Index")" class="btn btn-danger">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>