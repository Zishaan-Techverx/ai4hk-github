@model Microsoft.AspNetCore.Identity.IdentityRole
@using TpaSodManagement.Areas.Identity.Data

@{
    ViewData["Title"] = "Role Details";
    var usersInRole = ViewBag.UsersInRole as List<TpaSodManagementUser>;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                </a>

                <h1 class="ms-4 mb-0">Role Details</h1>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Role Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Role Name:</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Role ID:</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Normalized Name:</dt>
                        <dd class="col-sm-9">@Model.NormalizedName</dd>
                    </dl>

                    <div class="mb-3">
                        <a href="@Url.Action("Index")" class="btn btn-danger">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>