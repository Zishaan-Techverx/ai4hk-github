@model TpaSodManagement.ViewModels.Admin.AdminIndexViewModel
@{
    ViewData["Title"] = "Roles Management";
    var roles = Model.Roles;
    var users = Model.Users;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Roles Management</h1>

                @if (User.HasPermission("Admin.Create"))
                {
                    <a href="@Url.Action("CreateRole")" class="btn btn-primary" permission="Admin.Create">
                        Create New
                    </a>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error!</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Existing Roles</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Role Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var role in roles)
                                {
                                    // Skip SuperAdmin role from listing
                                    @if (role.Name.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        continue;
                                    }
                                    
                                    <tr>
                                        <td>@role.Name</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                @if (User.HasPermission("Admin.View"))
                                                {
                                                    <a class="btn btn-info"
                                                       href="@Url.Action("RoleDetails", new { id = role.Id })"
                                                       permission="Admin.View">
                                                        Details
                                                    </a>
                                                }
                                                @if (User.HasPermission("Admin.Edit"))
                                                {
                                                    <a class="btn btn-warning"
                                                       href="@Url.Action("EditRole", new { id = role.Id })"
                                                       permission="Admin.Edit">
                                                        Edit
                                                    </a>
                                                }
                                                @if (User.HasPermission("Admin.Delete"))
                                                {
                                                    <a href="#"
                                                       class="btn btn-danger delete-btn"
                                                       data-id="@role.Id"
                                                       data-name="@role.Name"
                                                       data-bs-toggle="modal"
                                                       data-bs-target="#deleteRoleModal"
                                                       title="Delete">
                                                        Delete
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (User.HasPermission("Admin.Edit"))
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Assign Roles to Users (Single Role Assignment)</h5>
                    </div>
                    <div class="card-body">

                        <form id="assignRoleForm" asp-action="AssignRoleToUser" method="post" class="row g-3 align-items-end mb-4">
                            @Html.AntiForgeryToken()
                            <div class="col-md-4">
                                <label class="form-label">Select User</label>
                                <select name="userId" class="form-select" required>
                                    <option value="">-- Select User --</option>
                                    @foreach (var user in users)
                                    {
                                        <option value="@user.Id">@user.UserName (@user.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Select Role</label>
                                <select name="roleName" class="form-select" required>
                                    <option value="">-- Select Role --</option>
                                    @foreach (var role in roles)
                                    {
                                        // Skip SuperAdmin role from dropdown
                                        @if (!role.Name.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@role.Name">@role.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary">Assign Role</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">User Roles Overview</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>User Name</th>
                                    <th>Email</th>
                                    <th>Current Roles & Actions</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td>@user.UserName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            @if (user.Roles.Any())
                                            {
                                                <div class="d-flex flex-column">
                                                    @foreach (var role in user.Roles)
                                                    {
                                                        <div class="d-flex align-items-center mb-1">
                                                            <span class="badge bg-success me-2">@role</span>

                                                            @if (User.HasPermission("Admin.Edit"))
                                                            {
                                                                <form asp-action="RemoveRoleFromUser" method="post" class="d-inline" style="margin:0;">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                                    <input type="hidden" name="roleName" value="@role" />
                                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0"
                                                                            title="Remove @role role from @user.UserName">
                                                                        <i class="fas fa-times"></i> Remove
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">No roles assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.Roles.Any())
                                            {
                                                <span class="text-success">
                                                    <i class="fas fa-check-circle"></i> Has roles
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    <i class="fas fa-info-circle"></i> Assign role using form above
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<br />
<br />

<div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-labelledby="deleteRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Are you sure you want to delete the role:
                    <strong id="roleNamePlaceholder"></strong>?
                </p>

                <div class="alert alert-danger d-none" role="alert" id="deleteError">
                    Error deleting the record. Please try again.
                </div>

                <input type="hidden" id="roleIdToDelete" />

                @Html.AntiForgeryToken()
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        console.log("DELETE SCRIPT LOADED");

        document.getElementById("assignRoleForm")?.addEventListener("submit", function (e) {
            const userId = this.querySelector('select[name="userId"]').value;
            const roleName = this.querySelector('select[name="roleName"]').value;

            if (!userId || !roleName) {
                e.preventDefault();
                console.error("Please select both user and role before submitting.");
            }
        });

        const roleIdInput = document.getElementById("roleIdToDelete");
        const roleNamePlaceholder = document.getElementById("roleNamePlaceholder");
        const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        document.querySelectorAll(".delete-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                roleIdInput.value = this.dataset.id;
                roleNamePlaceholder.textContent = this.dataset.name;
            });
        });

        confirmDeleteBtn.addEventListener("click", function () {

            const body = "__RequestVerificationToken=" + encodeURIComponent(antiForgeryToken)
                       + "&id=" + encodeURIComponent(roleIdInput.value);

            fetch('@Url.Action("DeleteRole", "Admin")', {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: body
            })
            .then(res => {
                if (!res.ok) throw new Error("Failed to delete role");
                return res.text();
            })
            .then(() => location.reload())
            .catch(err => {
                document.getElementById("deleteError").classList.remove("d-none");
                document.getElementById("deleteError").textContent = err.message;
            });
        });
    </script>

}

