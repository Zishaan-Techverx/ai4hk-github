@{
    ViewData["Title"] = "Home";
}


<br />

@if (!User.Identity.IsAuthenticated)
{
    <!-- Show login/register for unauthenticated users -->
    <style>
        .auth-page {
            min-height: 100vh;
        }
        .auth-card {
            background-color: #f8f9fa;
            border: none;
            box-shadow: none;
        }
        .auth-title {
            color: #2B2B2B !important;
            text-shadow: none;
        }
        .auth-btn-primary {
            background-color: #2B2B2B;
            border-color: #2B2B2B;
            color: #F6F4EE;
        }
        .auth-btn-primary:hover {
            background-color: #1a1a1a;
            border-color: #1a1a1a;
            color: #F6F4EE;
        }
        .auth-btn-outline {
            border-color: #2B2B2B;
            color: #2B2B2B;
            background-color: transparent;
        }
        .auth-btn-outline:hover {
            background-color: #2B2B2B;
            border-color: #2B2B2B;
            color: #F6F4EE;
        }
    </style>
    <div class="container-fluid auth-page min-vh-100 d-flex align-items-center justify-content-center">
        <div class="row w-100 justify-content-center">
            <div class="col-lg-8 col-xl-6">
                <div class="text-center mb-5">
                    <h1 class="display-4 auth-title">Sod Management System</h1>
                </div>
                <partial name="_AuthPartial" />
            </div>
        </div>
    </div>
}
else
{
    <!-- Show dashboard for authenticated users -->
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>Dashboard</h1>
                    <div class="d-flex align-items-center">
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <label for="adminPageSizeSelect" class="form-label me-2 mb-0">Page Size:</label>
                            <select id="adminPageSizeSelect" class="form-select form-select-sm d-inline-block" style="width: auto;" onchange="changeAdminPageSize(this.value)">
                                @{
                                    var adminPageSize = ViewBag.PageSize as int? ?? 10;
                                }
                                <option value="10" selected="@(adminPageSize == 10)">10</option>
                                <option value="15" selected="@(adminPageSize == 15)">15</option>
                                <option value="20" selected="@(adminPageSize == 20)">20</option>
                                <option value="25" selected="@(adminPageSize == 25)">25</option>
                                <option value="50" selected="@(adminPageSize == 50)">50</option>
                                <option value="100" selected="@(adminPageSize == 100)">100</option>
                            </select>
                        }
                        else
                        {
                            <label for="userPageSizeSelect" class="form-label me-2 mb-0">Page Size:</label>
                            <select id="userPageSizeSelect" class="form-select form-select-sm d-inline-block" style="width: auto;" onchange="changeUserPageSize(this.value)">
                                @{
                                    var userPageSize = ViewBag.PageSize as int? ?? 10;
                                }
                                <option value="10" selected="@(userPageSize == 10)">10</option>
                                <option value="15" selected="@(userPageSize == 15)">15</option>
                                <option value="20" selected="@(userPageSize == 20)">20</option>
                                <option value="25" selected="@(userPageSize == 25)">25</option>
                                <option value="50" selected="@(userPageSize == 50)">50</option>
                                <option value="100" selected="@(userPageSize == 100)">100</option>
                            </select>
                        }
                    </div>
                </div>

