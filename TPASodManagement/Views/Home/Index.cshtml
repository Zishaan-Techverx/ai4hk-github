                <!-- Notifications Section - For Regular Users -->
                @if (!User.IsInRole("SuperAdmin"))
                {
                    @Html.AntiForgeryToken()
                    var userNotificationUsers = ViewBag.UserNotificationUsers as List<TpaSodManagement.Database.Entities.NotificationUser>;
                    var unreadCount = ViewBag.UnreadNotificationCount as int? ?? 0;
                    
                    if (userNotificationUsers != null && userNotificationUsers.Any())
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="card-title mb-0">
                                            <i class="bi bi-bell-fill me-2"></i>Notifications
                                            @if (unreadCount > 0)
                                            {
                                                <span class="badge bg-danger ms-2">@unreadCount New</span>
                                            }
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="list-group">
                                            @foreach (var notificationUser in userNotificationUsers)
                                            {
                                                var notification = notificationUser.Notification;
                                                var isRead = notificationUser.IsRead;
                                                var readDate = notificationUser.ReadDate;
                                                
                                                <div class="list-group-item @(isRead ? "" : "list-group-item-primary") notification-item" 
                                                     data-notification-id="@notification.NotificationId" 
                                                     style="@(isRead ? "" : "border-left: 4px solid #0d6efd;")">
                                                    <div class="d-flex w-100 justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-1">
                                                                @if (!isRead)
                                                                {
                                                                    <span class="badge bg-primary me-2">New</span>
                                                                }
                                                                @notification.Title
                                                                <span class="badge bg-@(notification.Priority == "Critical" ? "danger" : notification.Priority == "High" ? "warning" : notification.Priority == "Medium" ? "info" : "secondary") ms-2">
                                                                    @notification.Priority
                                                                </span>
                                                            </h6>
                                                            <p class="mb-1">@(notification.Message.Length > 100 ? notification.Message.Substring(0, 100) + "..." : notification.Message)</p>
                                                            <small class="text-muted">
                                                                <i class="bi bi-clock"></i> @notification.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                                                                @if (isRead && readDate.HasValue)
                                                                {
                                                                    <span class="ms-2">| Read: @readDate.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                                                }
                                                            </small>
                                                        </div>
                                                        <div class="ms-3">
                                                            <button class="btn btn-sm btn-info view-notification-btn" 
                                                                    data-notification-id="@notification.NotificationId"
                                                                    data-title="@notification.Title"
                                                                    data-message="@notification.Message"
                                                                    data-priority="@notification.Priority"
                                                                    data-created-date="@notification.CreatedDate.ToString("yyyy-MM-dd HH:mm")"
                                                                    data-expiry-date="@(notification.ExpiryDate?.ToString("yyyy-MM-dd HH:mm") ?? "Not Set")"
                                                                    data-is-read="@isRead.ToString().ToLower()">
                                                                <i class="bi bi-eye"></i> View
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Notification Details Modal -->
                    <div class="modal fade" id="notificationDetailsModal" tabindex="-1" aria-labelledby="notificationDetailsModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg" style="max-width: 50%;">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="notificationDetailsModalLabel">Notification Details</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-12 mb-3">
                                            <label class="form-label fw-bold">Title</label>
                                            <p id="notificationModalTitle" class="form-control-plaintext"></p>
                                        </div>
                                        <div class="col-12 mb-3">
                                            <label class="form-label fw-bold">Priority</label>
                                            <p id="notificationModalPriority" class="form-control-plaintext"></p>
                                        </div>
                                        <div class="col-12 mb-3">
                                            <label class="form-label fw-bold">Message</label>
                                            <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto; background-color: #f8f9fa;">
                                                <p id="notificationModalMessage" class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; word-break: break-word;"></p>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Created Date</label>
                                            <p id="notificationModalCreatedDate" class="form-control-plaintext"></p>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Expiry Date</label>
                                            <p id="notificationModalExpiryDate" class="form-control-plaintext"></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary" id="replyNotificationBtn">Reply</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reply Notification Modal -->
                    <div class="modal fade" id="replyNotificationModal" tabindex="-1" aria-labelledby="replyNotificationModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="replyNotificationModalLabel">Reply to Notification</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label for="notificationReply" class="form-label">Reply <span class="text-danger">*</span></label>
                                        <textarea class="form-control" id="notificationReply" rows="4" required maxlength="2000" placeholder="Enter your reply..."></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" class="btn btn-primary" id="sendReplyBtn">Send</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }


                <!-- Notifications Section - Only for SuperAdmin -->
                @if (User.IsInRole("SuperAdmin"))
                {
                    var notifications = ViewBag.Notifications as List<TpaSodManagement.Database.Entities.Notification>;
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="card-title mb-0">Notifications Management</h5>
                                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#sendNotificationModal">
                                        <i class="bi bi-plus-circle"></i> Send Notification
                                    </button>
                                </div>
                                <div class="card-body">
                                    @if (TempData["ErrorMessage"] != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <strong>Error!</strong> @TempData["ErrorMessage"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    }

                                    @if (TempData["SuccessMessage"] != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            <strong>Success!</strong> @TempData["SuccessMessage"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    }

                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="notificationsTable">
                                            <thead>
                                                <tr>
                                                    <th>Title</th>
                                                    <th>Message</th>
                                                    <th>Priority</th>
                                                    <th>Recipients</th>
                                                    <th>Created Date</th>
                                                    <th>Expiry Date</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (notifications != null && notifications.Any())
                                                {
                                                    @foreach (var notification in notifications)
                                                    {
                                                        <tr>
                                                            <td>@notification.Title</td>
                                                            <td>@(notification.Message.Length > 50 ? notification.Message.Substring(0, 50) + "..." : notification.Message)</td>
                                                            <td>
                                                                <span class="badge bg-@(notification.Priority == "Critical" ? "danger" : notification.Priority == "High" ? "warning" : notification.Priority == "Medium" ? "info" : "secondary")">
                                                                    @notification.Priority
                                                                </span>
                                                            </td>
                                                            <td>@notification.NotificationUsers.Count</td>
                                                            <td>@notification.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                            <td>@(notification.ExpiryDate?.ToString("yyyy-MM-dd HH:mm") ?? "Not Set")</td>
                                                            <td>
                                                                <div class="btn-group btn-group-sm">
                                                                    <a class="btn btn-info" asp-controller="Notification" asp-action="Details" asp-route-id="@notification.NotificationId">
                                                                        View
                                                                    </a>
                                                                    <button class="btn btn-warning edit-notification" data-id="@notification.NotificationId" data-title="@notification.Title" data-message="@notification.Message" data-priority="@notification.Priority">
                                                                        <i class="bi bi-pencil"></i> Edit
                                                                    </button>
                                                                    <button class="btn btn-danger delete-notification" data-id="@notification.NotificationId">
                                                                        <i class="bi bi-trash"></i> Delete
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="7" class="text-center">No notifications found.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Send Notification Modal -->
                    <div class="modal fade" id="sendNotificationModal" tabindex="-1" aria-labelledby="sendNotificationModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="sendNotificationModalLabel">Send Notification</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form id="sendNotificationForm">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label for="notificationTitle" class="form-label">Title <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="notificationTitle" required maxlength="500">
                                        </div>
                                        <div class="mb-3">
                                            <label for="notificationMessage" class="form-label">Message <span class="text-danger">*</span></label>
                                            <textarea class="form-control" id="notificationMessage" rows="4" required></textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label for="notificationPriority" class="form-label">Priority <span class="text-danger">*</span></label>
                                            <select class="form-select" id="notificationPriority" required>
                                                <option value="">Select Priority</option>
                                                <option value="Critical">Critical</option>
                                                <option value="High">High</option>
                                                <option value="Medium">Medium</option>
                                                <option value="Low">Low</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label for="notificationExpiryDate" class="form-label">Expiry Date (Optional)</label>
                                            <input type="datetime-local" class="form-control" id="notificationExpiryDate">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Organization</label>
                                            <div class="dropdown">
                                                <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="organizationDropdownBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                                    <span id="organizationDropdownText">Select Organizations</span>
                                                </button>
                                                <ul class="dropdown-menu w-100" id="organizationDropdownMenu" aria-labelledby="organizationDropdownBtn" style="max-height: 300px; overflow-y: auto;">
                                                    <li>
                                                        <div class="dropdown-item" id="selectAllOrgs" style="display: flex; align-items: center;">
                                                            <input type="checkbox" id="selectAllOrgsCheckbox" class="form-check-input me-2" style="cursor: pointer;">
                                                            <label class="form-check-label" for="selectAllOrgsCheckbox" style="cursor: pointer; width: 100%; margin: 0;">Select All</label>
                                                        </div>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <div id="organizationOptions"></div>
                                                </ul>
                                            </div>
                                            <div id="selectedOrganizationsBadges" class="mt-2 d-flex flex-wrap gap-1"></div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Users <span class="text-danger">*</span></label>
                                            <div class="dropdown">
                                                <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="userDropdownBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                                    <span id="userDropdownText">Select Users</span>
                                                </button>
                                                <ul class="dropdown-menu w-100" id="userDropdownMenu" aria-labelledby="userDropdownBtn" style="max-height: 300px; overflow-y: auto;">
                                                    <li>
                                                        <div class="dropdown-item" id="selectAllUsers" style="display: flex; align-items: center;">
                                                            <input type="checkbox" id="selectAllUsersCheckbox" class="form-check-input me-2" style="cursor: pointer;">
                                                            <label class="form-check-label" for="selectAllUsersCheckbox" style="cursor: pointer; width: 100%; margin: 0;">Select All</label>
                                                        </div>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <div id="userOptions"></div>
                                                </ul>
                                            </div>
                                            <div id="selectedUsersBadges" class="mt-2 d-flex flex-wrap gap-1"></div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Send Notification</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
