                            const column = input.getAttribute('data-column');
                            const value = input.value;
                            if (value) {
                                userActiveFilters[`${column}_To`] = value;
                            }
                        });

                        // If no filters are active, clear everything and reload
                        if (Object.keys(userActiveFilters).length === 0) {
                            updateUserFilterTags();
                            updateUserFilterCount();
                            localStorage.setItem(userDataFiltersStorageKey, JSON.stringify({}));
                            const modal = bootstrap.Modal.getInstance(document.getElementById('filterModal'));
                            if (modal) modal.hide();
                            window.location.reload();
                            return;
                        }

                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const response = await fetch('@Url.Action("FilterNotifications", "Home")', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify(userActiveFilters)
                        });
                        
                        if (!response.ok) {
                            const errorText = await response.text();
                            console.error('Response error:', response.status, errorText);
                            alert('Error: Server returned status ' + response.status);
                            return;
                        }
                        
                        const result = await response.json();
                        if (result.success) {
                            userFilteredData = result.data || [];
                            userIsFiltered = Object.keys(userActiveFilters).length > 0;
                            userCurrentPage = 1;
                            localStorage.setItem(userDataFiltersStorageKey, JSON.stringify(userActiveFilters));
                            updateUserTable(userFilteredData, result.repliedIds || []);
                            updateUserFilterTags();
                            updateUserFilterCount();
                            const modal = bootstrap.Modal.getInstance(document.getElementById('filterModal'));
                            if (modal) modal.hide();
                        } else {
                            alert('Error: ' + (result.message || 'Unknown error'));
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('Error applying filters: ' + error.message);
                    }
                }

                function updateUserTable(data, repliedIds) {
                    let listGroup = document.querySelector('.user-notification-item')?.closest('.list-group');
                    if (!listGroup) {
                        const cardBody = document.querySelector('.card-body');
                        if (cardBody) {
                            const newListGroup = document.createElement('div');
                            newListGroup.className = 'list-group';
                            cardBody.insertBefore(newListGroup, cardBody.firstChild);
                            listGroup = newListGroup;
                        } else {
                            return;
                        }
                    }
                    
                    const repliedList = repliedIds || [];
                    
                    listGroup.innerHTML = '';
                    if (data.length === 0) {
                        listGroup.innerHTML = '<div class="list-group-item text-center">No notifications found.</div>';
                        return;
                    }
                    
                    data.forEach(item => {
                        const notificationId = typeof item.notificationId === 'number' ? item.notificationId : parseInt(item.notificationId);
                        const hasReplied = repliedList.includes(notificationId);
                        
                        const priorityClass = item.priority === 'Critical' ? 'danger' : 
                                           item.priority === 'High' ? 'warning' : 
                                           item.priority === 'Medium' ? 'info' : 'secondary';
                        
                        const readBadge = item.isRead ? '<span class="badge bg-success ms-2">Read</span>' : '<span class="badge bg-danger ms-2">Unread</span>';
                        const itemHtml = `
                            <div class="list-group-item user-notification-item" data-notification-id="${notificationId}">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">
                                            ${escapeHtml(item.title || '')}
                                            <span class="badge bg-${priorityClass} ms-2">${escapeHtml(item.priority || '')}</span>
                                            ${readBadge}
                                        </h6>
                                        <p class="mb-1">${escapeHtml(item.message || '')}</p>
                                        <small class="text-muted">
                                            ${item.createdDate} | Expiry: ${escapeHtml(item.expiryDate || 'Not Set')}
                                            ${item.readDate ? ' | Read: ' + item.readDate : ''}
                                        </small>
                                    </div>
                                    <div class="ms-3">
                                        <a href="/Notification/Details/${notificationId}" class="btn btn-sm btn-primary">View</a>
                                        ${hasReplied ? '<span class="badge bg-success ms-2">Replied</span>' : ''}
                                    </div>
                                </div>
                            </div>
                        `;
                        listGroup.insertAdjacentHTML('beforeend', itemHtml);
                    });
                }

                function escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }

                function updateUserFilterTags() {
                    const container = document.getElementById('activeFilterTags');
                    if (!container) return;
                    
                    container.innerHTML = '';
                    if (Object.keys(userActiveFilters).length === 0) {
                        return;
                    }
                    
                    Object.keys(userActiveFilters).forEach(key => {
                        const value = userActiveFilters[key];
                        let displayKey = key;
                        let displayValue = value;
                        
                        // Format display key and value
                        if (key === 'Search') {
                            displayKey = 'Search';
                        } else if (key.endsWith('_From')) {
                            displayKey = key.replace('_From', '') + ' (From)';
                        } else if (key.endsWith('_To')) {
                            displayKey = key.replace('_To', '') + ' (To)';
                        }
                        
                        const tag = document.createElement('span');
                        tag.className = 'badge bg-primary me-1 mb-1';
                        tag.style.cursor = 'pointer';
                        tag.innerHTML = `${displayKey}: ${escapeHtml(displayValue)} <i class="fa-solid fa-times ms-1"></i>`;
                        tag.addEventListener('click', function(e) {
                            e.stopPropagation();
                            delete userActiveFilters[key];
                            localStorage.setItem(userDataFiltersStorageKey, JSON.stringify(userActiveFilters));
                            
                            // Clear corresponding input fields
                            if (key === 'Search') {
                                const filterInput = document.querySelector('.filter-input[data-column="Search"]');
                                if (filterInput) filterInput.value = '';
                                const clearBtn = document.querySelector('.clear-column-filter[data-column="Search"]');
                                if (clearBtn) clearBtn.style.display = 'none';
                            } else if (key.endsWith('_From')) {
                                const baseColumn = key.replace('_From', '');
                                const dateFromInput = document.querySelector(`.filter-date-from[data-column="${baseColumn}"]`);
                                if (dateFromInput) dateFromInput.value = '';
                                const clearBtn = document.querySelector(`.clear-date-from-filter[data-column="${baseColumn}"]`);
                                if (clearBtn) clearBtn.style.display = 'none';
                            } else if (key.endsWith('_To')) {
                                const baseColumn = key.replace('_To', '');
                                const dateToInput = document.querySelector(`.filter-date-to[data-column="${baseColumn}"]`);
                                if (dateToInput) dateToInput.value = '';
                                const clearBtn = document.querySelector(`.clear-date-to-filter[data-column="${baseColumn}"]`);
                                if (clearBtn) clearBtn.style.display = 'none';
                            }
                            
                            updateUserFilterTags();
                            updateUserFilterCount();
                            
                            // If no filters left, reload page
                            if (Object.keys(userActiveFilters).length === 0) {
                                window.location.reload();
                            } else {
                                window.applyUserFilters();
                            }
                        });
                        container.appendChild(tag);
                    });
                }

                function updateUserFilterCount() {
                    const count = Object.keys(userActiveFilters).length;
                    const countBadge = document.getElementById('activeFilterCount');
                    const clearAllBtn = document.getElementById('clearAllFiltersBtn');
                    
                    if (count > 0) {
                        if (countBadge) {
                            countBadge.textContent = count;
                            countBadge.style.display = 'inline-block';
                        }
                        if (clearAllBtn) {
                            clearAllBtn.style.display = 'inline-block';
                        }
                    } else {
                        if (countBadge) {
                            countBadge.style.display = 'none';
                        }
                        if (clearAllBtn) {
                            clearAllBtn.style.display = 'none';
                        }
                    }
                }
            })();
        </script>
    }
}