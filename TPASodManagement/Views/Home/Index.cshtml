                <!-- Notifications Section - For Regular Users -->
                @if (!User.IsInRole("SuperAdmin"))
                {
                    @Html.AntiForgeryToken()
                    var userNotificationUsers = ViewBag.UserNotificationUsers as List<TpaSodManagement.Database.Entities.NotificationUser>;
                    var unreadCount = ViewBag.UnreadNotificationCount as int? ?? 0;
                    
                    // Set filter columns for regular users
                    ViewBag.FilterColumns = new Dictionary<string, string>
                    {
                        { "Search", "Search (Title/Message)" },
                        { "CreatedDate", "Created Date" },
                        { "ExpiryDate", "Expiry Date" }
                    };
                    ViewBag.ModuleName = "Notifications";
                    ViewBag.DateColumns = new HashSet<string> { "CreatedDate", "ExpiryDate" };
                    
                    if (userNotificationUsers != null && userNotificationUsers.Any())
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <!-- Filter Controls -->
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <div class="d-flex align-items-center gap-2">
                                            @await Html.PartialAsync("_FilterPartial", new Dictionary<string, string>())
                                        </div>
                                        <div id="activeFilterTags" class="mt-2 d-flex flex-wrap gap-1"></div>
                                    </div>
                                </div>
                                
                                <div class="card">
                                    <div class="card-header">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="card-title mb-0">
                                                <i class="bi bi-bell-fill me-2"></i>Notifications
                                                @if (unreadCount > 0)
                                                {
                                                    <span class="badge bg-danger ms-2">@unreadCount New</span>
                                                }
                                            </h5>
                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="location.reload();" title="Refresh notifications">
                                                <i class="bi bi-arrow-clockwise"></i> Refresh
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="list-group">
                                            @foreach (var notificationUser in userNotificationUsers)
                                            {
                                                var notification = notificationUser.Notification;
                                                var isRead = notificationUser.IsRead;
                                                var readDate = notificationUser.ReadDate;
                                                
                                                <div class="list-group-item @(isRead ? "" : "list-group-item-primary") notification-item" 
                                                     data-notification-id="@notification.NotificationId" 
                                                     style="@(isRead ? "" : "border-left: 4px solid #0d6efd;")">
                                                    <div class="d-flex w-100 justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-1">
                                                                @if (!isRead)
                                                                {
                                                                    <span class="badge bg-primary me-2">New</span>
                                                                }
                                                                @notification.Title
                                                                <span class="badge bg-@(notification.Priority == "Critical" ? "danger" : notification.Priority == "High" ? "warning" : notification.Priority == "Medium" ? "info" : "secondary") ms-2">
                                                                    @notification.Priority
                                                                </span>
                                                            </h6>
                                                            <p class="mb-1">@(notification.Message.Length > 100 ? notification.Message.Substring(0, 100) + "..." : notification.Message)</p>
                                                            <small class="text-muted">
                                                                <i class="bi bi-clock"></i> @notification.CreatedDate.ToString("MM/dd/yyyy h:mm tt")
                                                                @if (isRead && readDate.HasValue)
                                                                {
                                                                    <span class="ms-2">| Read: @readDate.Value.ToString("MM/dd/yyyy h:mm tt")</span>
                                                                }
                                                            </small>
                                                        </div>
                                                        <div class="ms-3">
                                                            <button class="btn btn-sm btn-info view-notification-btn" 
                                                                    data-notification-id="@notification.NotificationId"
                                                                    data-title="@notification.Title"
                                                                    data-message="@notification.Message"
                                                                    data-priority="@notification.Priority"
                                                                    data-created-date="@notification.CreatedDate.ToString("MM/dd/yyyy h:mm tt")"
                                                                    data-expiry-date="@(notification.ExpiryDate?.ToString("MM/dd/yyyy h:mm tt") ?? "Not Set")"
                                                                    data-is-read="@isRead.ToString().ToLower()">
                                                                <i class="bi bi-eye"></i> View
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        
                                        @* Pagination for User Notifications *@
                                        @{
                                            var userPageNumber = ViewBag.PageNumber as int? ?? 1;
                                            var userTotalPages = ViewBag.TotalPages as int? ?? 1;
                                            var userTotalCount = ViewBag.TotalCount as int? ?? 0;
                                            var userPageSize = ViewBag.PageSize as int? ?? 10;
                                        }
                                        @if (userTotalCount > 0)
                                        {
                                            <nav aria-label="Page navigation" class="mt-3">
                                                <ul class="pagination justify-content-center">
                                                    <li class="page-item @(userPageNumber == 1 ? "disabled" : "")">
                                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = userPageNumber - 1, pageSize = userPageSize })">Previous</a>
                                                    </li>
                                                    @for (int i = 1; i <= userTotalPages; i++)
                                                    {
                                                        <li class="page-item @(i == userPageNumber ? "active" : "")">
                                                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = userPageSize })">@i</a>
                                                        </li>
                                                    }
                                                    <li class="page-item @(userPageNumber == userTotalPages ? "disabled" : "")">
                                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = userPageNumber + 1, pageSize = userPageSize })">Next</a>
                                                    </li>
                                                </ul>
                                            </nav>
                                            <div class="text-muted text-center mt-2">
                                                Showing @((userPageNumber - 1) * userPageSize + 1) to @Math.Min(userPageNumber * userPageSize, userTotalCount) of @userTotalCount notifications
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Notification Details Modal -->
                    <div class="modal fade" id="notificationDetailsModal" tabindex="-1" aria-labelledby="notificationDetailsModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg" style="max-width: 50%;">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="notificationDetailsModalLabel">Notification Details</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-12 mb-3">
                                            <div class="d-flex align-items-center">
                                                <label class="form-label fw-bold mb-0" style="min-width: 150px;">Priority</label>
                                                <span id="notificationModalPriority"></span>
                                            </div>
                                        </div>
                                        <div class="col-12 mb-3">
                                            <div class="d-flex align-items-center">
                                                <label class="form-label fw-bold mb-0" style="min-width: 150px;">Created Date</label>
                                                <span id="notificationModalCreatedDate" class="fw-normal"></span>
                                            </div>
                                        </div>
                                        <div class="col-12 mb-3">
                                            <div class="d-flex align-items-center">
                                                <label class="form-label fw-bold mb-0" style="min-width: 150px;">Expiry Date</label>
                                                <span id="notificationModalExpiryDate" class="fw-normal"></span>
                                            </div>
                                        </div>
                                        
                                        <div class="col-12 mb-3">
                                            <div class="d-flex align-items-center">
                                                <label class="form-label fw-bold mb-0" style="min-width: 150px;">Title</label>
                                                <span id="notificationModalTitle" class="fw-normal"></span>
                                            </div>
                                        </div>
                                        <div class="col-12 mb-3">
                                            <label class="form-label fw-bold">Message</label>
                                            <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto; background-color: #f8f9fa;">
                                                <p id="notificationModalMessage" class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; word-break: break-word;"></p>
                                            </div>
                                        </div>
                                        <div class="col-12 mb-3">
                                            <label class="form-label fw-bold">Your Reply</label>
                                            <div class="border rounded p-3" style="background-color: #f8f9fa;">
                                                <p id="notificationModalReply" class="mb-0 text-muted">Loading...</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary" id="replyNotificationBtn">Reply</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reply Notification Modal -->
                    <div class="modal fade" id="replyNotificationModal" tabindex="-1" aria-labelledby="replyNotificationModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="replyNotificationModalLabel">Reply to Notification</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label for="notificationReply" class="form-label">Reply <span class="text-danger">*</span></label>
                                        <textarea class="form-control" id="notificationReply" rows="4" required maxlength="2000" placeholder="Enter your reply..."></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" class="btn btn-primary" id="sendReplyBtn">Send</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }


                <!-- Notifications Section - Only for SuperAdmin -->
                @if (User.IsInRole("SuperAdmin"))
                {
                    var notifications = ViewBag.Notifications as List<TpaSodManagement.Database.Entities.Notification>;
                    var notificationsWithReplies = ViewBag.NotificationsWithReplies as List<long> ?? new List<long>();
                    var repliesCount = ViewBag.NotificationsWithRepliesCount as int? ?? 0;
                    <div class="row mt-4">
                        <div class="col-12">
                            <!-- Filter Controls -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="d-flex align-items-center gap-2">
                                        @await Html.PartialAsync("_FilterPartial", new Dictionary<string, string>())
                                    </div>
                                    <div id="activeFilterTags" class="mt-2 d-flex flex-wrap gap-1"></div>
                                </div>
                            </div>
                            
                            <div class="card">
                                <div class="card-header">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="card-title mb-0">
                                            Notifications Management
                                            <span class="badge bg-success ms-2" id="repliesCountBadge" style="display: none;">0 Replies</span>
                                        </h5>
                                        <div>
                                            <button type="button" class="btn btn-sm btn-outline-primary me-2" onclick="location.reload();" title="Refresh notifications and replies">
                                                <i class="bi bi-arrow-clockwise"></i> Refresh
                                            </button>
                                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#sendNotificationModal">
                                                <i class="bi bi-plus-circle"></i> Send Notification
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    @if (TempData["ErrorMessage"] != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <strong>Error!</strong> @TempData["ErrorMessage"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    }

                                    @if (TempData["SuccessMessage"] != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            <strong>Success!</strong> @TempData["SuccessMessage"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    }

                                    <div class="list-group">
                                        @if (notifications != null && notifications.Any())
                                        {
                                            @foreach (var notification in notifications)
                                            {
                                                var hasReply = notificationsWithReplies.Contains(notification.NotificationId);
                                                <div class="list-group-item @(hasReply ? "list-group-item-success" : "") superadmin-notification-item" 
                                                     data-notification-id="@notification.NotificationId" 
                                                     data-has-reply="@hasReply.ToString().ToLower()"
                                                     style="@(hasReply ? "border-left: 4px solid #198754;" : "")">
                                                    <div class="d-flex w-100 justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-1">
                                                                @if (hasReply)
                                                                {
                                                                    <span class="badge bg-success me-2">Reply</span>
                                                                }
                                                                @notification.Title
                                                                <span class="badge bg-@(notification.Priority == "Critical" ? "danger" : notification.Priority == "High" ? "warning" : notification.Priority == "Medium" ? "info" : "secondary") ms-2">
                                                                    @notification.Priority
                                                                </span>
                                                            </h6>
                                                            <p class="mb-1">@(notification.Message.Length > 100 ? notification.Message.Substring(0, 100) + "..." : notification.Message)</p>
                                                            <small class="text-muted">
                                                                <i class="bi bi-clock"></i> @notification.CreatedDate.ToString("MM/dd/yyyy h:mm tt")
                                                                <span class="ms-2">| Recipients: @notification.NotificationUsers.Count</span>
                                                                <span class="ms-2">| Expiry: @(notification.ExpiryDate?.ToString("MM/dd/yyyy h:mm tt") ?? "Not Set")</span>
                                                            </small>
                                                        </div>
                                                        <div class="ms-3">
                                                            <div class="btn-group btn-group-sm">
                                                                <a class="btn btn-info view-notification-details-btn" 
                                                                   asp-controller="Notification" 
                                                                   asp-action="Details" 
                                                                   asp-route-id="@notification.NotificationId"
                                                                   data-notification-id="@notification.NotificationId"
                                                                   data-has-reply="@hasReply.ToString().ToLower()">
                                                                    <i class="bi bi-eye"></i> View
                                                                </a>
                                                                <button class="btn btn-warning edit-notification" 
                                                                        data-id="@notification.NotificationId" 
                                                                        data-title="@notification.Title" 
                                                                        data-message="@notification.Message" 
                                                                        data-priority="@notification.Priority">
                                                                    <i class="bi bi-pencil"></i> Edit
                                                                </button>
                                                                <button class="btn btn-danger delete-notification" 
                                                                        data-id="@notification.NotificationId">
                                                                    <i class="bi bi-trash"></i> Delete
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="list-group-item text-center">No notifications found.</div>
                                        }
                                    </div>
                                    
                                    @* Pagination for SuperAdmin Notifications *@
                                    @{
                                        var adminPageNumber = ViewBag.PageNumber as int? ?? 1;
                                        var adminTotalPages = ViewBag.TotalPages as int? ?? 1;
                                        var adminTotalCount = ViewBag.TotalCount as int? ?? 0;
                                        var adminPageSize = ViewBag.PageSize as int? ?? 10;
                                    }
                                    @if (adminTotalCount > 0)
                                    {
                                        <nav aria-label="Page navigation" class="mt-3">
                                            <ul class="pagination justify-content-center">
                                                <li class="page-item @(adminPageNumber == 1 ? "disabled" : "")">
                                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = adminPageNumber - 1, pageSize = adminPageSize })">Previous</a>
                                                </li>
                                                @for (int i = 1; i <= adminTotalPages; i++)
                                                {
                                                    <li class="page-item @(i == adminPageNumber ? "active" : "")">
                                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = adminPageSize })">@i</a>
                                                    </li>
                                                }
                                                <li class="page-item @(adminPageNumber == adminTotalPages ? "disabled" : "")">
                                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = adminPageNumber + 1, pageSize = adminPageSize })">Next</a>
                                                </li>
                                            </ul>
                                        </nav>
