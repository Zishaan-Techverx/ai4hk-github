@section Scripts {
    <script>
        // Handle View button click for notifications (for regular users)
        $(document).ready(function() {
            $(document).on('click', '.view-notification-btn', function(e) {
                e.stopPropagation();
                e.preventDefault();
                
                
                var notificationId = $(this).data('notification-id');
                var title = $(this).data('title');
                var message = $(this).data('message');
                var priority = $(this).data('priority');
                var createdDate = $(this).data('created-date');
                var expiryDate = $(this).data('expiry-date');
                var isRead = $(this).data('is-read') === 'true';
                
                
                // Populate modal
                $('#notificationModalTitle').text(title);
                $('#notificationModalMessage').text(message);
                
                // Set priority badge
                var priorityClass = priority === 'Critical' ? 'danger' : 
                                   priority === 'High' ? 'warning' : 
                                   priority === 'Medium' ? 'info' : 
                                   priority === 'Low' ? 'secondary' : 'secondary';
                $('#notificationModalPriority').html('<span class="badge bg-' + priorityClass + '">' + priority + '</span>');
                
                $('#notificationModalCreatedDate').text(createdDate);
                $('#notificationModalExpiryDate').text(expiryDate || 'Not Set');
                
                // Store notification ID for reply button
                $('#replyNotificationBtn').data('notification-id', notificationId);
                
                // Load user's reply for this notification
                loadUserReply(notificationId);
                
                // Show modal
                var modalElement = document.getElementById('notificationDetailsModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                } else {
                    console.error('Modal element not found');
                }
                
                // Mark as read if not already read
                if (!isRead) {
                    var $item = $(this).closest('.list-group-item');
                    
                    $.ajax({
                        url: '@Url.Action("MarkNotificationAsRead", "Home")',
                        method: 'POST',
                        data: { notificationId: notificationId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                // Remove the "New" badge and highlight
                                $item.removeClass('list-group-item-primary');
                                $item.css('border-left', '');
                                $item.find('.badge.bg-primary').remove();
                                
                                // Update the button's data attribute
                                $('.view-notification-btn[data-notification-id="' + notificationId + '"]').data('is-read', 'true');
                                
                                // Update unread count
                                var unreadBadge = $('.card-header .badge.bg-danger');
                                var currentCount = parseInt(unreadBadge.text()) || 0;
                                var newCount = currentCount - 1;
                                
                                if (newCount > 0) {
                                    unreadBadge.text(newCount + ' New');
                                } else {
                                    unreadBadge.remove();
                                }
                            }
                        },
                        error: function() {
                            console.error('Failed to mark notification as read');
                        }
                    });
                }
            });

            // Function to load user's reply
            function loadUserReply(notificationId) {
                $('#notificationModalReply').html('<span class="text-muted">Loading...</span>');
                $.ajax({
                    url: '@Url.Action("GetUserReplyForNotification", "Home")',
                    method: 'GET',
                    data: { notificationId: notificationId },
                    success: function(response) {
                        if (response.success) {
                            if (response.hasReply) {
                                var replyHtml = '<div class="mb-2"><strong>Reply:</strong> ' + escapeHtml(response.reply) + '</div>';
                                replyHtml += '<div class="small text-muted">Replied on: ' + response.replyDate + '</div>';
                                $('#notificationModalReply').removeClass('text-muted').html(replyHtml);
                            } else {
                                $('#notificationModalReply').addClass('text-muted').text('Not responded');
                            }
                        } else {
                            $('#notificationModalReply').addClass('text-muted').text('Not responded');
                        }
                    },
                    error: function() {
                        $('#notificationModalReply').addClass('text-muted').text('Not responded');
                    }
                });
            }
            
            // Helper function to escape HTML
            function escapeHtml(text) {
                var map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.replace(/[&<>"']/g, function(m) { return map[m]; });
            }
            
            // Handle Reply button click
            $(document).on('click', '#replyNotificationBtn', function() {
                var notificationId = $(this).data('notification-id');
                if (!notificationId) {
                    alert('Notification ID not found.');
                    return;
                }

                // Check if user has already replied to this notification
                var userRepliedNotificationIds = @Html.Raw(Json.Serialize(ViewBag.UserRepliedNotificationIds ?? new List<long>()));
                var hasReplied = userRepliedNotificationIds.includes(parseInt(notificationId));
                
                if (hasReplied) {
                    // If user has already replied, show error message directly without opening popup
                    alert('You are not allowed to send multiple Replies');
                    return;
                }

                // Store notification ID for send reply button
                $('#sendReplyBtn').data('notification-id', notificationId);
                
                // Clear previous reply
                $('#notificationReply').val('');
                
                // Close notification details modal
                var detailsModal = bootstrap.Modal.getInstance(document.getElementById('notificationDetailsModal'));
                if (detailsModal) {
                    detailsModal.hide();
                }
                
                // Show reply modal
                var replyModalElement = document.getElementById('replyNotificationModal');
                if (replyModalElement) {
                    var replyModal = new bootstrap.Modal(replyModalElement);
                    replyModal.show();
                }
            });

            // Handle Send Reply button click
            $(document).on('click', '#sendReplyBtn', function() {
                var notificationId = $(this).data('notification-id');
                var reply = $('#notificationReply').val().trim();

                if (!notificationId) {
                    alert('Notification ID not found.');
                    return;
                }

                if (!reply) {
                    alert('Please enter a reply.');
                    $('#notificationReply').focus();
                    return;
                }

                // Disable button during request
                var $sendBtn = $(this);
                $sendBtn.prop('disabled', true).text('Sending...');

                $.ajax({
                    url: '@Url.Action("SendNotificationReply", "Home")',
                    method: 'POST',
                    data: {
                        notificationId: notificationId,
                        reply: reply
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            
                            // Reload user's reply in the notification details modal
                            var notificationId = $('#replyNotificationBtn').data('notification-id');
                            if (notificationId) {
                                loadUserReply(notificationId);
                            }
                            
                            // Close reply modal
                            var replyModal = bootstrap.Modal.getInstance(document.getElementById('replyNotificationModal'));
                            if (replyModal) {
                                replyModal.hide();
                            }
                            
                            // Clear reply field
                            $('#notificationReply').val('');
                        } else {
                            alert(response.message || 'Failed to send reply.');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error sending reply:', error);
                        alert('An error occurred while sending the reply. Please try again.');
                    },
                    complete: function() {
                        // Re-enable button
                        $sendBtn.prop('disabled', false).text('Send');
                    }
                });
            });
        });
    </script>
    
    @if (User.IsInRole("SuperAdmin"))
    {
        <script>
            var selectedOrganizations = [];
            var selectedUsers = [];
            var allOrganizations = [];
            var allUsers = [];
            
            $(document).ready(function() {
                // Check if we need to auto-open edit modal (from Details page)
                var urlParams = new URLSearchParams(window.location.search);
                var editNotificationId = urlParams.get('editNotificationId');
                if (editNotificationId) {
                    // Trigger edit for this notification
                    setTimeout(function() {
                        $('.edit-notification[data-id="' + editNotificationId + '"]').trigger('click');
                        // Clean up URL
                        window.history.replaceState({}, document.title, window.location.pathname);
                    }, 500);
                }
                
                // Load organizations when Send Notification button is clicked
                $('[data-bs-target="#sendNotificationModal"]').on('click', function() {
                    console.log('Send Notification button clicked');
                    setTimeout(function() {
                        loadOrganizations();
                    }, 100);
                });
                
                // Load organizations when modal is opened
                $('#sendNotificationModal').on('shown.bs.modal', function() {
                    console.log('Modal opened, loading organizations...');
                    loadOrganizations();
                });
                
                // Select All Organizations checkbox handler
                $(document).on('change', '#selectAllOrgsCheckbox', function(e) {
                    e.stopPropagation();
                    var isChecked = $(this).prop('checked');
                    
                    if (isChecked) {
                        selectedOrganizations = allOrganizations.map(org => org.organizationId);
                        $('.org-checkbox').prop('checked', true);
                    } else {
                        selectedOrganizations = [];
                        $('.org-checkbox').prop('checked', false);
                    }
                    updateOrganizationBadges();
                    loadUsersBySelectedOrganizations();
                });
                
                // Select All Organizations container click handler
                $(document).on('click', '#selectAllOrgs', function(e) {
                    if ($(e.target).is('#selectAllOrgsCheckbox')) {
                        return;
                    }
                    e.preventDefault();
                    e.stopPropagation();
                    var checkbox = $('#selectAllOrgsCheckbox');
                    checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
                });
                
                // Organization checkbox handler
                $(document).on('change', '.org-checkbox', function() {
                    var orgId = $(this).data('org-id');
                    if ($(this).prop('checked')) {
                        if (!selectedOrganizations.includes(orgId)) {
                            selectedOrganizations.push(orgId);
                        }
                    } else {
                        selectedOrganizations = selectedOrganizations.filter(id => id !== orgId);
                        $('#selectAllOrgsCheckbox').prop('checked', false);
                    }
                    updateOrganizationBadges();
                    loadUsersBySelectedOrganizations();
                });
                
                // Select All Users checkbox handler
                $(document).on('change', '#selectAllUsersCheckbox', function(e) {
                    e.stopPropagation();
                    var isChecked = $(this).prop('checked');
                    
                    if (isChecked) {
                        selectedUsers = allUsers.map(user => user.id);
                        $('.user-checkbox').prop('checked', true);
                    } else {
                        selectedUsers = [];
                        $('.user-checkbox').prop('checked', false);
                    }
                    updateUserBadges();
                });
                
                // Select All Users container click handler
                $(document).on('click', '#selectAllUsers', function(e) {
                    if ($(e.target).is('#selectAllUsersCheckbox')) {
                        return;
                    }
                    e.preventDefault();
                    e.stopPropagation();
                    var checkbox = $('#selectAllUsersCheckbox');
                    checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
                });
                
                // User checkbox handler
                $(document).on('change', '.user-checkbox', function() {
                    var userId = $(this).data('user-id');
                    if ($(this).prop('checked')) {
                        if (!selectedUsers.includes(userId)) {
                            selectedUsers.push(userId);
                        }
                    } else {
                        selectedUsers = selectedUsers.filter(id => id !== userId);
                        $('#selectAllUsersCheckbox').prop('checked', false);
                    }
                    updateUserBadges();
                });
                
                // Edit notification handler
                $(document).on('click', '.edit-notification', function() {
                    var notificationId = $(this).data('id');
                    
                    // Load notification details via AJAX
                    $.get('/Notification/GetNotification', { id: notificationId }, function(response) {
                        if (response.success) {
                            // Populate form fields
                            $('#notificationTitle').val(response.notification.title);
                            $('#notificationMessage').val(response.notification.message);
                            $('#notificationPriority').val(response.notification.priority);
                            
                            if (response.notification.expiryDate) {
                                $('#notificationExpiryDate').val(response.notification.expiryDate);
                            } else {
                                $('#notificationExpiryDate').val('');
                            }
                            
                            // Store notification ID for update
                            $('#sendNotificationForm').data('notification-id', notificationId);
                            $('#sendNotificationForm').data('is-edit', true);
                            
                            // Change modal title and button text
                            $('#sendNotificationModalLabel').text('Edit Notification');
                            $('#sendNotificationForm button[type="submit"]').text('Update Notification');
                            
                            // Load organizations first
                            loadOrganizations();
                            
                            // After organizations load, select the users
                            setTimeout(function() {
                                // Get user IDs from response
                                var userIds = response.notification.userIds || [];
                                
                                // Load users for all organizations to show them
                                loadAllUsersForEdit(userIds);
                            }, 500);
                            
                            // Open modal
                            var modalElement = document.getElementById('sendNotificationModal');
                            if (modalElement) {
                                var modal = new bootstrap.Modal(modalElement);
                                modal.show();
                            }
                        } else {
                            alert('Failed to load notification details.');
                        }
                    }).fail(function() {
                        alert('An error occurred while loading notification details.');
                    });
                });
                
                // Form submit handler
                $('#sendNotificationForm').on('submit', function(e) {
                    e.preventDefault();
                    var isEdit = $(this).data('is-edit');
                    if (isEdit) {
                        updateNotification();
                    } else {
                        sendNotification();
                    }
                });
                
                // Delete notification handler
                $(document).on('click', '.delete-notification', function() {
                    if (confirm('Are you sure you want to delete this notification?')) {
                        var notificationId = $(this).data('id');
                        deleteNotification(notificationId);
                    }
                });
                
                // Reset form when modal is closed
                $('#sendNotificationModal').on('hidden.bs.modal', function() {
                    $('#sendNotificationForm')[0].reset();
                    selectedOrganizations = [];
                    selectedUsers = [];
                    allUsers = [];
                    updateOrganizationBadges();
                    updateUserBadges();
                    $('#organizationOptions').empty();
                    $('#userOptions').empty();
                    $('#selectAllOrgsCheckbox').prop('checked', false);
                    $('#selectAllUsersCheckbox').prop('checked', false);
                });
            });
            
            function loadOrganizations() {
                $.get('/Notification/GetOrganizations', function(data) {
                    if (data && data.length > 0) {
                        allOrganizations = data;
                        var optionsContainer = $('#organizationOptions');
                        optionsContainer.empty();
                        
                        $.each(data, function(index, org) {
                            var listItem = $('<li></li>');
                            var checkboxId = 'org-' + org.organizationId;
                            var item = $('<a class="dropdown-item" href="#"></a>');
                            item.append($('<input>', {
                                type: 'checkbox',
                                class: 'form-check-input me-2 org-checkbox',
                                id: checkboxId,
                                'data-org-id': org.organizationId
                            }));
                            item.append($('<label>', {
                                class: 'form-check-label',
                                'for': checkboxId,
                                text: org.organizationName,
                                style: 'cursor: pointer; width: 100%;'
                            }));
                            listItem.append(item);
                            optionsContainer.append(listItem);
                        });
                    } else {
                        console.log('No organizations found');
                        $('#organizationOptions').html('<li><span class="dropdown-item-text">No organizations available</span></li>');
                    }
                }).fail(function(xhr, status, error) {
                    console.error('Error loading organizations:', error);
                    $('#organizationOptions').html('<li><span class="dropdown-item-text text-danger">Error loading organizations</span></li>');
                });
            }
            
            function loadUsersBySelectedOrganizations() {
                if (selectedOrganizations.length === 0) {
                    $('#userOptions').empty();
                    allUsers = [];
                    selectedUsers = [];
                    updateUserBadges();
                    $('#selectAllUsersCheckbox').prop('checked', false);
                    return;
                }
                
                $('#userOptions').html('<li><span class="dropdown-item-text">Loading...</span></li>');
                
                var allUsersList = [];
                var loadedCount = 0;
                
                selectedOrganizations.forEach(function(orgId) {
                    $.get('/Notification/GetUsersByOrganization', { organizationId: orgId }, function(data) {
                        allUsersList = allUsersList.concat(data);
                        loadedCount++;
                        
                        if (loadedCount === selectedOrganizations.length) {
                            var uniqueUsers = [];
                            var userIdSet = new Set();
                            allUsersList.forEach(function(user) {
                                if (!userIdSet.has(user.id)) {
                                    userIdSet.add(user.id);
                                    uniqueUsers.push(user);
                                }
                            });
                            
                            allUsers = uniqueUsers;
                            renderUsers(uniqueUsers);
                        }
                    });
                });
            }
            
            function renderUsers(users) {
                var optionsContainer = $('#userOptions');
                optionsContainer.empty();
                
                $.each(users, function(index, user) {
                    var listItem = $('<li></li>');
                    var checkboxId = 'user-' + user.id;
                    var item = $('<a class="dropdown-item" href="#"></a>');
                    item.append($('<input>', {
                        type: 'checkbox',
                        class: 'form-check-input me-2 user-checkbox',
                        id: checkboxId,
                        'data-user-id': user.id,
                        checked: selectedUsers.includes(user.id)
                    }));
                    item.append($('<label>', {
                        class: 'form-check-label',
                        'for': checkboxId,
                        text: user.userName + ' (' + user.email + ')',
                        style: 'cursor: pointer; width: 100%;'
                    }));
                    listItem.append(item);
                    optionsContainer.append(listItem);
                });
                
                if (users.length > 0 && selectedUsers.length === users.length) {
                    $('#selectAllUsersCheckbox').prop('checked', true);
                } else {
                    $('#selectAllUsersCheckbox').prop('checked', false);
                }
            }
            
            function updateOrganizationBadges() {
                var badgesContainer = $('#selectedOrganizationsBadges');
                badgesContainer.empty();
                
                if (selectedOrganizations.length === 0) {
                    $('#organizationDropdownText').text('Select Organizations');
                    return;
                }
                
                var selectedOrgNames = selectedOrganizations.map(function(orgId) {
                    var org = allOrganizations.find(o => o.organizationId === orgId);
                    return org ? org.organizationName : '';
                }).filter(name => name !== '');
                
                $('#organizationDropdownText').text(selectedOrgNames.length + ' organization(s) selected');
                
                selectedOrgNames.forEach(function(orgName) {
                    var orgId = allOrganizations.find(o => o.organizationName === orgName).organizationId;
                    var badge = $('<span>', {
                        class: 'badge bg-primary me-1 mb-1',
                        text: orgName + ' ×',
                        style: 'cursor: pointer;'
                    });
                    badge.on('click', function() {
                        selectedOrganizations = selectedOrganizations.filter(id => id !== orgId);
                        $('.org-checkbox[data-org-id="' + orgId + '"]').prop('checked', false);
                        $('#selectAllOrgsCheckbox').prop('checked', false);
                        updateOrganizationBadges();
                        loadUsersBySelectedOrganizations();
                    });
                    badgesContainer.append(badge);
                });
            }
            
            function updateUserBadges() {
                var badgesContainer = $('#selectedUsersBadges');
                badgesContainer.empty();
                
                if (selectedUsers.length === 0) {
                    $('#userDropdownText').text('Select Users');
                    return;
                }
                
                var selectedUserNames = selectedUsers.map(function(userId) {
                    var user = allUsers.find(u => u.id === userId);
                    return user ? user.userName + ' (' + user.email + ')' : '';
                }).filter(name => name !== '');
                
                $('#userDropdownText').text(selectedUsers.length + ' user(s) selected');
                
                selectedUserNames.forEach(function(userName) {
                    var userId = allUsers.find(u => (u.userName + ' (' + u.email + ')') === userName).id;
                    var badge = $('<span>', {
                        class: 'badge bg-primary me-1 mb-1',
                        text: userName + ' ×',
                        style: 'cursor: pointer;'
                    });
                    badge.on('click', function() {
                        selectedUsers = selectedUsers.filter(id => id !== userId);
                        $('.user-checkbox[data-user-id="' + userId + '"]').prop('checked', false);
                        $('#selectAllUsersCheckbox').prop('checked', false);
                        updateUserBadges();
                    });
                    badgesContainer.append(badge);
                });
            }
            
            function sendNotification() {
                var title = $('#notificationTitle').val();
                var message = $('#notificationMessage').val();
                var priority = $('#notificationPriority').val();
                var expiryDate = $('#notificationExpiryDate').val();
                
                if (!title || !message || !priority) {
                    alert('Please fill in all required fields.');
                    return;
                }
                
                if (selectedUsers.length === 0) {
                    alert('Please select at least one user.');
                    return;
                }
                
                var formData = {
                    title: title,
                    message: message,
                    priority: priority,
                    expiryDate: expiryDate || null,
                    userIds: selectedUsers.map(id => parseInt(id))
                };
                
                $.ajax({
                    url: '/Notification/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while sending the notification.');
                    }
                });
            }
            
            function loadAllUsersForEdit(userIds) {
                // Load all users from all organizations
                $.get('/Notification/GetUsersByOrganization', function(data) {
                    allUsers = data;
                    selectedUsers = userIds || [];
                    renderUsers(data);
                    updateUserBadges();
                });
            }
            
            function updateNotification() {
                var notificationId = $('#sendNotificationForm').data('notification-id');
                var title = $('#notificationTitle').val();
                var message = $('#notificationMessage').val();
                var priority = $('#notificationPriority').val();
                var expiryDate = $('#notificationExpiryDate').val();
                
                if (!notificationId) {
                    alert('Notification ID is missing. Please try again.');
                    return;
                }
                
                if (!title || !message || !priority) {
                    alert('Please fill in all required fields.');
                    return;
                }
                
                if (selectedUsers.length === 0) {
                    alert('Please select at least one user.');
                    return;
                }
                
                var formData = {
                    notificationId: parseInt(notificationId),
                    title: title.trim(),
                    message: message.trim(),
                    priority: priority.trim(),
                    expiryDate: expiryDate ? expiryDate : null,
                    userIds: selectedUsers.map(id => parseInt(id))
                };
                
                console.log('Updating notification:', formData);
                
                $.ajax({
                    url: '/Notification/Update',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        console.log('Update response:', response);
                        if (response.success) {
                            alert(response.message);
                            $('#sendNotificationModal').modal('hide');
                            location.reload();
                        } else {
                            alert(response.message || 'Failed to update notification.');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Update error:', error, xhr.responseText);
                        var errorMessage = 'An error occurred while updating the notification.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        alert(errorMessage);
                    }
                });
            }
            
            function deleteNotification(notificationId) {
                $.ajax({
                    url: '/Notification/Delete',
                    type: 'POST',
                    data: { id: notificationId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while deleting the notification.');
                    }
                });
            }

            // SuperAdmin: Handle viewed notifications with replies
            $(document).ready(function() {
                // Function to update UI based on viewed notifications
                function updateViewedNotifications() {
                    // Load viewed notifications from localStorage (persists across app restarts)
                    var viewedNotifications = JSON.parse(localStorage.getItem('superadminViewedNotifications') || '[]');
                    
                    // Remove highlight from already viewed notifications
                    viewedNotifications.forEach(function(notificationId) {
                        var $item = $('.superadmin-notification-item[data-notification-id="' + notificationId + '"]');
                        if ($item.length) {
                            $item.removeClass('list-group-item-success');
                            $item.css('border-left', '');
                            $item.find('.badge.bg-success').remove();
                            $item.attr('data-has-reply', 'false');
                            $item.find('.view-notification-details-btn').data('has-reply', 'false');
                        }
                    });
                    
                    // Update replies count badge
                    updateRepliesCount();
                }
                
                // Initial update on page load
                updateViewedNotifications();
                
                // Initial count update
                updateRepliesCount();
                
                // Also update when page becomes visible (when returning from details page)
                document.addEventListener('visibilitychange', function() {
                    if (!document.hidden) {
                        setTimeout(updateViewedNotifications, 100);
                    }
                });
                
                // Update on focus (when tab becomes active)
                $(window).on('focus', function() {
                    setTimeout(updateViewedNotifications, 100);
                });
                
                // Update when page is shown (for browser back/forward navigation)
                window.addEventListener('pageshow', function(event) {
                    if (event.persisted) {
                        // Page was loaded from cache (back/forward button)
                        setTimeout(updateViewedNotifications, 100);
                    }
                });
                
                // Handle View button click for SuperAdmin
                $(document).on('click', '.view-notification-details-btn', function(e) {
                    var notificationId = $(this).data('notification-id');
                    var hasReply = $(this).data('has-reply') === 'true';
                    var href = $(this).attr('href');
                    
                    // If notification has reply, mark it as viewed before navigation
                    if (hasReply) {
                        e.preventDefault();
                        var $item = $(this).closest('.superadmin-notification-item');
                        
                        // Load current viewed notifications from localStorage
                        var viewedNotifications = JSON.parse(localStorage.getItem('superadminViewedNotifications') || '[]');
                        
                        // Add to viewed list
                        if (viewedNotifications.indexOf(notificationId) === -1) {
                            viewedNotifications.push(notificationId);
                            localStorage.setItem('superadminViewedNotifications', JSON.stringify(viewedNotifications));
                        }
                        
                        // Remove highlight immediately
                        $item.removeClass('list-group-item-success');
                        $item.css('border-left', '');
                        $item.find('.badge.bg-success').remove();
                        $item.attr('data-has-reply', 'false');
                        $(this).data('has-reply', 'false');
                        
                        // Update replies count
                        updateRepliesCount();
                        
                        // Navigate to details page
                        window.location.href = href;
                    }
                    // If no reply, allow normal navigation
                });
                
                function updateRepliesCount() {
                    // Get viewed notifications from localStorage (persists across app restarts)
                    var viewedNotifications = JSON.parse(localStorage.getItem('superadminViewedNotifications') || '[]');
                    
                    // Count only unviewed notifications with replies
                    var unviewedRepliesCount = 0;
                    $('.superadmin-notification-item').each(function() {
                        var notificationId = $(this).data('notification-id');
                        var hasReply = $(this).data('has-reply') === 'true';
                        var isViewed = viewedNotifications.indexOf(notificationId) !== -1;
                        
                        if (hasReply && !isViewed) {
                            unviewedRepliesCount++;
                        }
                    });
                    
                    var repliesBadge = $('#repliesCountBadge');
                    
                    if (unviewedRepliesCount > 0) {
                        repliesBadge.text(unviewedRepliesCount + ' Replies').show();
                    } else {
                        repliesBadge.hide();
                    }
                }
            });
            
            // Page size change functions
            function changeUserPageSize(size) {
                const url = new URL(window.location.href);
                url.searchParams.set('pageSize', size);
                url.searchParams.set('pageNumber', '1'); // Reset to first page
                window.location.href = url.toString();
            }
            
            function changeAdminPageSize(size) {
                const url = new URL(window.location.href);
                url.searchParams.set('pageSize', size);
                url.searchParams.set('pageNumber', '1'); // Reset to first page
                window.location.href = url.toString();
            }

            // SuperAdmin Filter Functionality
            (function() {
                const adminDataFiltersStorageKey = 'dataFilters_Notifications_Admin';
                var adminActiveFilters = JSON.parse(localStorage.getItem(adminDataFiltersStorageKey) || '{}');
                var adminFilteredData = [];
                var adminIsFiltered = Object.keys(adminActiveFilters).length > 0;
                var adminCurrentPage = 1;
                var adminPageSize = @(ViewBag.PageSize as int? ?? 10);

                // Initialize filter functionality
                (function() {
                    // Handle clear all filters in modal
                    const clearAllFiltersInModalBtn = document.getElementById('clearAllFiltersInModalBtn');
                    if (clearAllFiltersInModalBtn) {
                        clearAllFiltersInModalBtn.addEventListener('click', function() {
                            document.querySelectorAll('.filter-input, .filter-date-from, .filter-date-to').forEach(input => {
                                input.value = '';
                            });
                            document.querySelectorAll('.clear-column-filter, .clear-date-from-filter, .clear-date-to-filter').forEach(btn => {
                                btn.style.display = 'none';
                            });
                            adminActiveFilters = {};
                            localStorage.setItem(adminDataFiltersStorageKey, JSON.stringify({}));
                        });
                    }

                    // Clear all filters button (outside modal)
                    const clearAllFiltersBtn = document.getElementById('clearAllFiltersBtn');
                    if (clearAllFiltersBtn) {
                        clearAllFiltersBtn.addEventListener('click', async function() {
                            document.querySelectorAll('.filter-input, .filter-date-from, .filter-date-to').forEach(input => {
                                input.value = '';
                            });
                            document.querySelectorAll('.clear-column-filter, .clear-date-from-filter, .clear-date-to-filter').forEach(btn => {
                                btn.style.display = 'none';
                            });
                            adminActiveFilters = {};
                            localStorage.setItem(adminDataFiltersStorageKey, JSON.stringify({}));
                            adminIsFiltered = false;
                            updateAdminFilterTags();
                            updateAdminFilterCount();
                            window.location.reload();
                        });
                    }

                    // Attach apply filter button handler
                    const applyFilterBtn = document.getElementById('applyFilterBtn');
                    if (applyFilterBtn) {
                        applyFilterBtn.addEventListener('click', async function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            if (typeof window.applyAdminFilters === 'function') {
                                await window.applyAdminFilters();
                            } else {
                                console.error('window.applyAdminFilters not found');
                                alert('Filter function not found. Please refresh the page.');
                            }
                        });
                    }

                    // Restore persisted filters on page load
                    if (adminIsFiltered && Object.keys(adminActiveFilters).length > 0) {
                        restoreAdminFilterInputsFromStorage();
                        updateAdminFilterTags();
                        updateAdminFilterCount();
                        window.applyAdminFilters();
                    }
                })();

                function restoreAdminFilterInputsFromStorage() {
                    Object.keys(adminActiveFilters).forEach(columnKey => {
                        const value = adminActiveFilters[columnKey];
                        const baseCol = columnKey.endsWith('_From') ? columnKey.slice(0, -5) : (columnKey.endsWith('_To') ? columnKey.slice(0, -3) : columnKey);
                        if (columnKey.endsWith('_From')) {
                            const dateFrom = document.querySelector(`.filter-date-from[data-column="${baseCol}"]`);
                            if (dateFrom) dateFrom.value = value;
                        } else if (columnKey.endsWith('_To')) {
                            const dateTo = document.querySelector(`.filter-date-to[data-column="${baseCol}"]`);
                            if (dateTo) dateTo.value = value;
                        } else {
                            const filterInput = document.querySelector(`.filter-input[data-column="${baseCol}"]`);
                            if (filterInput) {
                                filterInput.value = value;
                                const clearBtn = document.querySelector(`.clear-column-filter[data-column="${baseCol}"]`);
                                if (clearBtn) clearBtn.style.display = 'block';
                            }
                        }
                    });
                }

                window.applyAdminFilters = async function() {
                    try {
                        // Collect all filter values from inputs
                        adminActiveFilters = {};
                        
                        // Collect from text inputs (Search field)
                        const filterInputs = document.querySelectorAll('.filter-input:not(:disabled)');
                        filterInputs.forEach(input => {
                            const column = input.getAttribute('data-column');
                            const value = input.value.trim();
                            if (value) {
                                adminActiveFilters[column] = value;
                            }
                        });
                        
                        // Collect from date inputs
                        const filterDateFroms = document.querySelectorAll('.filter-date-from:not(:disabled)');
                        filterDateFroms.forEach(input => {
                            const column = input.getAttribute('data-column');
                            const value = input.value;
                            if (value) {
                                adminActiveFilters[`${column}_From`] = value;
                            }
                        });
                        
                        const filterDateTos = document.querySelectorAll('.filter-date-to:not(:disabled)');
                        filterDateTos.forEach(input => {
                            const column = input.getAttribute('data-column');
                            const value = input.value;
                            if (value) {
                                adminActiveFilters[`${column}_To`] = value;
                            }
                        });

                        // If no filters are active, clear everything and reload
                        if (Object.keys(adminActiveFilters).length === 0) {
                            updateAdminFilterTags();
                            updateAdminFilterCount();
                            localStorage.setItem(adminDataFiltersStorageKey, JSON.stringify({}));
                            const modal = bootstrap.Modal.getInstance(document.getElementById('filterModal'));
                            if (modal) modal.hide();
                            window.location.reload();
                            return;
                        }

                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const response = await fetch('@Url.Action("FilterNotifications", "Home")', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify(adminActiveFilters)
                        });
                        
                        if (!response.ok) {
                            const errorText = await response.text();
                            console.error('Response error:', response.status, errorText);
                            alert('Error: Server returned status ' + response.status);
                            return;
                        }
                        
                        const result = await response.json();
                        if (result.success) {
                            adminFilteredData = result.data || [];
                            adminIsFiltered = Object.keys(adminActiveFilters).length > 0;
                            adminCurrentPage = 1;
                            localStorage.setItem(adminDataFiltersStorageKey, JSON.stringify(adminActiveFilters));
                            updateAdminTable(adminFilteredData, result.replies || []);
                            updateAdminFilterTags();
                            updateAdminFilterCount();
                            setTimeout(function() {
                                if (typeof updateViewedNotifications === 'function') {
                                    updateViewedNotifications();
                                }
                                if (typeof updateRepliesCount === 'function') {
                                    updateRepliesCount();
                                }
                            }, 200);
                            const modal = bootstrap.Modal.getInstance(document.getElementById('filterModal'));
                            if (modal) modal.hide();
                        } else {
                            alert('Error: ' + (result.message || 'Unknown error'));
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('Error applying filters: ' + error.message);
                    }
                }

                function updateAdminTable(data, replies) {
                    let listGroup = document.querySelector('.superadmin-notification-item')?.closest('.list-group');
                    if (!listGroup) {
                        const cardBody = document.querySelector('.card-body');
                        if (cardBody) {
                            const newListGroup = document.createElement('div');
                            newListGroup.className = 'list-group';
                            cardBody.insertBefore(newListGroup, cardBody.firstChild);
                            listGroup = newListGroup;
                        } else {
                            return;
                        }
                    }
                    
                    const viewedNotifications = JSON.parse(localStorage.getItem('superadminViewedNotifications') || '[]');
                    const repliesList = replies || [];
                    
                    listGroup.innerHTML = '';
                    if (data.length === 0) {
                        listGroup.innerHTML = '<div class="list-group-item text-center">No notifications found.</div>';
                        return;
                    }
                    
                    data.forEach(item => {
                        const notificationId = typeof item.notificationId === 'number' ? item.notificationId : parseInt(item.notificationId);
                        const hasReply = repliesList.includes(notificationId);
                        const isViewed = viewedNotifications.indexOf(notificationId) !== -1;
                        const shouldHighlight = hasReply && !isViewed;
                        
                        const priorityClass = item.priority === 'Critical' ? 'danger' : 
                                           item.priority === 'High' ? 'warning' : 
                                           item.priority === 'Medium' ? 'info' : 'secondary';
                        
                        const hasReplyStr = String(hasReply).toLowerCase();
                        const itemHtml = `
                            <div class="list-group-item ${shouldHighlight ? 'list-group-item-success' : ''} superadmin-notification-item" 
                                 data-notification-id="${notificationId}" 
                                 data-has-reply="${hasReplyStr}"
                                 style="${shouldHighlight ? 'border-left: 4px solid #198754;' : ''}">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">
                                            ${shouldHighlight ? '<span class="badge bg-success me-2">Reply</span>' : ''}
                                            ${escapeHtml(item.title || '')}
                                            <span class="badge bg-${priorityClass} ms-2">${escapeHtml(item.priority || '')}</span>
                                        </h6>
                                        <p class="mb-1">${escapeHtml(item.message || '')}</p>
                                        <small class="text-muted">
                                            ${item.createdDate} | Recipients: ${item.recipientsCount || 0} | Expiry: ${escapeHtml(item.expiryDate || 'Not Set')}
                                        </small>
                                    </div>
                                    <div class="ms-3">
                                        <a href="/Notification/Details/${notificationId}" class="btn btn-sm btn-primary view-notification-details-btn" data-notification-id="${notificationId}" data-has-reply="${hasReplyStr}">View</a>
                                        <button class="btn btn-sm btn-warning edit-notification" data-id="${notificationId}">Edit</button>
                                        <button class="btn btn-sm btn-danger delete-notification" data-id="${notificationId}">Delete</button>
                                    </div>
                                </div>
                            </div>
                        `;
                        listGroup.insertAdjacentHTML('beforeend', itemHtml);
                    });
                }

                function escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }

                function updateAdminFilterTags() {
                    const container = document.getElementById('activeFilterTags');
                    if (!container) return;
                    
                    container.innerHTML = '';
                    if (Object.keys(adminActiveFilters).length === 0) {
                        return;
                    }
                    
                    Object.keys(adminActiveFilters).forEach(key => {
                        const value = adminActiveFilters[key];
                        let displayKey = key;
                        let displayValue = value;
                        
                        // Format display key and value
                        if (key === 'Search') {
                            displayKey = 'Search';
                        } else if (key.endsWith('_From')) {
                            displayKey = key.replace('_From', '') + ' (From)';
                        } else if (key.endsWith('_To')) {
                            displayKey = key.replace('_To', '') + ' (To)';
                        }
                        
                        const tag = document.createElement('span');
                        tag.className = 'badge bg-primary me-1 mb-1';
                        tag.style.cursor = 'pointer';
                        tag.innerHTML = `${displayKey}: ${escapeHtml(displayValue)} <i class="fa-solid fa-times ms-1"></i>`;
                        tag.addEventListener('click', function(e) {
                            e.stopPropagation();
                            delete adminActiveFilters[key];
                            localStorage.setItem(adminDataFiltersStorageKey, JSON.stringify(adminActiveFilters));
                            
                            // Clear corresponding input fields
                            if (key === 'Search') {
                                const filterInput = document.querySelector('.filter-input[data-column="Search"]');
                                if (filterInput) filterInput.value = '';
                                const clearBtn = document.querySelector('.clear-column-filter[data-column="Search"]');
                                if (clearBtn) clearBtn.style.display = 'none';
                            } else if (key.endsWith('_From')) {
                                const baseColumn = key.replace('_From', '');
                                const dateFromInput = document.querySelector(`.filter-date-from[data-column="${baseColumn}"]`);
                                if (dateFromInput) dateFromInput.value = '';
                                const clearBtn = document.querySelector(`.clear-date-from-filter[data-column="${baseColumn}"]`);
                                if (clearBtn) clearBtn.style.display = 'none';
                            } else if (key.endsWith('_To')) {
                                const baseColumn = key.replace('_To', '');
                                const dateToInput = document.querySelector(`.filter-date-to[data-column="${baseColumn}"]`);
                                if (dateToInput) dateToInput.value = '';
                                const clearBtn = document.querySelector(`.clear-date-to-filter[data-column="${baseColumn}"]`);
                                if (clearBtn) clearBtn.style.display = 'none';
                            }
                            
                            updateAdminFilterTags();
                            updateAdminFilterCount();
                            
                            // If no filters left, reload page
                            if (Object.keys(adminActiveFilters).length === 0) {
                                window.location.reload();
                            } else {
                                window.applyAdminFilters();
                            }
                        });
                        container.appendChild(tag);
                    });
                }

                function updateAdminFilterCount() {
                    const count = Object.keys(adminActiveFilters).length;
                    const countBadge = document.getElementById('activeFilterCount');
                    const clearAllBtn = document.getElementById('clearAllFiltersBtn');
                    
                    if (count > 0) {
                        if (countBadge) {
                            countBadge.textContent = count;
                            countBadge.style.display = 'inline-block';
                        }
                        if (clearAllBtn) {
                            clearAllBtn.style.display = 'inline-block';
                        }
                    } else {
                        if (countBadge) {
                            countBadge.style.display = 'none';
                        }
                        if (clearAllBtn) {
                            clearAllBtn.style.display = 'none';
                        }
                    }
                }
            })();
        </script>
    }
    
