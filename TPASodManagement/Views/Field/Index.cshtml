@model IEnumerable<TpaSodManagement.ViewModels.Field.FieldItemViewModel>

@{
    ViewData["Title"] = "Fields";
}

<br />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Fields</h1>
    @if (User.HasPermission("Field.Create"))
    {
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-body shadow-sm">
    <table class="table" id="fieldTable">
        <thead>
            <tr>
                <th>Field Name</th>
                <th>Field Code</th>
                <th>Area Amount</th>
                <th>Area Type</th>
                <th>Farm</th>
                <th>Soil Type</th>
                <th>Irrigation Available</th>
                <th>Is Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.FieldId">
                    <td>@Html.DisplayFor(modelItem => item.FieldName)</td>
                    <td>@Html.DisplayFor(modelItem => item.FieldCode)</td>
                    <td>@Html.DisplayFor(modelItem => item.AreaAmount)</td>
                    <td>@(item.AreaTypeName ?? "N/A")</td>
                    <td>@(!string.IsNullOrEmpty(item.FarmLicenseNumber) ? item.FarmLicenseNumber : $"Farm #{item.FarmId}")</td>
                    <td>@Html.DisplayFor(modelItem => item.SoilType)</td>
                    <td>
                        @if (item.IrrigationAvailable)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td style="display: flex; gap: 8px; align-items: center;">
                        @if (User.HasPermission("Field.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.FieldId" title="Edit">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </a>
                        }
                        
                        @if (User.HasPermission("Field.Detail"))
                        {
                            <a asp-action="Details" asp-route-id="@item.FieldId" title="Details">
                                <i class="fa-solid fa-circle-info"></i>
                            </a>
                        }
                        
                        @if (User.HasPermission("Field.Delete"))
                        {
                            <a href="#" class="delete-btn" data-id="@item.FieldId" 
                                data-name="@item.FieldName"
                                data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete">
                                <i class="fa-solid fa-trash-can" style="color: #ff0000;"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Toast for success message -->
<div aria-live="polite" aria-atomic="true" class="position-relative">
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="deleteSuccessToast" class="toast align-items-center text-white bg-success border-0" role="alert"
            aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    Field deleted successfully!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                    aria-label="Close"></button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the field: <strong id="fieldNamePlaceholder"></strong>?</p>
                <div class="alert alert-danger d-none" role="alert" id="deleteError">
                    Error deleting the record. Please try again.
                </div>

                <input type="hidden" id="fieldIdToDelete" />

                @Html.AntiForgeryToken()
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const fieldIdInput = document.getElementById('fieldIdToDelete');
        const fieldNamePlaceholder = document.getElementById('fieldNamePlaceholder');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const deleteErrorAlert = document.getElementById('deleteError');
        const deleteSuccessToast = new bootstrap.Toast(document.getElementById('deleteSuccessToast'));

        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const fieldId = this.getAttribute('data-id');
                const fieldName = this.getAttribute('data-name');

                fieldIdInput.value = fieldId;
                fieldNamePlaceholder.innerText = fieldName;
                deleteErrorAlert.classList.add('d-none');
                confirmDeleteBtn.disabled = false;
                confirmDeleteBtn.innerHTML = 'Delete';
            });
        });

        confirmDeleteBtn.addEventListener('click', function () {
            const fieldId = fieldIdInput.value;
            if (!fieldId) {
                deleteErrorAlert.innerText = 'Error: Field ID not found.';
                deleteErrorAlert.classList.remove('d-none');
                return;
            }

            confirmDeleteBtn.disabled = true;
            confirmDeleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Deleting...';

            const requestBody = 'id=' + encodeURIComponent(fieldId) +
                '&__RequestVerificationToken=' + encodeURIComponent(antiForgeryToken);

            fetch('@Url.Action("Delete", "Field")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: requestBody
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const rowToRemove = document.getElementById('row-' + fieldId);
                        if (rowToRemove) {
                            rowToRemove.remove();
                        }
                        deleteModal.hide();
                        deleteSuccessToast.show();
                    } else {
                        deleteErrorAlert.innerText = data.message || 'Error deleting the record. Please try again.';
                        deleteErrorAlert.classList.remove('d-none');
                    }
                })
                .catch(error => {
                    console.error('Delete failed:', error);
                    deleteErrorAlert.innerText = 'Deletion failed: ' + error.message;
                    deleteErrorAlert.classList.remove('d-none');
                })
                .finally(() => {
                    confirmDeleteBtn.disabled = false;
                    confirmDeleteBtn.innerHTML = 'Delete';
                });
        });
    });
</script>

