@model TpaSodManagement.Models.Db.Organization

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Organization</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrganizationName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizationName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrganizationType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizationType)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LogoPath)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.LogoPath))
            {
                <img src="@Url.Content(Model.LogoPath)" alt="Organization Logo" style="max-width:150px; max-height:150px; border:1px solid #ccc; border-radius:5px;" />
            }
            else
            {
                <span class="text-muted">No logo uploaded</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="OrganizationId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
