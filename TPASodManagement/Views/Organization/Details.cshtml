@model TpaSodManagement.Models.Db.Organization

@{
    ViewData["Title"] = "Details";
}
<br />
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Details</h1>
</div>

<div>
    <h4>Organization</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Organization Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizationName)
        </dd>

        <dt class="col-sm-2">
            Organization Type
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizationType)
        </dd>

        <dt class="col-sm-2">
            Logo
        </dt>
        <dd class="col-sm-10">
            @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
            {
                <img src="@Url.Action("GetLogo", "Organization", new { id = Model.OrganizationId })"
                     alt="Organization Logo"
                     style="max-width:150px; max-height:150px; border:1px solid #ccc; border-radius:5px;" />
            }
            else
            {
                <span class="text-muted">No logo uploaded</span>
            }
        </dd>
    </dl>
</div>

<br />
<br />