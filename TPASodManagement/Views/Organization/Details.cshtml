@model TpaSodManagement.Models.Db.Organization

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Organization</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrganizationName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizationName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrganizationType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizationType)
        </dd>

        <dt class="col-sm-2">
            Logo
        </dt>
        <dd class="col-sm-10">
            @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
            {
                <img src="@Url.Action("GetLogo", "Organization", new { id = Model.OrganizationId })"
                     alt="Organization Logo"
                     style="max-width:150px; max-height:150px; border:1px solid #ccc; border-radius:5px;" />
            }
            else
            {
                <span class="text-muted">No logo uploaded</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.OrganizationId" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>