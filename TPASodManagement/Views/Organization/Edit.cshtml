@model TpaSodManagement.Models.Db.Organization

@{
    ViewData["Title"] = "Edit";
}

<br />
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Edit</h1>
</div>

<h4>Organization</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OrganizationId" />

            <div class="form-group mb-3">
                <label asp-for="OrganizationName" class="control-label">Organization Name</label>
                <input asp-for="OrganizationName" class="form-control" />
                <span asp-validation-for="OrganizationName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OrganizationType" class="control-label">Organization Type</label>
                <input asp-for="OrganizationType" class="form-control" />
                <span asp-validation-for="OrganizationType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LogoFile" class="control-label">Logo</label>

                <div id="logoPreview" class="mb-2">
                    @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
                    {
                        <img id="currentLogo" src="@Url.Action("GetLogo", "Organization", new { id = Model.OrganizationId })"
                             alt="Current Logo"
                             style="max-width:150px; max-height:150px; border:1px solid #ccc; border-radius:5px;" />
                    }
                    else
                    {
                        <span class="text-muted" id="noLogoText">No logo uploaded</span>
                    }
                </div>

                <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" onchange="previewLogo(event)" />
                <span asp-validation-for="LogoFile" class="text-danger"></span>
                <small class="form-text text-muted">Leave empty to keep current logo</small>
            </div>

            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-danger ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
<br/>
<br/>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewLogo(event) {
            const fileInput = event.target;
            const previewContainer = document.getElementById('logoPreview');
            const noLogoText = document.getElementById('noLogoText');
            const currentLogo = document.getElementById('currentLogo');

            if (currentLogo) currentLogo.remove();
            if (noLogoText) noLogoText.remove();

            const file = fileInput.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.alt = "New Logo";
                    img.style.maxWidth = "150px";
                    img.style.maxHeight = "150px";
                    img.style.border = "1px solid #ccc";
                    img.style.borderRadius = "5px";
                    previewContainer.innerHTML = '';
                    previewContainer.appendChild(img);
                };
                reader.readAsDataURL(file);
            } else {
                // If no file selected, show the current logo again or "no logo" message
                @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
                {
                        <text>
                        const img = document.createElement('img');
                        img.src = '@Url.Action("GetLogo", "Organization", new { id = Model.OrganizationId })';
                        img.alt = "Current Logo";
                        img.style.maxWidth = "150px";
                        img.style.maxHeight = "150px";
                        img.style.border = "1px solid #ccc";
                        img.style.borderRadius = "5px";
                        img.id = "currentLogo";
                        previewContainer.innerHTML = '';
                        previewContainer.appendChild(img);
                        </text>
                }
                else
                {
                        <text>
                        const span = document.createElement('span');
                        span.className = 'text-muted';
                        span.id = 'noLogoText';
                        span.textContent = 'No logo uploaded';
                        previewContainer.innerHTML = '';
                        previewContainer.appendChild(span);
                        </text>
                }
            }
        }
    </script>
}