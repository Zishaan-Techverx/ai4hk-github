@model TpaSodManagement.ViewModels.Organization.OrganizationEditViewModel

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? false;
    ViewData["Title"] = isDetailsView ? "Organization Details" : "Edit Organization";
    string disabledAttr = isDetailsView ? "disabled" : null;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@(isDetailsView ? "Organization Details" : "Edit Organization")</h5>
                </div>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="OrganizationId" />
                        <input type="hidden" asp-for="AddressId" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="OrganizationName" class="form-label">Organization Name <span class="text-danger">*</span></label>
                                <input asp-for="OrganizationName" class="form-control" disabled="@disabledAttr" required />
                                <span asp-validation-for="OrganizationName" class="text-danger"></span>
                            </div>
                        </div>

                        @if (isDetailsView && ViewBag.AddressFormatted != null && !string.IsNullOrWhiteSpace(ViewBag.AddressFormatted as string))
                        {
                            <div class="mb-3">
                                <label class="form-label">Address</label>
                                <p class="form-control-plaintext">@ViewBag.AddressFormatted</p>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizationCode" class="form-label">Organization Code</label>
                                <input asp-for="OrganizationCode" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="OrganizationCode" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TaxIdentificationNumber" class="form-label">Tax Identification Number</label>
                                <input asp-for="TaxIdentificationNumber" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="TaxIdentificationNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="RegistrationNumber" class="form-label">Registration Number</label>
                                <input asp-for="RegistrationNumber" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EstablishedDate" class="form-label">Established Date</label>
                                <input asp-for="EstablishedDate" type="date" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="EstablishedDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" rows="3" class="form-control" disabled="@disabledAttr"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LogoFile" class="form-label">Logo</label>
                            
                            <div id="logoPreview" class="mb-2">
                                @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
                                {
                                    <img id="currentLogo" src="@Url.Action("GetLogo", "Organization", new { id = Model.OrganizationId })"
                                         alt="Current Logo"
                                         style="max-width:150px; max-height:150px; border:1px solid #ccc; border-radius:5px;" />
                                }
                                else
                                {
                                    <span class="text-muted" id="noLogoText">No logo uploaded</span>
                                }
                            </div>

                            @if (!isDetailsView)
                            {
                                <input asp-for="LogoFile" type="file" class="form-control" id="logoFileInput" accept=".jpg,.jpeg,.png,.svg" onchange="validateAndPreviewLogo(event)" />
                                <span asp-validation-for="LogoFile" class="text-danger"></span>
                                <span id="logoFileError" class="text-danger" style="display:none;"></span>
                                <small class="form-text text-muted">Allowed: .jpg, .jpeg, .png, .svg. Max size: 2MB. Leave empty to keep current logo.</small>
                            }
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" disabled="@disabledAttr" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">@(isDetailsView ? "Back" : "Cancel")</a>

                            @if (!isDetailsView)
                            {
                                <button type="submit" class="btn btn-primary">@(isDetailsView ? "Save Changes" : "Save")</button>
                            }
                            else
                            {
                                @if (User.HasPermission("Organization.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.OrganizationId" class="btn btn-warning">Edit</a>
                                }
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isDetailsView)
    {
        <partial name="_ValidationScriptsPartial" />
        
        <script>
            const ALLOWED_LOGO_EXTENSIONS = ['.jpg', '.jpeg', '.png', '.svg'];
            const LOGO_MAX_BYTES = 2 * 1024 * 1024; // 2MB

            function getExtension(filename) {
                if (!filename) return '';
                var i = filename.lastIndexOf('.');
                return i >= 0 ? filename.substring(i).toLowerCase() : '';
            }

            function validateLogoFile(file, errorSpanId) {
                var errorSpan = document.getElementById(errorSpanId || 'logoFileError');
                if (!errorSpan) return true;
                errorSpan.style.display = 'none';
                errorSpan.textContent = '';
                if (!file) return true;
                var ext = getExtension(file.name);
                if (ALLOWED_LOGO_EXTENSIONS.indexOf(ext) === -1) {
                    errorSpan.textContent = 'Logo must be one of: .jpg, .jpeg, .png, .svg';
                    errorSpan.style.display = 'block';
                    return false;
                }
                if (file.size > LOGO_MAX_BYTES) {
                    errorSpan.textContent = 'Logo size must not exceed 2MB.';
                    errorSpan.style.display = 'block';
                    return false;
                }
                return true;
            }

            function validateAndPreviewLogo(event) {
                var fileInput = event.target;
                var file = fileInput.files[0];
                var previewContainer = document.getElementById('logoPreview');
                var noLogoText = document.getElementById('noLogoText');
                var currentLogo = document.getElementById('currentLogo');
                var errorSpan = document.getElementById('logoFileError');
                if (errorSpan) { errorSpan.style.display = 'none'; errorSpan.textContent = ''; }
                if (currentLogo) currentLogo.remove();
                if (noLogoText) noLogoText.remove();

                if (!file) {
                    @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
                    {
                        <text>
                        var img = document.createElement('img');
                        img.src = '@Url.Action("GetLogo", "Organization", new { id = Model.OrganizationId })';
                        img.alt = "Current Logo";
                        img.style.maxWidth = "150px";
                        img.style.maxHeight = "150px";
                        img.style.border = "1px solid #ccc";
                        img.style.borderRadius = "5px";
                        img.id = "currentLogo";
                        previewContainer.innerHTML = '';
                        previewContainer.appendChild(img);
                        </text>
                    }
                    else
                    {
                        <text>
                        var span = document.createElement('span');
                        span.className = 'text-muted';
                        span.id = 'noLogoText';
                        span.textContent = 'No logo uploaded';
                        previewContainer.innerHTML = '';
                        previewContainer.appendChild(span);
                        </text>
                    }
                    return;
                }
                if (!validateLogoFile(file, 'logoFileError')) {
                    fileInput.value = '';
                    @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
                    {
                        <text>
                        var img = document.createElement('img');
                        img.src = '@Url.Action("GetLogo", "Organization", new { id = Model.OrganizationId })';
                        img.alt = "Current Logo";
                        img.style.maxWidth = "150px";
                        img.style.maxHeight = "150px";
                        img.style.border = "1px solid #ccc";
                        img.style.borderRadius = "5px";
                        img.id = "currentLogo";
                        previewContainer.innerHTML = '';
                        previewContainer.appendChild(img);
                        </text>
                    }
                    else
                    {
                        <text>
                        var span = document.createElement('span');
                        span.className = 'text-muted';
                        span.id = 'noLogoText';
                        span.textContent = 'No logo uploaded';
                        previewContainer.innerHTML = '';
                        previewContainer.appendChild(span);
                        </text>
                    }
                    return;
                }
                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = document.createElement('img');
                    img.src = e.target.result;
                    img.alt = "New Logo";
                    img.style.maxWidth = "150px";
                    img.style.maxHeight = "150px";
                    img.style.border = "1px solid #ccc";
                    img.style.borderRadius = "5px";
                    previewContainer.innerHTML = '';
                    previewContainer.appendChild(img);
                };
                reader.readAsDataURL(file);
            }

            document.addEventListener('DOMContentLoaded', function () {
                var form = document.querySelector('form');
                if (form) {
                    form.addEventListener('submit', function (e) {
                        var logoInput = document.getElementById('logoFileInput');
                        if (logoInput && logoInput.files && logoInput.files.length > 0) {
                            if (!validateLogoFile(logoInput.files[0], 'logoFileError')) {
                                e.preventDefault();
                                return false;
                            }
                        }
                    });
                }
            });
        </script>
    }
}