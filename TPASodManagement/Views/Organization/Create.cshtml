@model TpaSodManagement.ViewModels.Organization.OrganizationEditViewModel

@{
    ViewData["Title"] = "Create Organization";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Create Organization</h5>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizationName" class="form-label">Organization Name <span class="text-danger">*</span></label>
                                <input asp-for="OrganizationName" class="form-control" placeholder="Enter organization name" required />
                                <span asp-validation-for="OrganizationName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizationTypeId" class="form-label">Organization Type <span class="text-danger">*</span></label>
                                <select asp-for="OrganizationTypeId" class="form-select" asp-items="ViewBag.OrganizationTypes" required>
                                    <option value="">-- Select Organization Type --</option>
                                </select>
                                <span asp-validation-for="OrganizationTypeId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-block mb-2">Organization Logo</label>
                            <img id="logoPreview" src="#" alt="Logo Preview"
                                 style="display:none; max-width:150px; max-height:150px; border:1px solid #ccc; border-radius:8px; margin-bottom:10px;" />
                            <input type="file" asp-for="LogoFile" class="form-control" id="logoFileInput"
                                   accept=".jpg,.jpeg,.png,.svg"
                                   data-max-bytes="2097152"
                                   onchange="validateAndPreviewLogo(event)" />
                            <span asp-validation-for="LogoFile" class="text-danger"></span>
                            <span id="logoFileError" class="text-danger" style="display:none;"></span>
                            <small class="form-text text-muted d-block mt-1">Allowed: .jpg, .jpeg, .png, .svg. Max size: 2MB.</small>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" checked />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        const ALLOWED_LOGO_EXTENSIONS = ['.jpg', '.jpeg', '.png', '.svg'];
        const LOGO_MAX_BYTES = 2 * 1024 * 1024; // 2MB

        function getExtension(filename) {
            if (!filename) return '';
            const i = filename.lastIndexOf('.');
            return i >= 0 ? filename.substring(i).toLowerCase() : '';
        }

        function validateLogoFile(file, errorSpanId) {
            const errorSpan = document.getElementById(errorSpanId || 'logoFileError');
            if (!errorSpan) return true;
            errorSpan.style.display = 'none';
            errorSpan.textContent = '';
            if (!file) return true;
            const ext = getExtension(file.name);
            if (!ALLOWED_LOGO_EXTENSIONS.includes(ext)) {
                errorSpan.textContent = 'Logo must be one of: .jpg, .jpeg, .png, .svg';
                errorSpan.style.display = 'block';
                return false;
            }
            if (file.size > LOGO_MAX_BYTES) {
                errorSpan.textContent = 'Logo size must not exceed 2MB.';
                errorSpan.style.display = 'block';
                return false;
            }
            return true;
        }

        function validateAndPreviewLogo(event) {
            const fileInput = event.target;
            const file = fileInput.files[0];
            const preview = document.getElementById('logoPreview');
            const errorSpan = document.getElementById('logoFileError');
            if (errorSpan) { errorSpan.style.display = 'none'; errorSpan.textContent = ''; }
            if (!file) {
                preview.src = '#';
                preview.style.display = 'none';
                return;
            }
            if (!validateLogoFile(file, 'logoFileError')) {
                fileInput.value = '';
                preview.src = '#';
                preview.style.display = 'none';
                return;
            }
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var form = document.querySelector('form[asp-action="Create"]') || document.querySelector('form[action*="/Organization/Create"]');
            if (!form) form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var logoInput = document.getElementById('logoFileInput');
                    if (logoInput && logoInput.files && logoInput.files.length > 0) {
                        if (!validateLogoFile(logoInput.files[0], 'logoFileError')) {
                            e.preventDefault();
                            return false;
                        }
                    }
                });
            }
        });
    </script>
}
