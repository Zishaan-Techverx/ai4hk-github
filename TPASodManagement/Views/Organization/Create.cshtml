@model TpaSodManagement.Models.Db.Organization

@{
    ViewData["Title"] = "Create Organization";
}

<br />

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Create</h1>
</div>

<h4>Organization</h4>
<hr />
<br />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="OrganizationName" class="control-label">Organization Name</label>
                <input asp-for="OrganizationName" class="form-control" placeholder="Enter organization name" />
                <span asp-validation-for="OrganizationName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OrganizationType" class="control-label">Organization Type</label>
                <input asp-for="OrganizationType" class="form-control" placeholder="Enter organization type" />
                <span asp-validation-for="OrganizationType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label d-block mb-2">Organization Logo</label>

                <img id="logoPreview" src="#" alt="Logo Preview"
                     style="display:none; max-width:150px; max-height:150px; border:1px solid #ccc; border-radius:8px; margin-bottom:10px;" />

                <input type="file" asp-for="LogoFile" class="form-control" accept="image/*" onchange="previewLogo(event)" />
                <span asp-validation-for="LogoFile" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


<br />
<br />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewLogo(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('logoPreview');
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = '#';
                preview.style.display = 'none';
            }
        }
    </script>
}
