@model TpaSodManagement.ViewModels.Seeding.SeedingEditViewModel

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? Model.IsDetailsView;
    ViewData["Title"] = isDetailsView ? "Seeding Details" : "Edit Seeding";
    string disabledAttr = isDetailsView ? "disabled" : null;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@(isDetailsView ? "Seeding Details" : "Edit Seeding")</h5>
                </div>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="SeedingId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserId" class="form-label">User <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select" asp-items="Model.Users" disabled="@disabledAttr" required>
                                    <option value="">-- Select User --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmId" class="form-label">Farm <span class="text-danger">*</span></label>
                                <select asp-for="FarmId" class="form-select" asp-items="Model.Farms" disabled="@disabledAttr" required>
                                    <option value="">-- Select Farm --</option>
                                </select>
                                <span asp-validation-for="FarmId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FieldId" class="form-label">Field</label>
                                <select asp-for="FieldId" class="form-select" asp-items="Model.Fields" disabled="@disabledAttr">
                                    <option value="">-- Select Field (Optional) --</option>
                                </select>
                                <span asp-validation-for="FieldId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TagRangeId" class="form-label">Tag Range <span class="text-danger">*</span></label>
                                <select asp-for="TagRangeId" class="form-select" asp-items="Model.TagRanges" disabled="@disabledAttr" required>
                                    <option value="">-- Select Tag Range --</option>
                                </select>
                                <span asp-validation-for="TagRangeId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SeedingDate" class="form-label">Seeding Date <span class="text-danger">*</span></label>
                                <input asp-for="SeedingDate" type="date" class="form-control" disabled="@disabledAttr" required />
                                <span asp-validation-for="SeedingDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AreaTypeId" class="form-label">Area Type <span class="text-danger">*</span></label>
                                <select asp-for="AreaTypeId" class="form-select" asp-items="Model.AreaTypes" disabled="@disabledAttr" required>
                                    <option value="">-- Select Area Type --</option>
                                </select>
                                <span asp-validation-for="AreaTypeId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AreaAmount" class="form-label">Area Amount</label>
                                <input asp-for="AreaAmount" type="number" step="0.01" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="AreaAmount" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SeedingMethod" class="form-label">Seeding Method</label>
                                <input asp-for="SeedingMethod" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="SeedingMethod" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SeedRatePerUnit" class="form-label">Seed Rate Per Unit</label>
                                <input asp-for="SeedRatePerUnit" type="number" step="0.01" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="SeedRatePerUnit" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="SoilTemperature" class="form-label">Soil Temperature</label>
                                <input asp-for="SoilTemperature" type="number" step="0.01" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="SoilTemperature" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="SoilMoisture" class="form-label">Soil Moisture</label>
                                <input asp-for="SoilMoisture" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="SoilMoisture" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="WeatherConditions" class="form-label">Weather Conditions</label>
                            <input asp-for="WeatherConditions" class="form-control" disabled="@disabledAttr" />
                            <span asp-validation-for="WeatherConditions" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" rows="3" class="form-control" disabled="@disabledAttr"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" disabled="@disabledAttr" />
                            </div>
                        </div>

                        @if (isDetailsView)
                        {
                            <div class="mb-3">
                                <label asp-for="CreatedDate" class="form-label">Created Date</label>
                                <input type="text" class="form-control" value="@(Model.CreatedDate?.ToString("MM/dd/yyyy"))" readonly />
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="CreatedDate" />
                        }

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">@(isDetailsView ? "Back" : "Cancel")</a>

                            @if (!isDetailsView)
                            {
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            }
                            else
                            {
                                @if (User.HasPermission("Seeding.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.SeedingId" class="btn btn-warning">Edit</a>
                                }
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isDetailsView)
    {
        <partial name="_ValidationScriptsPartial" />
    }
}
