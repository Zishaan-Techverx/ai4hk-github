@model TpaSodManagement.Models.Db.Seeding

@{
    ViewData["Title"] = "Details";
}
<br />
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Details</h1>
</div>

<div>
    <h4>Seeding</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Area Amount
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AreaAmount)
        </dd>
        <dt class = "col-sm-2">
            Seeding Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SeedingDate)
        </dd>
        <dt class = "col-sm-2">
            Seeding Method
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SeedingMethod)
        </dd>
        <dt class = "col-sm-2">
            SeedRate Per Unit
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SeedRatePerUnit)
        </dd>
        <dt class = "col-sm-2">
            Weather Conditions
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.WeatherConditions)
        </dd>
        <dt class = "col-sm-2">
            Soil Temperature
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoilTemperature)
        </dd>
        <dt class = "col-sm-2">
            Soil Moisture
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoilMoisture)
        </dd>
        <dt class = "col-sm-2">
            Notes
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
        <dt class = "col-sm-2">
            Created Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class = "col-sm-2">
            Area Type
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AreaType.AreaTypeId)
        </dd>
        <dt class = "col-sm-2">
            Farm
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Farm.FarmId)
        </dd>
        <dt class = "col-sm-2">
            Field
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Field.FieldId)
        </dd>
        <dt class = "col-sm-2">
            TagRange
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TagRange.TagRangeId)
        </dd>
        <dt class = "col-sm-2">
            User
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.User.UserId)
        </dd>
    </dl>
</div>

<br />
<br />
