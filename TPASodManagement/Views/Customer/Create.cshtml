@model TpaSodManagement.ViewModels.Customer.CustomerEditViewModel

@{
    ViewData["Title"] = "Create Customer";
}

<style>
    .person-field-wrapper { display: flex; gap: 0.5rem; align-items: stretch; flex-wrap: wrap; }
    .person-field-wrapper .select2-container { flex: 1 1 auto; min-width: 120px; }
    .person-field-wrapper .select2-container .selection .select2-selection {
        height: 100%; min-height: 38px; border-radius: var(--bs-border-radius);
    }
    .person-field-wrapper .btn-create-new-person { border-radius: var(--bs-border-radius); }
</style>

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Create Customer</h5>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        @if (ViewBag.ReturnUrl != null)
                        {
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerTypeId" class="form-label">Customer Type <span class="text-danger">*</span></label>
                                <select asp-for="CustomerTypeId" class="form-select" asp-items="Model.CustomerTypes" required>
                                    <option value="">-- Select Customer Type --</option>
                                </select>
                                <span asp-validation-for="CustomerTypeId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerCode" class="form-label">Customer Code</label>
                                <input asp-for="CustomerCode" class="form-control" />
                                <span asp-validation-for="CustomerCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Person</label>
                                <input type="hidden" asp-for="CreateNewPerson" id="CreateNewPerson" value="@(Model?.CreateNewPerson == true ? "true" : "false")" />
                                <div id="personDropdownSection">
                                    <div class="person-field-wrapper">
                                        <div class="flex-grow-1" style="min-width: 0;">
                                            <select asp-for="PersonId" class="form-select rounded" id="PersonId" asp-items="Model.People">
                                                <option value="">-- Select Person --</option>
                                            </select>
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-create-new-person flex-shrink-0 d-flex align-items-center gap-1" id="btnCreateNewPerson" title="Create new person">
                                            <i class="fa fa-plus small"></i>
                                            <span>Create New</span>
                                        </button>
                                    </div>
                                    <span asp-validation-for="PersonId" class="text-danger" id="personIdValidation"></span>
                                </div>
                                <div id="personNewFieldsSection" class="person-new-fields mt-2" style="display: none;">
                                    <div class="mb-2">
                                        <label for="NewPersonFirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="NewPersonFirstName" name="NewPersonFirstName" maxlength="200" value="@Model?.NewPersonFirstName" />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="NewPersonFirstName" data-valmsg-replace="true"></span>
                                    </div>
                                    <div class="mb-2">
                                        <label for="NewPersonLastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="NewPersonLastName" name="NewPersonLastName" maxlength="200" value="@Model?.NewPersonLastName" />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="NewPersonLastName" data-valmsg-replace="true"></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCancelNewPerson">
                                        <i class="fa fa-arrow-left small me-1"></i>Use existing person
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmId" class="form-label">Farm</label>
                                <select asp-for="FarmId" class="form-select" asp-items="Model.Farms">
                                    <option value="">-- Select Farm --</option>
                                </select>
                                <span asp-validation-for="FarmId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreditLimit" class="form-label">Credit Limit</label>
                                <input asp-for="CreditLimit" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="CreditLimit" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PaymentTermsDays" class="form-label">Payment Terms Days</label>
                                <input asp-for="PaymentTermsDays" type="number" class="form-control" />
                                <span asp-validation-for="PaymentTermsDays" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Tax Exempt</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="TaxExempt" type="checkbox" class="form-check-input" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" checked />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a href="@(ViewBag.ReturnUrl != null && Url.IsLocalUrl(ViewBag.ReturnUrl as string) ? ViewBag.ReturnUrl : Url.Action("Index"))" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        (function () {
            var createNewPerson = document.getElementById('CreateNewPerson');
            var personId = document.getElementById('PersonId');
            var personDropdownSection = document.getElementById('personDropdownSection');
            var personNewFieldsSection = document.getElementById('personNewFieldsSection');
            var btnCreateNewPerson = document.getElementById('btnCreateNewPerson');
            var btnCancelNewPerson = document.getElementById('btnCancelNewPerson');
            var newFirstName = document.getElementById('NewPersonFirstName');
            var newLastName = document.getElementById('NewPersonLastName');
            var personIdValidation = document.getElementById('personIdValidation');
            var form = document.querySelector('form');

            function initPersonSelect2() {
                if (typeof $ !== 'undefined' && $.fn.select2 && personId && !personId.disabled) {
                    $(personId).select2({ theme: 'bootstrap-5', width: '100%' });
                }
            }

            function showCreateNewPersonMode() {
                if (typeof $ !== 'undefined' && $(personId).data('select2')) {
                    $(personId).val('').trigger('change');
                    $(personId).prop('disabled', true).trigger('change.select2');
                }
                createNewPerson.value = 'true';
                personId.disabled = true;
                personId.removeAttribute('data-val');
                personId.value = '';
                personDropdownSection.style.display = 'none';
                personNewFieldsSection.style.display = 'block';
                newFirstName.setAttribute('required', 'required');
                newLastName.setAttribute('required', 'required');
                newFirstName.setAttribute('data-val', 'true');
                newLastName.setAttribute('data-val', 'true');
                if (personIdValidation) personIdValidation.textContent = '';
            }

            function showDropdownMode() {
                createNewPerson.value = 'false';
                personId.disabled = false;
                personId.setAttribute('data-val', 'true');
                personDropdownSection.style.display = 'block';
                personNewFieldsSection.style.display = 'none';
                newFirstName.removeAttribute('required');
                newLastName.removeAttribute('required');
                newFirstName.removeAttribute('data-val');
                newLastName.removeAttribute('data-val');
                newFirstName.value = '';
                newLastName.value = '';
                if (typeof $ !== 'undefined' && $(personId).data('select2')) {
                    $(personId).prop('disabled', false).trigger('change.select2');
                }
            }

            if (btnCreateNewPerson) {
                btnCreateNewPerson.addEventListener('click', function () {
                    showCreateNewPersonMode();
                });
            }
            if (btnCancelNewPerson) {
                btnCancelNewPerson.addEventListener('click', function () {
                    showDropdownMode();
                });
            }

            if (form) {
                form.addEventListener('submit', function () {
                    if (createNewPerson.value === 'true') {
                        personId.disabled = false;
                        personId.removeAttribute('name');
                    }
                });
            }

            if (personId && !personId.disabled) {
                initPersonSelect2();
            }

            // Restore "create new person" mode when returning with validation errors
            if (createNewPerson && createNewPerson.value === 'true') {
                showCreateNewPersonMode();
            }
        })();
    </script>
}
