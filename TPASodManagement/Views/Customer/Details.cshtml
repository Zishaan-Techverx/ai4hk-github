@model TpaSodManagement.Models.Db.Customer

@{
    ViewData["Title"] = "Details";
}
<br />

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Details</h1>
</div>

<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Customer Type
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CustomerType)
        </dd>
        <dt class = "col-sm-2">
            Customer Code
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CustomerCode)
        </dd>
        <dt class = "col-sm-2">
            Credit Limit
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreditLimit)
        </dd>
        <dt class = "col-sm-2">
            Payment Terms Days
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentTermsDays)
        </dd>
        <dt class = "col-sm-2">
            TaxExempt
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TaxExempt)
        </dd>
        <dt class = "col-sm-2">
            Notes
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
        <dt class = "col-sm-2">
            IsActive
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            Created Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class = "col-sm-2">
            Updated Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UpdatedDate)
        </dd>
        <dt class = "col-sm-2">
            Organization
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Organization.OrganizationId)
        </dd>
        <dt class = "col-sm-2">
            Person
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Person.PersonId)
        </dd>
    </dl>
</div>

<br />
<br />
