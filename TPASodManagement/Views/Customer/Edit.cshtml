@model TpaSodManagement.Models.Db.Customer

@{
    ViewData["Title"] = "Edit";
}
<br />

<h1></h1>
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Edit</h1>
</div>

<h4>Customer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CustomerId" />
            <div class="form-group">
                <label asp-for="CustomerType" class="control-label">Customer Type</label>
                <input asp-for="CustomerType" class="form-control" />
                <span asp-validation-for="CustomerType" class="text-danger"></span>
            </div>
            <br/>
            <div class="form-group">
                <label asp-for="PersonId" class="control-label">Person Id</label>
                <select asp-for="PersonId" class="form-control" asp-items="ViewBag.PersonId"></select>
                <span asp-validation-for="PersonId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="OrganizationId" class="control-label">Organization Id</label>
                <select asp-for="OrganizationId" class="form-control" asp-items="ViewBag.OrganizationId"></select>
                <span asp-validation-for="OrganizationId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="CustomerCode" class="control-label">Customer Code</label>
                <input asp-for="CustomerCode" class="form-control" />
                <span asp-validation-for="CustomerCode" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="CreditLimit" class="control-label">Credit Limit</label>
                <input asp-for="CreditLimit" class="form-control" />
                <span asp-validation-for="CreditLimit" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="PaymentTermsDays" class="control-label">Payment Terms Days</label>
                <input asp-for="PaymentTermsDays" class="form-control" />
                <span asp-validation-for="PaymentTermsDays" class="text-danger"></span>
            </div>
            
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="TaxExempt" /> Tax Exempt
                </label>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Notes" class="control-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> IsActive
                </label>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="CreatedDate" class="control-label">Created Date</label>
                <input asp-for="CreatedDate" class="form-control" />
                <span asp-validation-for="CreatedDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="UpdatedDate" class="control-label">Updated Date</label>
                <input asp-for="UpdatedDate" class="form-control" />
                <span asp-validation-for="UpdatedDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-danger ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>


<br />
<br />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
