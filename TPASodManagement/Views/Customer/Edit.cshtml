@model TpaSodManagement.Models.Db.Customer

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? false;
    ViewData["Title"] = isDetailsView ? "Customer Details" : "Edit Customer";
    string disabledAttr = isDetailsView ? "disabled" : null;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@(isDetailsView ? "Customer Details" : "Edit Customer")</h5>
                </div>

                <div class="card-body"> 
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="CustomerId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerType" class="form-label">Customer Type</label>
                                <input asp-for="CustomerType" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="CustomerType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerCode" class="form-label">Customer Code</label>
                                <input asp-for="CustomerCode" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="CustomerCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PersonId" class="form-label">Person</label>
                                <select asp-for="PersonId" class="form-select" asp-items="ViewBag.PersonId" disabled="@disabledAttr">
                                    <option value="">-- Select Person --</option>
                                </select>
                                <span asp-validation-for="PersonId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizationId" class="form-label">Organization</label>
                                <select asp-for="OrganizationId" class="form-select" asp-items="ViewBag.OrganizationId" disabled="@disabledAttr">
                                    <option value="">-- Select Organization --</option>
                                </select>
                                <span asp-validation-for="OrganizationId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreditLimit" class="form-label">Credit Limit</label>
                                <input asp-for="CreditLimit" type="number" step="0.01" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="CreditLimit" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PaymentTermsDays" class="form-label">Payment Terms Days</label>
                                <input asp-for="PaymentTermsDays" type="number" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="PaymentTermsDays" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label me-3 mb-0">Tax Exempt</label>
                            <div class="form-check form-switch d-inline-block">
                                <input asp-for="TaxExempt" type="checkbox" class="form-check-input" disabled="@disabledAttr" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" rows="3" class="form-control" disabled="@disabledAttr"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label me-3 mb-0">Is Active</label>
                            <div class="form-check form-switch d-inline-block">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" disabled="@disabledAttr" />
                            </div>
                        </div>

                        @if (isDetailsView)
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CreatedDate" class="form-label">Created Date</label>
                                    <input asp-for="CreatedDate" type="text" class="form-control" readonly />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="UpdatedDate" class="form-label">Updated Date</label>
                                    <input asp-for="UpdatedDate" type="text" class="form-control" readonly />
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">@(isDetailsView ? "Back" : "Cancel")</a>

                            @if (!isDetailsView)
                            {
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            }
                            else
                            {
                                @if (User.HasPermission("Customer.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-warning">Edit</a>
                                }
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isDetailsView)
    {
        <partial name="_ValidationScriptsPartial" />
    }
}
