@model TpaSodManagement.ViewModels.TagRange.TagRangeEditViewModel

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? false;
    ViewData["Title"] = isDetailsView ? "Tag Range Details" : "Edit Tag Range";
    string disabledAttr = isDetailsView ? "disabled" : null;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@(isDetailsView ? "Tag Range Details" : "Edit Tag Range")</h5>
                </div>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TagRangeId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TagRangeCode" class="form-label">Tag Range Code <span class="text-danger">*</span></label>
                                <input asp-for="TagRangeCode" class="form-control" disabled="@disabledAttr" required />
                                <span asp-validation-for="TagRangeCode" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TagStartNumber" class="form-label">Tag Start Number <span class="text-danger">*</span></label>
                                <input asp-for="TagStartNumber" type="number" class="form-control" min="0" disabled="@disabledAttr" required />
                                <span asp-validation-for="TagStartNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TagEndNumber" class="form-label">Tag End Number <span class="text-danger">*</span></label>
                                <input asp-for="TagEndNumber" type="number" class="form-control" min="0" disabled="@disabledAttr" required />
                                <span asp-validation-for="TagEndNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmId" class="form-label">Farm <span class="text-danger">*</span></label>
                                <select asp-for="FarmId" asp-items="Model.Farms" class="form-select" disabled="@disabledAttr" required>
                                    <option value="">-- Select Farm --</option>
                                </select>
                                <span asp-validation-for="FarmId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SeedType" class="form-label">Type of Seed <span class="text-danger">*</span></label>
                                <select asp-for="SeedType" asp-items="Model.SeedTypes" class="form-select" disabled="@disabledAttr" required>
                                    <option value="">-- Select Seed Type --</option>
                                </select>
                                <span asp-validation-for="SeedType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TotalTags" class="form-label">Total Tags</label>
                                <input asp-for="TotalTags" type="number" class="form-control" readonly disabled="@disabledAttr" />
                            </div>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" disabled="@disabledAttr" />
                            </div>
                        </div>

                        @if (isDetailsView)
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CreatedDate" class="form-label">Created Date</label>
                                    <input asp-for="CreatedDate" type="text" class="form-control" readonly />
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="CreatedDate" />
                        }

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">@(isDetailsView ? "Back" : "Cancel")</a>

                            @if (!isDetailsView)
                            {
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            }
                            else
                            {
                                @if (User.HasPermission("TagRange.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.TagRangeId" class="btn btn-warning">Edit</a>
                                }
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isDetailsView)
    {
        <partial name="_ValidationScriptsPartial" />
    }
}
