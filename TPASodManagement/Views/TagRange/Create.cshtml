@model TpaSodManagement.ViewModels.TagRange.TagRangeEditViewModel

@{
    ViewData["Title"] = "Create Tag Range";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Create Tag Range</h5>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TagRangeCode" class="form-label">Tag Range Code <span class="text-danger">*</span></label>
                                <input asp-for="TagRangeCode" class="form-control" placeholder="e.g., RANGE-001" required />
                                <span asp-validation-for="TagRangeCode" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TagStartNumber" class="form-label">Tag Start Number <span class="text-danger">*</span></label>
                                <input asp-for="TagStartNumber" type="number" class="form-control" min="0" required />
                                <span asp-validation-for="TagStartNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TagEndNumber" class="form-label">Tag End Number <span class="text-danger">*</span></label>
                                <input asp-for="TagEndNumber" type="number" class="form-control" min="0" required />
                                <span asp-validation-for="TagEndNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmId" class="form-label">Farm <span class="text-danger">*</span></label>
                                <select asp-for="FarmId" asp-items="Model.Farms" class="form-select" required>
                                    <option value="">-- Select Farm --</option>
                                </select>
                                <span asp-validation-for="FarmId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SeedType" class="form-label">Type of Seed <span class="text-danger">*</span></label>
                                <select asp-for="SeedType" asp-items="Model.SeedTypes" class="form-select" required>
                                    <option value="">-- Select Seed Type --</option>
                                </select>
                                <span asp-validation-for="SeedType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Is Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" checked />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
