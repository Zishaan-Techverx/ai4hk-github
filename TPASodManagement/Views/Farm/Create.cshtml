@model TpaSodManagement.ViewModels.Farm.FarmEditViewModel

@{
    ViewData["Title"] = "Create Farm";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Create Farm</h5>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FarmName" class="form-label">Farm Name <span class="text-danger">*</span></label>
                                <input asp-for="FarmName" class="form-control" required />
                                <span asp-validation-for="FarmName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizationId" class="form-label">Organization <span class="text-danger">*</span></label>
                                <select asp-for="OrganizationId" 
                                        class="form-select" 
                                        asp-items="Model.Organizations"
                                        name="OrganizationId"
                                        id="OrganizationId"
                                        required>
                                    <option value="">-- Select Organization --</option>
                                </select>
                                <span asp-validation-for="OrganizationId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TotalArea" class="form-label">Total Area</label>
                                <input asp-for="TotalArea" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="TotalArea" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AreaTypeId" class="form-label">Area Type</label>
                                <select asp-for="AreaTypeId" class="form-select" asp-items="Model.AreaTypes">
                                    <option value="">-- Select Area Type --</option>
                                </select>
                                <span asp-validation-for="AreaTypeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LicenseNumber" class="form-label">License Number</label>
                                <input asp-for="LicenseNumber" class="form-control" />
                                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label me-3 mb-0">Organic Certified</label>
                            <div class="form-check form-switch d-inline-block">
                                <input asp-for="OrganicCertified" type="checkbox" class="form-check-input" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CertificationDetails" class="form-label">Certification Details</label>
                            <textarea asp-for="CertificationDetails" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="CertificationDetails" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Latitude" class="form-label">Latitude</label>
                                <input asp-for="Latitude" type="number" step="0.000001" class="form-control" />
                                <span asp-validation-for="Latitude" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Longitude" class="form-label">Longitude</label>
                                <input asp-for="Longitude" type="number" step="0.000001" class="form-control" />
                                <span asp-validation-for="Longitude" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="ElevationMeters" class="form-label">Elevation Meters</label>
                                <input asp-for="ElevationMeters" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="ElevationMeters" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SoilType" class="form-label">Soil Type</label>
                                <input asp-for="SoilType" class="form-control" />
                                <span asp-validation-for="SoilType" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="IrrigationType" class="form-label">Irrigation Type</label>
                                <input asp-for="IrrigationType" class="form-control" />
                                <span asp-validation-for="IrrigationType" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="ClimateZone" class="form-label">Climate Zone</label>
                                <input asp-for="ClimateZone" class="form-control" />
                                <span asp-validation-for="ClimateZone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
