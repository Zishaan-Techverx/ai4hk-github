                <label asp-for="ClimateZone" class="control-label"></label>
                <input asp-for="ClimateZone" class="form-control" />
                <span asp-validation-for="ClimateZone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
