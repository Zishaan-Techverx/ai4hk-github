@model TpaSodManagement.ViewModels.Farm.FarmEditViewModel

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? false;
    ViewData["Title"] = isDetailsView ? "Farm Details" : "Edit Farm";
    string disabledAttr = isDetailsView ? "disabled" : null;
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@(isDetailsView ? "Farm Details" : "Edit Farm")</h5>
                </div>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="FarmId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizationId" class="form-label">Organization</label>
                                <select asp-for="OrganizationId" class="form-select" asp-items="Model.Organizations" disabled="@disabledAttr">
                                    <option value="">-- Select Organization --</option>
                                </select>
                                @* Hidden field sirf Details view mein rakhein, Edit view mein bilkul nahi *@
                                @if (isDetailsView)
                                {
                                    <input type="hidden" asp-for="OrganizationId" />
                                }
                                <span asp-validation-for="OrganizationId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TotalArea" class="form-label">Total Area</label>
                                <input asp-for="TotalArea" type="number" step="0.01" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="TotalArea" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AreaTypeId" class="form-label">Area Type</label>
                                <select asp-for="AreaTypeId" class="form-select" asp-items="Model.AreaTypes" disabled="@disabledAttr">
                                </select>
                                <span asp-validation-for="AreaTypeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LicenseNumber" class="form-label">License Number</label>
                                <input asp-for="LicenseNumber" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label me-3 mb-0">Organic Certified</label>
                            <div class="form-check form-switch d-inline-block">
                                <input asp-for="OrganicCertified" type="checkbox" class="form-check-input" disabled="@disabledAttr" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CertificationDetails" class="form-label">Certification Details</label>
                            <textarea asp-for="CertificationDetails" rows="3" class="form-control" disabled="@disabledAttr"></textarea>
                            <span asp-validation-for="CertificationDetails" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Latitude" class="form-label">Latitude</label>
                                <input asp-for="Latitude" type="number" step="0.000001" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="Latitude" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Longitude" class="form-label">Longitude</label>
                                <input asp-for="Longitude" type="number" step="0.000001" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="Longitude" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="ElevationMeters" class="form-label">Elevation Meters</label>
                                <input asp-for="ElevationMeters" type="number" step="0.01" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="ElevationMeters" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SoilType" class="form-label">Soil Type</label>
                                <input asp-for="SoilType" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="SoilType" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="IrrigationType" class="form-label">Irrigation Type</label>
                                <input asp-for="IrrigationType" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="IrrigationType" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="ClimateZone" class="form-label">Climate Zone</label>
                                <input asp-for="ClimateZone" class="form-control" disabled="@disabledAttr" />
                                <span asp-validation-for="ClimateZone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">@(isDetailsView ? "Back" : "Cancel")</a>

                            @if (!isDetailsView)
                            {
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            }
                            else
                            {
                                @if (User.HasPermission("Farm.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.FarmId" class="btn btn-warning">Edit</a>
                                }
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!isDetailsView)
    {
        <partial name="_ValidationScriptsPartial" />
        @* JavaScript remove kar diya - hidden field conflict resolve karne ke baad zarurat nahi *@
    }
}
