@model IEnumerable<TpaSodManagement.ViewModels.Farm.FarmItemViewModel>

@{
    ViewData["Title"] = "Index";

    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
}
<br />
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Farms</h1>
    <div>
        <button type="button" class="btn btn-secondary me-2" id="printBtn">
            <i class="fas fa-download me-1"></i> Export to Excel
        </button>
    @if (User.HasPermission("Farm.Create"))
    {
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    }
</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<br />

@Html.AntiForgeryToken()

<!-- Column Filter and Page Size Controls -->
<div class="row mb-3">
    <div class="col-md-6">
        <label class="form-label">Hide Columns</label>
        <div class="d-flex align-items-center gap-2">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="columnFilterDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" style="min-width: 200px;">
                Show All
            </button>
            <ul class="dropdown-menu" id="columnFilterMenu" aria-labelledby="columnFilterDropdown" style="max-height: 300px; overflow-y: auto;">
                <li>
                    <a class="dropdown-item" href="#" id="showAllOption">
                        <input type="checkbox" id="showAllCheckbox" class="form-check-input me-2" checked>
                        <label class="form-check-label" for="showAllCheckbox" style="cursor: pointer; width: 100%;">Show All</label>
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            </ul>
            </div>
            @await Html.PartialAsync("_FilterPartial", new Dictionary<string, string>())
        </div>
        <div id="hiddenColumnsBadges" class="mt-2 d-flex flex-wrap gap-1"></div>
        <div id="activeFilterTags" class="mt-2 d-flex flex-wrap gap-1"></div>
    </div>
    <div class="col-md-6 text-end">
        <label for="pageSizeSelect" class="form-label">Page Size</label>
        <select id="pageSizeSelect" class="form-select d-inline-block" style="width: auto;"
            onchange="changePageSize(this.value)">
            <option value="10" selected="@(pageSize == 10)">10</option>
            <option value="15" selected="@(pageSize == 15)">15</option>
            <option value="20" selected="@(pageSize == 20)">20</option>
            <option value="25" selected="@(pageSize == 25)">25</option>
            <option value="50" selected="@(pageSize == 50)">50</option>
            <option value="100" selected="@(pageSize == 100)">100</option>
        </select>
    </div>
</div>

<div class="card card-body shadow-sm">
    <div class="table-responsive">
    <table class="table" id="dataTable">
        <thead>
            <tr>
                <th data-column="FarmName">Farm Name</th>
                <th data-column="Address">Address</th>
                <th data-column="AreaType">Area Type</th>
                <th data-column="TotalArea">Total Area</th>
                <th data-column="OrganicCertified">Organic Certified</th>
                <th data-column="LicenseNumber">License Number</th>
                <th data-column="CertificationDetails">Certification Details</th>
                <th data-column="Latitude">Latitude</th>
                <th data-column="Longitude">Longitude</th>
                <th data-column="ElevationMeters">Elevation Meters</th>
                <th data-column="SoilType">Soil Type</th>
                <th data-column="IrrigationType">Irrigation Type</th>
                <th data-column="ClimateZone">Climate Zone</th>
                <th data-column="IsActive">Is Active</th>
                @* <th data-column="Organization">Organization</th> *@
                <th data-column="Actions" class="no-hide-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.FarmId">
                    <td data-column="FarmName">@Html.DisplayFor(modelItem => item.FarmName)</td>
                    <td data-column="Address">@Html.DisplayFor(modelItem => item.Address)</td>
                    <td data-column="AreaType">@(item.AreaTypeName ?? "N/A")</td>
                    <td data-column="TotalArea">@Html.DisplayFor(modelItem => item.TotalArea)</td>
                    <td data-column="OrganicCertified"><input type="checkbox" class="form-check-input" disabled @(item.OrganicCertified ? "checked" : "") style="accent-color: #0d6efd;"></td>
                    <td data-column="LicenseNumber">@Html.DisplayFor(modelItem => item.LicenseNumber)</td>
                    <td data-column="CertificationDetails">@Html.DisplayFor(modelItem => item.CertificationDetails)</td>
                    <td data-column="Latitude">@Html.DisplayFor(modelItem => item.Latitude)</td>
                    <td data-column="Longitude">@Html.DisplayFor(modelItem => item.Longitude)</td>
                    <td data-column="ElevationMeters">@Html.DisplayFor(modelItem => item.ElevationMeters)</td>
                    <td data-column="SoilType">@Html.DisplayFor(modelItem => item.SoilType)</td>
                    <td data-column="IrrigationType">@Html.DisplayFor(modelItem => item.IrrigationType)</td>
                    <td data-column="ClimateZone">@Html.DisplayFor(modelItem => item.ClimateZone)</td>
                    <td data-column="IsActive"><input type="checkbox" class="form-check-input" disabled @(item.IsActive ? "checked" : "") style="accent-color: #0d6efd;"></td>
                    @* <td data-column="Organization">@(item.OrganizationName ?? "N/A")</td> *@
                    <td data-column="Actions">
                        <div class="btn-group btn-group-sm">
                            @if (User.HasPermission("Farm.Detail"))
                        {
                                <a class="btn btn-info" asp-action="Details" asp-route-id="@item.FarmId">
                                    Details
                            </a>
                        }
                            @if (User.HasPermission("Farm.Edit"))
                        {
                                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.FarmId">
                                    Edit
                            </a>
                        }
                        @if (User.HasPermission("Farm.Delete"))
                        {
                                <a href="#" class="btn btn-danger delete-btn" data-id="@item.FarmId" 
                                data-name="@(!string.IsNullOrEmpty(item.FarmName) ? item.FarmName : (!string.IsNullOrEmpty(item.LicenseNumber) ? item.LicenseNumber : $"Farm #{item.FarmId}"))"
                                data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete">
                                    Delete
                            </a>
                        }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

<br />
<nav aria-label="Page navigation" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <ul class="pagination mb-0">
        <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
            <a class="page-link"
                href="@Url.Action("Index", new { pageNumber = pageNumber - 1, pageSize = pageSize })">Previous</a>
        </li>

        @if (totalPages <= 7)
        {
            @* Show all pages if 7 or fewer *@
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = pageSize })">@i</a>
                </li>
            }
        }
        else
        {
            @* Always show first page *@
            <li class="page-item @(pageNumber == 1 ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { pageNumber = 1, pageSize = pageSize })">1</a>
            </li>

            @if (pageNumber <= 4)
            {
                @* Show pages 2, 3, 4 at start *@
                @for (int i = 2; i <= Math.Min(4, totalPages - 1); i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = pageSize })">@i</a>
                    </li>
                }
            }
            else
            {
                @* Ellipsis then middle pages *@
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
                @for (int i = pageNumber - 1; i <= Math.Min(pageNumber + 1, totalPages - 1); i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = pageSize })">@i</a>
                    </li>
                }
            }

            @if (pageNumber < totalPages - 2)
            {
                @* Show ellipsis if current page is far from end *@
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }

            @* Always show last page *@
            <li class="page-item @(pageNumber == totalPages ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { pageNumber = totalPages, pageSize = pageSize })">@totalPages</a>
            </li>
        }

        <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
            <a class="page-link"
                href="@Url.Action("Index", new { pageNumber = pageNumber + 1, pageSize = pageSize })">Next</a>
        </li>
    </ul>
    <div class="d-flex align-items-center gap-1 ms-2">
        <input type="hidden" id="totalPagesHolder" value="@totalPages" />
        <input type="hidden" id="pageSizeHolder" value="@pageSize" />
        <label for="pageGoInput" class="form-label mb-0 small text-nowrap">Go to</label>
        <input type="number" id="pageGoInput" class="form-control form-control-sm" style="width:70px" min="1" max="@totalPages" placeholder="Page" aria-label="Page number" />
        <button type="button" class="btn btn-sm btn-outline-secondary" id="pageGoBtn">Go</button>
    </div>
    <div>@await Html.PartialAsync("_IsActiveTriStatePartial")</div>
</nav>

<div class="text-muted mt-2">
    Showing @((pageNumber - 1) * pageSize + 1) to @Math.Min(pageNumber * pageSize, totalCount) of @totalCount records
</div>

<br />
<br />

<!-- Toast for success message -->
<div aria-live="polite" aria-atomic="true" class="position-relative">
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="deleteSuccessToast" class="toast align-items-center text-white bg-success border-0" role="alert"
            aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    Farm deleted successfully!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                    aria-label="Close"></button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the farm: <strong id="farmNamePlaceholder"></strong>?</p>
                <div class="alert alert-danger d-none" role="alert" id="deleteError">
                    Error deleting the record. Please try again.
                </div>

                <input type="hidden" id="farmIdToDelete" />

                @Html.AntiForgeryToken()
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const moduleName = 'Farm';
        const storageKey = `hiddenColumns_${moduleName}`;
        const table = document.getElementById('dataTable');
        const columnFilterDropdown = document.getElementById('columnFilterDropdown');
        const columnFilterMenu = document.getElementById('columnFilterMenu');
        const showAllOption = document.getElementById('showAllOption');
        const showAllCheckbox = document.getElementById('showAllCheckbox');
        const hiddenColumnsBadges = document.getElementById('hiddenColumnsBadges');
        
        if (!table || !columnFilterMenu) return;
        
        // Get all column headers except Actions
        const headers = table.querySelectorAll('thead th[data-column]:not([data-column="Actions"])');
        const columnMap = new Map(); // Store column name -> display name mapping
        
        // Populate dropdown with checkboxes
        headers.forEach(header => {
            const columnName = header.getAttribute('data-column');
            const displayName = header.textContent.trim();
            columnMap.set(columnName, displayName);
            
            const listItem = document.createElement('li');
            const checkboxId = `colCheckbox_${columnName}`;
            
            listItem.innerHTML = `
                <a class="dropdown-item" href="#" style="pointer-events: none;">
                    <input type="checkbox" id="${checkboxId}" class="form-check-input me-2" data-column="${columnName}" checked style="pointer-events: auto;">
                    <label class="form-check-label" for="${checkboxId}" style="cursor: pointer; width: 100%; pointer-events: auto;">${displayName}</label>
                </a>
            `;
            
            columnFilterMenu.appendChild(listItem);
            
            // Get the checkbox after it's been added to DOM
            const checkbox = document.getElementById(checkboxId);
            
            // Handle checkbox click directly to toggle state
            checkbox.addEventListener('click', function(e) {
                e.stopPropagation(); // Prevent dropdown from closing
                
                const columnName = this.dataset.column;
                const isChecked = this.checked;
                
                // Update hiddenColumns array
                // Checked = visible, Unchecked = hidden
                if (!isChecked) {
                    // Hide the column (unchecked)
                    if (!hiddenColumns.includes(columnName)) {
                        hiddenColumns.push(columnName);
                    }
                } else {
                    // Show the column (checked)
                    hiddenColumns = hiddenColumns.filter(col => col !== columnName);
                }
                
                // Update "Show All" checkbox state
                updateShowAllCheckbox();
                
                // Save to localStorage
                localStorage.setItem(storageKey, JSON.stringify(hiddenColumns));
                
                // Update UI
                updateHiddenColumnsUI(hiddenColumns, columnMap);
                applyColumnVisibility(hiddenColumns);
                updateDropdownButton();
                // Update filter inputs state
                updateFilterInputsState(hiddenColumns);
            });
        });
        
        // Load saved preferences
        let hiddenColumns = JSON.parse(localStorage.getItem(storageKey) || '[]');
        
        // Update checkboxes based on saved preferences
        updateCheckboxes();
        
        // Update "Show All" checkbox state based on current column visibility
        updateShowAllCheckbox();
        
        // Update UI based on saved preferences
        updateHiddenColumnsUI(hiddenColumns, columnMap);
        applyColumnVisibility(hiddenColumns);
        updateDropdownButton();
        // Update filter inputs state
        updateFilterInputsState(hiddenColumns);
        
        // Function to handle "Show All" action
        function handleShowAll() {
            // Check all column checkboxes (show all columns)
            const allCheckboxes = columnFilterMenu.querySelectorAll('input[type="checkbox"][data-column]');
            allCheckboxes.forEach(checkbox => {
                checkbox.checked = true;
            });
            
            // Update hiddenColumns (empty = all visible)
            hiddenColumns = [];
            localStorage.setItem(storageKey, JSON.stringify([]));
            
            // Update "Show All" checkbox state (should be checked when all columns are visible)
            showAllCheckbox.checked = true;
            
            // Update UI
            updateHiddenColumnsUI(hiddenColumns, columnMap);
            applyColumnVisibility(hiddenColumns);
            updateDropdownButton();
            // Update filter inputs state
            updateFilterInputsState(hiddenColumns);
        }
        
        // Handle "Show All" option click (on text/label)
        showAllOption.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            handleShowAll();
        });
        
        // Handle "Show All" checkbox direct click
        showAllCheckbox.addEventListener('click', function(e) {
            e.stopPropagation();
            // If checkbox is being checked, show all columns
            if (this.checked) {
                handleShowAll();
            } else {
                // If unchecking, don't allow it - keep it checked
                this.checked = true;
            }
        });
        
        // Handle individual checkbox changes
        columnFilterMenu.addEventListener('change', function(e) {
            if (e.target.type === 'checkbox' && e.target.dataset.column) {
                e.stopPropagation(); // Prevent dropdown from closing
                
                const columnName = e.target.dataset.column;
                const isChecked = e.target.checked;
                
                // Update hiddenColumns array
                // Checked = visible, Unchecked = hidden
                if (!isChecked) {
                    // Hide the column (unchecked)
                    if (!hiddenColumns.includes(columnName)) {
                        hiddenColumns.push(columnName);
                    }
                } else {
                    // Show the column (checked)
                    hiddenColumns = hiddenColumns.filter(col => col !== columnName);
                }
                
                // Update "Show All" checkbox state
                updateShowAllCheckbox();
                
                // Save to localStorage
                localStorage.setItem(storageKey, JSON.stringify(hiddenColumns));
                
                // Update UI
                updateHiddenColumnsUI(hiddenColumns, columnMap);
                applyColumnVisibility(hiddenColumns);
                updateDropdownButton();
                // Update filter inputs state
                updateFilterInputsState(hiddenColumns);
            }
        });
        
        // Prevent dropdown from closing when clicking inside the menu (but allow checkbox clicks)
        columnFilterMenu.addEventListener('click', function(e) {
            // Don't stop propagation for checkbox clicks - let them work normally
            if (e.target.type !== 'checkbox' && !e.target.closest('input[type="checkbox"]') && !e.target.closest('label')) {
                e.stopPropagation();
            }
        });
        
        function updateCheckboxes() {
            const allCheckboxes = columnFilterMenu.querySelectorAll('input[type="checkbox"][data-column]');
            allCheckboxes.forEach(checkbox => {
                const columnName = checkbox.dataset.column;
                // Checked = visible, Unchecked = hidden
                checkbox.checked = !hiddenColumns.includes(columnName);
            });
            updateShowAllCheckbox();
        }
        
        function updateShowAllCheckbox() {
            const allCheckboxes = columnFilterMenu.querySelectorAll('input[type="checkbox"][data-column]');
            const allChecked = Array.from(allCheckboxes).every(cb => cb.checked);
            
            // Show All checkbox should be checked only if all columns are visible (checked)
            showAllCheckbox.checked = allChecked;
        }
        
        function updateDropdownButton() {
            if (hiddenColumns.length === 0) {
                columnFilterDropdown.textContent = 'Show All';
            } else {
                columnFilterDropdown.textContent = `${hiddenColumns.length} Column(s) Hidden`;
            }
        }
        
        function updateHiddenColumnsUI(hiddenCols, colMap) {
            hiddenColumnsBadges.innerHTML = '';
            hiddenCols.forEach(columnName => {
                const displayName = colMap.get(columnName);
                const badge = document.createElement('span');
                badge.className = 'badge bg-secondary me-1 mb-1';
                badge.style.cursor = 'pointer';
                badge.innerHTML = displayName + ' <i class="fa-solid fa-times ms-1"></i>';
                badge.addEventListener('click', function(e) {
                    e.stopPropagation();
                    // Check the corresponding checkbox (to show the column)
                    const checkbox = columnFilterMenu.querySelector(`input[data-column="${columnName}"]`);
                    if (checkbox) {
                        checkbox.checked = true;
                        
                        // Remove from hiddenColumns array
                    hiddenColumns = hiddenColumns.filter(col => col !== columnName);
                        
                        // Update "Show All" checkbox state
                        updateShowAllCheckbox();
                        
                        // Save to localStorage
                    localStorage.setItem(storageKey, JSON.stringify(hiddenColumns));
                        
                        // Update UI
                    updateHiddenColumnsUI(hiddenColumns, columnMap);
                    applyColumnVisibility(hiddenColumns);
                        updateDropdownButton();
                        // Update filter inputs state
                        updateFilterInputsState(hiddenColumns);
                    }
                });
                hiddenColumnsBadges.appendChild(badge);
            });
        }
        
        function applyColumnVisibility(hiddenCols) {
            headers.forEach(header => {
                const columnName = header.getAttribute('data-column');
                const isHidden = hiddenCols.includes(columnName);
                
                // Hide/show header
                header.style.display = isHidden ? 'none' : '';
                
                // Hide/show all cells in this column
                const cells = table.querySelectorAll(`tbody td[data-column="${columnName}"]`);
                cells.forEach(cell => {
                    cell.style.display = isHidden ? 'none' : '';
                });
            });
            
            // Ensure Actions column is always visible
            const actionsHeaders = table.querySelectorAll('thead th[data-column="Actions"]');
            const actionsCells = table.querySelectorAll('tbody td[data-column="Actions"]');
            actionsHeaders.forEach(header => header.style.display = '');
            actionsCells.forEach(cell => cell.style.display = '');
            
            // Disable/enable filter inputs for hidden columns
            updateFilterInputsState(hiddenCols);
        }
        
        function updateFilterInputsState(hiddenCols) {
            // Get all filter items
            const filterItems = document.querySelectorAll('.filter-item[data-column]');
            filterItems.forEach(item => {
                const columnName = item.getAttribute('data-column');
                const isHidden = hiddenCols.includes(columnName);
                
                // Find all filter inputs for this column
                const filterInput = item.querySelector(`.filter-input[data-column="${columnName}"]`);
                const filterToggle = item.querySelector(`.filter-toggle[data-column="${columnName}"]`);
                const filterDateFrom = item.querySelector(`.filter-date-from[data-column="${columnName}"]`);
                const filterDateTo = item.querySelector(`.filter-date-to[data-column="${columnName}"]`);
                const clearBtn = item.querySelector(`.clear-column-filter[data-column="${columnName}"]`);
                const clearDateFromBtn = item.querySelector(`.clear-date-from-filter[data-column="${columnName}"]`);
                const clearDateToBtn = item.querySelector(`.clear-date-to-filter[data-column="${columnName}"]`);
                
                // Disable/enable inputs
                if (filterInput) {
                    filterInput.disabled = isHidden;
                    filterInput.style.opacity = isHidden ? '0.5' : '1';
                    filterInput.style.cursor = isHidden ? 'not-allowed' : 'text';
                }
                if (filterToggle) {
                    filterToggle.disabled = isHidden;
                    filterToggle.style.opacity = isHidden ? '0.5' : '1';
                    filterToggle.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                if (filterDateFrom) {
                    filterDateFrom.disabled = isHidden;
                    filterDateFrom.style.opacity = isHidden ? '0.5' : '1';
                    filterDateFrom.style.cursor = isHidden ? 'not-allowed' : 'text';
                }
                if (filterDateTo) {
                    filterDateTo.disabled = isHidden;
                    filterDateTo.style.opacity = isHidden ? '0.5' : '1';
                    filterDateTo.style.cursor = isHidden ? 'not-allowed' : 'text';
                }
                
                // Disable clear buttons
                if (clearBtn) {
                    clearBtn.disabled = isHidden;
                    clearBtn.style.opacity = isHidden ? '0.5' : '1';
                    clearBtn.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                if (clearDateFromBtn) {
                    clearDateFromBtn.disabled = isHidden;
                    clearDateFromBtn.style.opacity = isHidden ? '0.5' : '1';
                    clearDateFromBtn.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                if (clearDateToBtn) {
                    clearDateToBtn.disabled = isHidden;
                    clearDateToBtn.style.opacity = isHidden ? '0.5' : '1';
                    clearDateToBtn.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                
                // Update label style
                const label = item.querySelector('label');
                if (label) {
                    label.style.opacity = isHidden ? '0.5' : '1';
                    label.style.cursor = isHidden ? 'not-allowed' : 'default';
                }
            });
        }

        document.getElementById('pageSizeSelect').value = '@pageSize';

        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const farmIdInput = document.getElementById('farmIdToDelete');
        const farmNamePlaceholder = document.getElementById('farmNamePlaceholder');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const deleteErrorAlert = document.getElementById('deleteError');
        const deleteSuccessToast = new bootstrap.Toast(document.getElementById('deleteSuccessToast'));

        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const farmId = this.getAttribute('data-id');
                const farmName = this.getAttribute('data-name');

                farmIdInput.value = farmId;
                farmNamePlaceholder.innerText = farmName;
                deleteErrorAlert.classList.add('d-none');
                confirmDeleteBtn.disabled = false;
                confirmDeleteBtn.innerHTML = 'Delete';
            });
        });

        confirmDeleteBtn.addEventListener('click', function () {
            const farmId = farmIdInput.value;
            if (!farmId) {
                deleteErrorAlert.innerText = 'Error: Farm ID not found.';
                deleteErrorAlert.classList.remove('d-none');
                return;
            }

            confirmDeleteBtn.disabled = true;
            confirmDeleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Deleting...';

            const requestBody = 'id=' + encodeURIComponent(farmId) +
                '&__RequestVerificationToken=' + encodeURIComponent(antiForgeryToken);

            fetch('@Url.Action("Delete", "Farm")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: requestBody
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const rowToRemove = document.getElementById('row-' + farmId);
                        if (rowToRemove) {
                            rowToRemove.remove();
                        }
                        deleteModal.hide();
                        deleteSuccessToast.show();
                    } else {
                        deleteErrorAlert.innerText = data.message || 'Error deleting the record. Please try again.';
                        deleteErrorAlert.classList.remove('d-none');
                    }
                })
                .catch(error => {
                    console.error('Delete failed:', error);
                    deleteErrorAlert.innerText = 'Deletion failed: ' + error.message;
                    deleteErrorAlert.classList.remove('d-none');
                })
                .finally(() => {
                    confirmDeleteBtn.disabled = false;
                    confirmDeleteBtn.innerHTML = 'Delete';
                });
        });
        
    });
    
    // Filter Functionality
    const dataFiltersStorageKey = 'dataFilters_Farm';
    let activeFilters = JSON.parse(localStorage.getItem(dataFiltersStorageKey) || '{}');
    let currentFilteredData = [];
    let currentPage = 1;
    let pageSize = @pageSize;
    let isFiltered = Object.keys(activeFilters).length > 0;

    function changePageSize(size) {
        // If filters are active, update pageSize and re-paginate
        if (isFiltered) {
            pageSize = parseInt(size);
            currentPage = 1;
            updatePagination();
            updateTable(getPaginatedData());
        } else {
            // Server-side pagination
            const url = new URL(window.location.href);
            url.searchParams.set('pageSize', size);
            url.searchParams.set('pageNumber', '1'); // Reset to first page
            window.location.href = url.toString();
        }
    }

    (function() {
        const table = document.getElementById('dataTable');
        if (!table) return;

        // Handle input changes to show/hide clear buttons
        const filterInputs = document.querySelectorAll('.filter-input');
        filterInputs.forEach(input => {
            const columnName = input.getAttribute('data-column');
            const clearBtn = document.querySelector(`.clear-column-filter[data-column="${columnName}"]`);
            
            input.addEventListener('input', function() {
                if (this.value.trim()) {
                    if (clearBtn) clearBtn.style.display = 'block';
                } else {
                    if (clearBtn) clearBtn.style.display = 'none';
                }
            });

            // Show clear button if input has value on load
            if (input.value.trim() && clearBtn) {
                clearBtn.style.display = 'block';
            }
        });

        // Handle clear column filter button clicks
        const clearColumnButtons = document.querySelectorAll('.clear-column-filter');
        clearColumnButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                const columnName = this.getAttribute('data-column');
                const input = document.querySelector(`.filter-input[data-column="${columnName}"]`);
                const toggle = document.querySelector(`.filter-toggle[data-column="${columnName}"]`);
                if (input) {
                    input.value = '';
                    this.style.display = 'none';
                }
                if (toggle) {
                    toggle.checked = false;
                }
                // Remove from active filters
                if (activeFilters[columnName]) {
                    delete activeFilters[columnName];
                }
            });
        });

        // Clear all filters in modal
        const clearAllFiltersInModalBtn = document.getElementById('clearAllFiltersInModalBtn');
        if (clearAllFiltersInModalBtn) {
            clearAllFiltersInModalBtn.addEventListener('click', function() {
                document.querySelectorAll('.filter-input').forEach(input => { input.value = ''; });
                document.querySelectorAll('.filter-toggle').forEach(toggle => { toggle.checked = false; });
                document.querySelectorAll('.filter-date-from').forEach(input => { input.value = ''; });
                document.querySelectorAll('.filter-date-to').forEach(input => { input.value = ''; });
                document.querySelectorAll('.clear-column-filter').forEach(btn => { btn.style.display = 'none'; });
                const tri = document.getElementById('isActiveTriState');
                if (tri) { tri.value = '1'; if (typeof window.updateIsActiveTriStateTrackClass === 'function') window.updateIsActiveTriStateTrackClass(); }
                var modalTri = document.getElementById('filterTriState_IsActive');
                if (modalTri) modalTri.value = 1;
                activeFilters = {};
                localStorage.setItem(dataFiltersStorageKey, JSON.stringify({}));
                updateFilterCount();
            });
        }

        // Clear all filters button (outside modal)
        const clearAllFiltersBtn = document.getElementById('clearAllFiltersBtn');
        if (clearAllFiltersBtn) {
            clearAllFiltersBtn.addEventListener('click', async function() {
                document.querySelectorAll('.filter-input').forEach(input => { input.value = ''; });
                document.querySelectorAll('.filter-toggle').forEach(toggle => { toggle.checked = false; });
                document.querySelectorAll('.filter-date-from').forEach(input => { input.value = ''; });
                document.querySelectorAll('.filter-date-to').forEach(input => { input.value = ''; });
                document.querySelectorAll('.clear-column-filter').forEach(btn => { btn.style.display = 'none'; });
                const tri = document.getElementById('isActiveTriState');
                if (tri) { tri.value = '1'; if (typeof window.updateIsActiveTriStateTrackClass === 'function') window.updateIsActiveTriStateTrackClass(); }
                var modalTri = document.getElementById('filterTriState_IsActive');
                if (modalTri) modalTri.value = 1;
                activeFilters = {};
                localStorage.setItem(dataFiltersStorageKey, JSON.stringify({}));
                isFiltered = false;
                currentPage = 1;
                updateFilterTags();
                updateFilterCount();
                await loadAllData();
            });
        }

        // Handle toggle switches for boolean columns
        const filterToggles = document.querySelectorAll('.filter-toggle');
        filterToggles.forEach(toggle => {
            toggle.addEventListener('change', function() {
                const column = this.getAttribute('data-column');
                if (this.checked) {
                    activeFilters[column] = 'true';
                } else {
                    delete activeFilters[column];
                }
            });
        });

        const applyFilterBtn = document.getElementById('applyFilterBtn');
        if (applyFilterBtn) {
            applyFilterBtn.addEventListener('click', async function() {
                await applyFilters();
            });
        }

        // Is Active tri-state: init from storage and on change re-apply filters
        function syncIsActiveTriStateFromFilters() {
            var triVal = activeFilters.IsActive === 'false' ? 0 : (activeFilters.IsActive === 'true' ? 2 : 1);
            var mt = document.getElementById('filterTriState_IsActive'), bt = document.getElementById('isActiveTriState');
            if (mt) mt.value = triVal;
            if (bt) bt.value = triVal;
            if (typeof window.updateIsActiveTriStateTrackClass === 'function') window.updateIsActiveTriStateTrackClass();
        }
        window.syncFilterModalIsActive = syncIsActiveTriStateFromFilters;
        syncIsActiveTriStateFromFilters();
        const isActiveTriState = document.getElementById('isActiveTriState');
        if (isActiveTriState) {
            isActiveTriState.addEventListener('change', async function() {
                var v = parseInt(this.value, 10);
                if (v === 0) activeFilters.IsActive = 'false';
                else if (v === 2) activeFilters.IsActive = 'true';
                else delete activeFilters.IsActive;
                var m = document.getElementById('filterTriState_IsActive');
                if (m) m.value = this.value;
                localStorage.setItem(dataFiltersStorageKey, JSON.stringify(activeFilters));
                isFiltered = Object.keys(activeFilters).length > 0;
                if (!isFiltered) {
                    updateFilterTags();
                    updateFilterCount();
                    window.location.reload();
                    return;
                }
                await applyFilters();
            });
        }

        // Restore persisted filters on page load
        if (isFiltered && Object.keys(activeFilters).length > 0) {
            restoreFilterInputsFromStorage();
            updateFilterTags();
            updateFilterCount();
            applyFilters();
        }

        const printBtn = document.getElementById('printBtn');
        if (printBtn) {
            printBtn.addEventListener('click', async function() {
                await downloadExcel();
            });
        }

        const pageGoBtn = document.getElementById('pageGoBtn');
        const pageGoInput = document.getElementById('pageGoInput');
        if (pageGoBtn && pageGoInput) {
            pageGoBtn.addEventListener('click', function() {
                const total = parseInt(document.getElementById('totalPagesHolder')?.value || '1', 10) || 1;
                const page = parseInt(pageGoInput.value, 10);
                if (isNaN(page) || page < 1 || page > total) {
                    alert('Invalid page number. Please enter a number between 1 and ' + total + '.');
                    pageGoInput.focus();
                    return;
                }
                if (isFiltered) {
                    changeFilteredPage(page);
                } else {
                    const psize = parseInt(document.getElementById('pageSizeHolder')?.value || '10', 10) || 10;
                    const url = new URL(window.location.href);
                    url.searchParams.set('pageNumber', page);
                    url.searchParams.set('pageSize', psize);
                    window.location = url.toString();
                }
                pageGoInput.value = '';
            });
            pageGoInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    pageGoBtn.click();
                }
            });
        }
    })();

    function restoreFilterInputsFromStorage() {
        Object.keys(activeFilters).forEach(columnKey => {
            const value = activeFilters[columnKey];
            const baseCol = columnKey.endsWith('_From') ? columnKey.slice(0, -5) : (columnKey.endsWith('_To') ? columnKey.slice(0, -3) : columnKey);
            if (columnKey.endsWith('_From')) {
                const dateFrom = document.querySelector(`.filter-date-from[data-column="${baseCol}"]`);
                if (dateFrom) dateFrom.value = value;
            } else if (columnKey.endsWith('_To')) {
                const dateTo = document.querySelector(`.filter-date-to[data-column="${baseCol}"]`);
                if (dateTo) dateTo.value = value;
            } else {
                const filterInput = document.querySelector(`.filter-input[data-column="${baseCol}"]`);
                if (filterInput) {
                    filterInput.value = value;
                    const clearBtn = document.querySelector(`.clear-column-filter[data-column="${baseCol}"]`);
                    if (clearBtn) clearBtn.style.display = 'block';
                }
                const filterToggle = document.querySelector(`.filter-toggle[data-column="${baseCol}"]`);
                if (filterToggle && (value === 'true' || value === 'false')) {
                    filterToggle.checked = (value === 'true');
                }
                const filterTri = document.getElementById(`filterTriState_${baseCol}`);
                if (filterTri && (baseCol === 'IsActive')) {
                    filterTri.value = value === 'false' ? 0 : (value === 'true' ? 2 : 1);
                }
            }
        });
    }

    async function applyFilters() {
        try {
            // Collect all filter values from inputs and toggles
            activeFilters = {};
            
            // Collect from text inputs (skip disabled ones)
            const filterInputs = document.querySelectorAll('.filter-input:not(:disabled)');
            filterInputs.forEach(input => {
                const column = input.getAttribute('data-column');
                const value = input.value.trim();
                if (value) {
                    activeFilters[column] = value;
                }
            });
            
            // Collect from toggle switches (skip disabled ones)
            const filterToggles = document.querySelectorAll('.filter-toggle:not(:disabled)');
            filterToggles.forEach(toggle => {
                const column = toggle.getAttribute('data-column');
                if (toggle.checked) {
                    activeFilters[column] = 'true';
                }
            });
            
            // Collect from date inputs (skip disabled ones)
            const filterDateFroms = document.querySelectorAll('.filter-date-from:not(:disabled)');
            filterDateFroms.forEach(input => {
                const column = input.getAttribute('data-column');
                const value = input.value;
                if (value) {
                    activeFilters[`${column}_From`] = value;
                }
            });
            
            const filterDateTos = document.querySelectorAll('.filter-date-to:not(:disabled)');
            filterDateTos.forEach(input => {
                const column = input.getAttribute('data-column');
                const value = input.value;
                if (value) {
                    activeFilters[`${column}_To`] = value;
                }
            });

            // Merge Is Active tri-state (modal or bottom) into activeFilters and sync both
            var triEl = document.getElementById('filterTriState_IsActive') || document.getElementById('isActiveTriState');
            if (triEl) {
                var v = parseInt(triEl.value, 10);
                if (v === 0) activeFilters.IsActive = 'false';
                else if (v === 2) activeFilters.IsActive = 'true';
                else delete activeFilters.IsActive;
                var mt = document.getElementById('filterTriState_IsActive'), bt = document.getElementById('isActiveTriState');
                if (mt) mt.value = triEl.value;
                if (bt) bt.value = triEl.value;
                if (typeof window.updateIsActiveTriStateTrackClass === 'function') window.updateIsActiveTriStateTrackClass();
            }

            // If no filters are active, clear everything and reload
            if (Object.keys(activeFilters).length === 0) {
                // Clear filter tags and count
                updateFilterTags();
                updateFilterCount();
                localStorage.setItem(dataFiltersStorageKey, JSON.stringify({}));
                // Close modal if open
                const modal = bootstrap.Modal.getInstance(document.getElementById('filterModal'));
                if (modal) modal.hide();
                // Reload page to show all data with server-side pagination
                window.location.reload();
                return; // Exit early - no filters to apply
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('@Url.Action("Filter", "Farm")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(activeFilters)
            });
            const result = await response.json();
            if (result.success) {
                currentFilteredData = result.data;
                isFiltered = Object.keys(activeFilters).length > 0;
                currentPage = 1; // Reset to first page when filter is applied
                localStorage.setItem(dataFiltersStorageKey, JSON.stringify(activeFilters));
                updatePagination();
                updateTable(getPaginatedData());
                updateFilterTags();
                updateFilterCount();
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('filterModal'));
                if (modal) modal.hide();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error applying filters.');
        }
    }

    function updateFilterCount() {
        const count = Object.keys(activeFilters).length;
        const countBadge = document.getElementById('activeFilterCount');
        const clearAllBtn = document.getElementById('clearAllFiltersBtn');
        
        if (count > 0) {
            if (countBadge) {
                countBadge.textContent = count;
                countBadge.style.display = 'inline-block';
            }
            if (clearAllBtn) {
                clearAllBtn.style.display = 'inline-block';
            }
        } else {
            if (countBadge) {
                countBadge.style.display = 'none';
            }
            if (clearAllBtn) {
                clearAllBtn.style.display = 'none';
            }
        }
    }

    function getPaginatedData() {
        if (!isFiltered || currentFilteredData.length === 0) {
            return [];
        }
        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;
        return currentFilteredData.slice(start, end);
    }

    function updatePagination() {
        const paginationContainer = document.querySelector('nav[aria-label="Page navigation"]');
        const recordCountContainer = document.querySelector('.text-muted.mt-2');
        
        if (!isFiltered) {
            if (paginationContainer) paginationContainer.style.display = 'block';
            if (recordCountContainer) recordCountContainer.style.display = 'block';
            return;
        }

        if (paginationContainer) paginationContainer.style.display = 'block';
        if (recordCountContainer) recordCountContainer.style.display = 'block';

        const totalCount = currentFilteredData.length;
        if (totalCount === 0) {
            if (recordCountContainer) recordCountContainer.innerHTML = 'Showing 0 to 0 of 0 records';
            const ul = paginationContainer ? paginationContainer.querySelector('ul') : null;
            if (ul) {
                ul.innerHTML = `
                    <li class="page-item disabled"><span class="page-link">Previous</span></li>
                    <li class="page-item active"><span class="page-link">1</span></li>
                    <li class="page-item disabled"><span class="page-link">Next</span></li>
                `;
            }
            return;
        }

        const totalPages = Math.ceil(totalCount / pageSize);
        const start = (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalCount);

        // Update record count
        if (recordCountContainer) {
            recordCountContainer.innerHTML = `Showing ${start} to ${end} of ${totalCount} filtered records`;
        }

        const totalPagesHolder = document.getElementById('totalPagesHolder');
        if (totalPagesHolder) totalPagesHolder.value = totalPages;
        const pageGoInput = document.getElementById('pageGoInput');
        if (pageGoInput) {
            pageGoInput.max = totalPages;
            pageGoInput.value = '';
        }

        // Create pagination controls
        if (paginationContainer) {
            let paginationHTML = `
                <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changeFilteredPage(${currentPage - 1}); return false;">Previous</a>
                </li>
            `;
            
            if (totalPages <= 7) {
                // Show all pages if 7 or fewer
                for (let i = 1; i <= totalPages; i++) {
                    paginationHTML += `
                        <li class="page-item ${i === currentPage ? 'active' : ''}">
                            <a class="page-link" href="#" onclick="changeFilteredPage(${i}); return false;">${i}</a>
                        </li>
                    `;
                }
            } else {
                // Always show first page
                paginationHTML += `
                    <li class="page-item ${currentPage === 1 ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changeFilteredPage(1); return false;">1</a>
                    </li>
                `;
                
                if (currentPage <= 4) {
                    for (let i = 2; i <= Math.min(4, totalPages - 1); i++) {
                        paginationHTML += `
                            <li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link" href="#" onclick="changeFilteredPage(${i}); return false;">${i}</a>
                            </li>
                        `;
                    }
                } else {
                    paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                    for (let i = currentPage - 1; i <= Math.min(currentPage + 1, totalPages - 1); i++) {
                        paginationHTML += `
                            <li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link" href="#" onclick="changeFilteredPage(${i}); return false;">${i}</a>
                            </li>
                        `;
                    }
                }
                
                if (currentPage < totalPages - 2) {
                    paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
                
                // Always show last page
                paginationHTML += `
                    <li class="page-item ${currentPage === totalPages ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changeFilteredPage(${totalPages}); return false;">${totalPages}</a>
                    </li>
                `;
            }
            
            paginationHTML += `
                <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changeFilteredPage(${currentPage + 1}); return false;">Next</a>
                </li>
            `;
            
            paginationContainer.querySelector('ul').innerHTML = paginationHTML;
        }
    }

    function changeFilteredPage(page) {
        const totalPages = Math.ceil(currentFilteredData.length / pageSize);
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        updateTable(getPaginatedData());
        updatePagination();
        // Scroll to top of table
        document.querySelector('#dataTable')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    window.changeFilteredPage = changeFilteredPage;

    function updateTable(data) {
        const tbody = document.querySelector('#dataTable tbody');
        if (!tbody) return;
        
        // Use DocumentFragment to build all rows first, then replace in one go (no flicker)
        const fragment = document.createDocumentFragment();
        data.forEach(item => {
            const row = document.createElement('tr');
            row.id = `row-${item.farmId}`;
            row.innerHTML = `
                <td data-column="FarmName">${escapeHtml(item.farmName || '')}</td>
                <td data-column="Address">${escapeHtml(item.address || '')}</td>
                <td data-column="AreaType">${escapeHtml(item.areaTypeName || '')}</td>
                <td data-column="TotalArea">${item.totalArea ? item.totalArea.toFixed(2) : ''}</td>
                <td data-column="OrganicCertified"><input type="checkbox" class="form-check-input" disabled ${item.organicCertified ? 'checked' : ''} style="accent-color: #0d6efd;"></td>
                <td data-column="LicenseNumber">${escapeHtml(item.licenseNumber || '')}</td>
                <td data-column="CertificationDetails">${escapeHtml(item.certificationDetails || '')}</td>
                <td data-column="Latitude">${item.latitude ? item.latitude.toFixed(6) : ''}</td>
                <td data-column="Longitude">${item.longitude ? item.longitude.toFixed(6) : ''}</td>
                <td data-column="ElevationMeters">${item.elevationMeters || ''}</td>
                <td data-column="SoilType">${escapeHtml(item.soilType || '')}</td>
                <td data-column="IrrigationType">${escapeHtml(item.irrigationType || '')}</td>
                <td data-column="ClimateZone">${escapeHtml(item.climateZone || '')}</td>
                <td data-column="IsActive"><input type="checkbox" class="form-check-input" disabled ${item.isActive ? 'checked' : ''} style="accent-color: #0d6efd;"></td>
                <td data-column="Actions">
                    <div class="btn-group btn-group-sm">
                        <a class="btn btn-info" href="@Url.Action("Details", "Farm")/${item.farmId}">Details</a>
                        <a class="btn btn-warning" href="@Url.Action("Edit", "Farm")/${item.farmId}">Edit</a>
                        <a href="#" class="btn btn-danger delete-btn" data-id="${item.farmId}" data-name="${escapeHtml(item.farmName || item.licenseNumber || '')}" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</a>
                    </div>
                </td>
            `;
            fragment.appendChild(row);
        });
        
        // Replace all content in one operation (no flicker)
        tbody.innerHTML = '';
        tbody.appendChild(fragment);
        // Re-attach delete button handlers
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const farmId = this.getAttribute('data-id');
                const farmName = this.getAttribute('data-name');
                const farmIdInput = document.getElementById('farmIdToDelete');
                const farmNamePlaceholder = document.getElementById('farmNamePlaceholder');
                if (farmIdInput) farmIdInput.value = farmId;
                if (farmNamePlaceholder) farmNamePlaceholder.innerText = farmName;
            });
        });
        
        // Reapply column visibility and filter inputs state after table update
        const storageKey = `hiddenColumns_Farm`;
        const hiddenCols = JSON.parse(localStorage.getItem(storageKey) || '[]');
        const table = document.getElementById('dataTable');
        if (table) {
            const headers = table.querySelectorAll('thead th[data-column]:not([data-column="Actions"])');
            headers.forEach(header => {
                const columnName = header.getAttribute('data-column');
                const isHidden = hiddenCols.includes(columnName);
                
                // Hide/show header
                header.style.display = isHidden ? 'none' : '';
                
                // Hide/show all cells in this column
                const cells = table.querySelectorAll(`tbody td[data-column="${columnName}"]`);
                cells.forEach(cell => {
                    cell.style.display = isHidden ? 'none' : '';
                });
            });
            
            // Ensure Actions column is always visible
            const actionsHeaders = table.querySelectorAll('thead th[data-column="Actions"]');
            const actionsCells = table.querySelectorAll('tbody td[data-column="Actions"]');
            actionsHeaders.forEach(header => header.style.display = '');
            actionsCells.forEach(cell => cell.style.display = '');
            
            // Update filter inputs state
            const filterItems = document.querySelectorAll('.filter-item[data-column]');
            filterItems.forEach(item => {
                const columnName = item.getAttribute('data-column');
                const isHidden = hiddenCols.includes(columnName);
                
                const filterInput = item.querySelector(`.filter-input[data-column="${columnName}"]`);
                const filterToggle = item.querySelector(`.filter-toggle[data-column="${columnName}"]`);
                const filterDateFrom = item.querySelector(`.filter-date-from[data-column="${columnName}"]`);
                const filterDateTo = item.querySelector(`.filter-date-to[data-column="${columnName}"]`);
                const clearBtn = item.querySelector(`.clear-column-filter[data-column="${columnName}"]`);
                const clearDateFromBtn = item.querySelector(`.clear-date-from-filter[data-column="${columnName}"]`);
                const clearDateToBtn = item.querySelector(`.clear-date-to-filter[data-column="${columnName}"]`);
                
                if (filterInput) {
                    filterInput.disabled = isHidden;
                    filterInput.style.opacity = isHidden ? '0.5' : '1';
                    filterInput.style.cursor = isHidden ? 'not-allowed' : 'text';
                }
                if (filterToggle) {
                    filterToggle.disabled = isHidden;
                    filterToggle.style.opacity = isHidden ? '0.5' : '1';
                    filterToggle.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                if (filterDateFrom) {
                    filterDateFrom.disabled = isHidden;
                    filterDateFrom.style.opacity = isHidden ? '0.5' : '1';
                    filterDateFrom.style.cursor = isHidden ? 'not-allowed' : 'text';
                }
                if (filterDateTo) {
                    filterDateTo.disabled = isHidden;
                    filterDateTo.style.opacity = isHidden ? '0.5' : '1';
                    filterDateTo.style.cursor = isHidden ? 'not-allowed' : 'text';
                }
                if (clearBtn) {
                    clearBtn.disabled = isHidden;
                    clearBtn.style.opacity = isHidden ? '0.5' : '1';
                    clearBtn.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                if (clearDateFromBtn) {
                    clearDateFromBtn.disabled = isHidden;
                    clearDateFromBtn.style.opacity = isHidden ? '0.5' : '1';
                    clearDateFromBtn.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                if (clearDateToBtn) {
                    clearDateToBtn.disabled = isHidden;
                    clearDateToBtn.style.opacity = isHidden ? '0.5' : '1';
                    clearDateToBtn.style.cursor = isHidden ? 'not-allowed' : 'pointer';
                }
                
                const label = item.querySelector('label');
                if (label) {
                    label.style.opacity = isHidden ? '0.5' : '1';
                    label.style.cursor = isHidden ? 'not-allowed' : 'default';
                }
            });
        }
    }

    function updateFilterTags() {
        const tagsContainer = document.getElementById('activeFilterTags');
        if (!tagsContainer) return;
        tagsContainer.innerHTML = '';
        if (Object.keys(activeFilters).length === 0) {
            return;
        }
        Object.keys(activeFilters).forEach(column => {
            if (column === 'IsActive') return; // Is Active shown by tri-state at bottom right, not as tag
            const columnName = document.querySelector(`thead th[data-column="${column}"]`)?.textContent.trim() || column;
            const filterValue = activeFilters[column] === 'true' ? 'Yes' : (activeFilters[column] === 'false' ? 'No' : activeFilters[column]);
            const badge = document.createElement('span');
            badge.className = 'badge bg-secondary me-1 mb-1';
            badge.style.cursor = 'pointer';
            badge.innerHTML = `${columnName}: ${escapeHtml(filterValue)} <i class="fa-solid fa-times ms-1"></i>`;
            badge.addEventListener('click', function(e) {
                e.stopPropagation();
                delete activeFilters[column];
                localStorage.setItem(dataFiltersStorageKey, JSON.stringify(activeFilters));
                const baseCol = column.endsWith('_From') ? column.slice(0, -5) : (column.endsWith('_To') ? column.slice(0, -3) : column);
                const filterInput = document.querySelector(`.filter-input[data-column="${baseCol}"]`);
                const filterToggle = document.querySelector(`.filter-toggle[data-column="${baseCol}"]`);
                const filterDateFrom = document.querySelector(`.filter-date-from[data-column="${baseCol}"]`);
                const filterDateTo = document.querySelector(`.filter-date-to[data-column="${baseCol}"]`);
                const clearBtn = document.querySelector(`.clear-column-filter[data-column="${baseCol}"]`);
                if (filterInput) filterInput.value = '';
                if (filterToggle) filterToggle.checked = false;
                if (filterDateFrom) filterDateFrom.value = '';
                if (filterDateTo) filterDateTo.value = '';
                if (clearBtn) clearBtn.style.display = 'none';
                updateFilterTags();
                updateFilterCount();
                // If no filters left, load all data without page reload
                if (Object.keys(activeFilters).length === 0) {
                    isFiltered = false;
                    currentPage = 1;
                    loadAllData();
                } else {
                    applyFilters();
                }
            });
            tagsContainer.appendChild(badge);
        });
    }

    async function downloadExcel() {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            
            // Get hidden columns from localStorage
            const storageKey = `hiddenColumns_Farm`;
            const hiddenCols = JSON.parse(localStorage.getItem(storageKey) || '[]');
            
            // Prepare request data with filters and hidden columns
            const requestData = {
                filters: activeFilters || {},
                hiddenColumns: hiddenCols
            };
            
            const response = await fetch('@Url.Action("Print", "Farm")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(requestData),
                cache: 'no-cache' // Prevent caching
            });
            if (response.ok) {
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                // Get filename from Content-Disposition header if available, otherwise use default
                const contentDisposition = response.headers.get('Content-Disposition');
                const now = new Date();
                const dateStr = now.toISOString().slice(0, 10).replace(/-/g, '');
                const timeStr = String(now.getHours()).padStart(2, '0') + 
                               String(now.getMinutes()).padStart(2, '0') + 
                               String(now.getSeconds()).padStart(2, '0');
                let filename = `Farms_${dateStr}_${timeStr}.xlsx`;
                if (contentDisposition) {
                    // Try to match filename*=UTF-8''filename format first (RFC 5987)
                    let filenameMatch = contentDisposition.match(/filename\*=UTF-8''([^;,\s]+)/);
                    if (filenameMatch) {
                        filename = decodeURIComponent(filenameMatch[1].trim());
                    } else {
                        // Fall back to regular filename="..." format
                        filenameMatch = contentDisposition.match(/filename=([^;,\s]+)/);
                        if (filenameMatch) {
                            filename = filenameMatch[1].trim();
                            // Remove quotes if present
                            filename = filename.replace(/^["']|["']$/g, '');
                        }
                    }
                    // Clean up: remove any extra parameters, encoding info, or spaces
                    filename = filename.split(';')[0].split('filename_=')[0].trim();
                    // Remove any parentheses and numbers like "(2)" at the end
                    filename = filename.replace(/\s*\(\d+\)\s*$/, '');
                    // Ensure it ends with .xlsx
                    if (!filename.endsWith('.xlsx')) {
                        const baseName = filename.split('.')[0];
                        filename = baseName + '.xlsx';
                    }
                }
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            } else {
                const result = await response.json();
                alert('Error: ' + (result.message || 'Unknown error'));
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error generating Excel file.');
        }
    }

    async function loadAllData() {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('@Url.Action("Filter", "Farm")', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': token 
                },
                body: JSON.stringify({})
            });
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error('Response error:', response.status, errorText);
                alert('Error: Server returned status ' + response.status);
                return;
            }
            
            const result = await response.json();
            if (result.success) {
                // Store all data and use client-side pagination (smooth, no flicker)
                currentFilteredData = result.data;
                isFiltered = true; // Keep as filtered to use client-side pagination
                currentPage = 1;
                
                // Get paginated data first
                const paginatedData = getPaginatedData();
                
                // Update everything in a single batch using requestAnimationFrame to minimize flicker
                requestAnimationFrame(() => {
                    updatePagination();
                    updateTable(paginatedData);
                    updateFilterTags();
                    updateFilterCount();
                    
                    // Reapply column visibility and filter inputs state
                    const storageKey = `hiddenColumns_Farm`;
                    const hiddenCols = JSON.parse(localStorage.getItem(storageKey) || '[]');
                    if (typeof applyColumnVisibility === 'function') {
                        applyColumnVisibility(hiddenCols);
                    }
                });
            } else {
                alert('Error: ' + (result.message || 'Unknown error'));
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error loading data: ' + error.message);
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>