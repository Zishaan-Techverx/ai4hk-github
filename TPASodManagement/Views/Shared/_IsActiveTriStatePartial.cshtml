@* Tri-state Is Active filter: 0=Inactive, 1=All, 2=Active. Place at bottom right of listing. *@
<div class="d-flex align-items-center justify-content-end gap-2 mt-2">
    <label class="form-label mb-0 text-nowrap">Is Active:</label>
    <div class="isactive-tristate-wrapper">
        <span class="tristate-label">InActive</span>
        <input type="range" id="isActiveTriState" class="isactive-tristate" min="0" max="2" step="1" value="1" title="Inactive | All | Active" aria-label="Filter by active status" />
        <span class="tristate-label">Active</span>
    </div>
</div>

<style>
    .isactive-tristate-wrapper {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .isactive-tristate-wrapper .tristate-label {
        font-size: 0.875rem;
        color: #495057;
        font-weight: 400;
        font-family: inherit;
    }
    .isactive-tristate {
        -webkit-appearance: none;
        appearance: none;
        width: 2.75em;
        height: 1.1em;
        border-radius: 2em;
        background-color: #dee2e6;
        border: 1px solid #ced4da;
        outline: none;
        vertical-align: middle;
        transition: background-color 0.15s ease-in-out, border-color 0.15s ease-in-out;
    }
    .isactive-tristate-wrapper.isactive-tristate--active .isactive-tristate {
        background-color: #007bff;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 0 0 1px rgba(0, 123, 255, 0.5);
    }
    .isactive-tristate::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 0.9em;
        height: 0.9em;
        border-radius: 50%;
        background-color: #fff;
        border: 1px solid rgba(0, 0, 0, 0.15);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        cursor: pointer;
        margin-top: -0.05em;
        transition: box-shadow 0.15s ease-in-out;
    }
    .isactive-tristate::-moz-range-thumb {
        width: 0.9em;
        height: 0.9em;
        border-radius: 50%;
        background-color: #fff;
        border: 1px solid rgba(0, 0, 0, 0.15);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        cursor: pointer;
    }
    .isactive-tristate:focus {
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }
</style>
<script>
    (function() {
        function updateTrackClass() {
            var el = document.getElementById('isActiveTriState');
            if (!el) return;
            var w = el.closest('.isactive-tristate-wrapper');
            if (w) w.classList.toggle('isactive-tristate--active', el.value === '2');
        }
        document.addEventListener('DOMContentLoaded', function() {
            var el = document.getElementById('isActiveTriState');
            if (!el) return;
            updateTrackClass();
            el.addEventListener('input', updateTrackClass);
            el.addEventListener('change', updateTrackClass);
        });
        window.updateIsActiveTriStateTrackClass = updateTrackClass;
    })();
</script>
