@* Organization Theme Partial - Handles Navbar Colors and Footer *@

@using Microsoft.AspNetCore.Identity
@using TpaSodManagement.Areas.Identity.Data
@using TpaSodManagement.Services.Interfaces

@inject UserManager<TpaSodManagementUser> UserManager
@inject IOrganizationService OrganizationService

@{
    string userOrganizationName = null;
    
    if (User.Identity.IsAuthenticated)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null && user.OrganizationId.HasValue)
        {
            var organization = await OrganizationService.GetOrganizationByIdAsync(user.OrganizationId.Value);
            if (organization != null)
            {
                userOrganizationName = organization.OrganizationName.Trim();
            }
        }
    }
    
    // Normalize organization name for comparison
    var orgNameUpper = userOrganizationName?.ToUpper() ?? "";
    
    // Set navbar colors based on organization
    string navbarBgColor = "#212529"; // Default dark
    string navbarTextColor = "#ffffff"; // Default white
    
    if (!string.IsNullOrWhiteSpace(orgNameUpper))
    {
        if (orgNameUpper == "TPA" || orgNameUpper == "TURF PRODUCERS ASSOCIATION" || orgNameUpper.Contains("TURF PRODUCERS"))
        {
            navbarBgColor = "#2B2B2B"; // TPA Dark Gray
            navbarTextColor = "#F6F4EE"; // TPA Off-White
        }
        else if ((orgNameUpper == "HGT" || orgNameUpper == "HEALTHY GRASS TECHNOLOGY" || orgNameUpper.Contains("HEALTHY GRASS")) && !orgNameUpper.Contains("RTF"))
        {
            navbarBgColor = "#FFDB00"; // HGT Yellow
            navbarTextColor = "#1E1E1E"; // HGT Black
        }
        else if (orgNameUpper == "RTF" || (orgNameUpper.Contains("RTF") && !orgNameUpper.Contains("HGT")))
        {
            navbarBgColor = "#34B233"; // RTF Green
            navbarTextColor = "#1E1E1E"; // RTF Black (changed from Yellow)
        }
        else if (orgNameUpper.Contains("RTF") && orgNameUpper.Contains("HGT"))
        {
            navbarBgColor = "#00A8E2"; // RTF+HGT Blue
            navbarTextColor = "#FFFFFF"; // White
        }
    }
    
    // Determine which section to render (Styles or Footer)
    string renderSection = ViewBag.RenderSection?.ToString() ?? "Footer"; // Default to Footer
}

@* NAVBAR STYLES SECTION - Render when ViewBag.RenderSection = "Styles" *@
@if (renderSection == "Styles")
{
    <style>
        .org-navbar {
            background-color: @navbarBgColor !important;
        }
        
        .org-navbar .nav-link,
        .org-navbar .navbar-brand,
        .org-navbar .navbar-text,
        .org-navbar .dropdown-toggle {
            color: @navbarTextColor !important;
        }
        
        /* Remove navbar-dark text color override for better control */
        .org-navbar.navbar-dark .nav-link,
        .org-navbar.navbar-dark .navbar-brand,
        .org-navbar.navbar-dark .navbar-text,
        .org-navbar.navbar-dark .dropdown-toggle {
            color: @navbarTextColor !important;
        }
        
        .org-navbar .nav-link:hover,
        .org-navbar .navbar-brand:hover,
        .org-navbar .dropdown-toggle:hover {
            color: @navbarTextColor !important;
            opacity: 0.8;
        }
        
        .org-navbar .navbar-toggler {
            border-color: @navbarTextColor !important;
        }
        
        .org-navbar .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='@navbarTextColor' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
            opacity: 0.75;
        }
        
        .org-navbar .dropdown-menu {
            background-color: @navbarBgColor !important;
            border-color: rgba(0, 0, 0, 0.1) !important;
        }
        
        .org-navbar .dropdown-item {
            color: @navbarTextColor !important;
        }
        
        .org-navbar .dropdown-item:hover,
        .org-navbar .dropdown-item:focus {
            background-color: rgba(0, 0, 0, 0.1) !important;
            color: @navbarTextColor !important;
        }
        
        /* Ensure all text elements in navbar use the correct color */
        .org-navbar * {
            --bs-navbar-color: @navbarTextColor !important;
        }
    </style>
}

