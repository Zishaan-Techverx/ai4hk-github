                                    <a href="mailto:jenny@turfproducers.com" style="color: black; text-decoration: none;">jenny@turfproducers.com</a>
                                </span>
                                <span style="color: black; margin-left: 20px;">
                                    <i class="fas fa-phone me-2" style="color: yellow;"></i>
                                    402-480-4936
                                </span>
                            </div>
                            
                            <!-- Part 3: Address and Website -->
                            <div style="font-size: 14px;">
                                <span style="color: black;">
                                    <i class="fas fa-map-marker-alt me-2" style="color: yellow;"></i>
                                    2617 Tepee Circle, Fremont, NE
                                </span>
                                <span style="color: black; margin-left: 20px;">
                                    <i class="fas fa-globe me-2" style="color: yellow;"></i>
