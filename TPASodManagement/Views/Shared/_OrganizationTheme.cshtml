                                <span style="color: #F6F4EE;">
                                    <i class="fas fa-map-marker-alt me-2" style="color: #AC9C7C;"></i>
                                    Address
                                </span>
                                <span style="color: #F6F4EE; margin-left: 20px;">
                                    <i class="fas fa-globe me-2" style="color: #AC9C7C;"></i>
                                    Website
                                </span>
                            </div>
                        </div>
