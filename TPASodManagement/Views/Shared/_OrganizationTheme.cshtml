                                <span style="color: #F6F4EE; font-size: 13px; font-weight: bold; line-height: 1.3; display: block;">
                                    @logoLine1@if (!string.IsNullOrEmpty(logoLine2)) { <br />@logoLine2 }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
