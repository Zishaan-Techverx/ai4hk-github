@* Organization Theme Partial - Fixed TPA theme, dynamic org logo *@

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TpaSodManagement.Areas.Identity.Data
@using TpaSodManagement.Database
@using TpaSodManagement.Database.Entities

@inject UserManager<TpaSodManagementUser> UserManager
@inject ApplicationDbContext DbContext

@{
    Farm? userFarm = null;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null && user.FarmId.HasValue)
        {
            userFarm = await DbContext.Farms.FirstOrDefaultAsync(f => f.FarmId == user.FarmId.Value);
        }
    }

    var hasFooterLogo = userFarm != null &&
        ((userFarm.LogoBytes != null && userFarm.LogoBytes.Length > 0) ||
         !string.IsNullOrEmpty(userFarm.LogoFilePath));

    const string navbarBgColor = "#2B2B2B";
    const string navbarTextColor = "#F6F4EE";
    string renderSection = ViewBag.RenderSection?.ToString() ?? "Footer";
}

@* NAVBAR STYLES SECTION - Render when ViewBag.RenderSection = "Styles" *@
@if (renderSection == "Styles")
{
    <style>
        .org-navbar {
            background-color: @navbarBgColor !important;
        }
        
        .org-navbar .nav-link,
        .org-navbar .navbar-brand,
        .org-navbar .navbar-text,
        .org-navbar .dropdown-toggle {
            color: @navbarTextColor !important;
        }
        
        /* Remove navbar-dark text color override for better control */
        .org-navbar.navbar-dark .nav-link,
        .org-navbar.navbar-dark .navbar-brand,
        .org-navbar.navbar-dark .navbar-text,
        .org-navbar.navbar-dark .dropdown-toggle {
            color: @navbarTextColor !important;
        }
        
        .org-navbar .nav-link:hover,
        .org-navbar .navbar-brand:hover,
        .org-navbar .dropdown-toggle:hover {
            color: @navbarTextColor !important;
            opacity: 0.8;
        }
        
        .org-navbar .navbar-toggler {
            border-color: @navbarTextColor !important;
        }
        
        .org-navbar .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='@navbarTextColor' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
            opacity: 0.75;
        }
        
        .org-navbar .dropdown-menu {
            background-color: @navbarBgColor !important;
            border-color: rgba(0, 0, 0, 0.1) !important;
        }
        
        .org-navbar .dropdown-item {
            color: @navbarTextColor !important;
        }
        
        .org-navbar .dropdown-item:hover,
        .org-navbar .dropdown-item:focus {
            background-color: rgba(0, 0, 0, 0.1) !important;
            color: @navbarTextColor !important;
        }
        
        /* Ensure all text elements in navbar use the correct color */
        .org-navbar * {
            --bs-navbar-color: @navbarTextColor !important;
        }
    </style>
}

@* FOOTER CONTENT SECTION - Render when ViewBag.RenderSection = "Footer" or not set *@
@if (renderSection == "Footer")
{
    <footer id="pdfFooterCapture" class="organizations-footer">
        <div class="footer-section" style="background-color: #2B2B2B; color: #F6F4EE;">
            <div class="container-fluid px-4 py-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h5 class="mb-2" style="color: #F6F4EE; font-weight: bold; font-size: 16px; margin-bottom: 8px !important;">TURF PRODUCERS ASSOCIATION</h5>
                        <div class="mb-1" style="margin-bottom: 6px !important; font-size: 14px;">
                            <span style="color: #F6F4EE;">
                                <i class="fas fa-envelope me-2" style="color: #AC9C7C;"></i>
                                <a href="mailto:jenny@turfproducers.com" style="color: #F6F4EE; text-decoration: none;">jenny@turfproducers.com</a>
                            </span>
                            <span style="color: #F6F4EE; margin-left: 20px;">
                                <i class="fas fa-phone me-2" style="color: #AC9C7C;"></i>
                                402-480-4936
                            </span>
                        </div>
                        <div style="font-size: 14px;">
                            <span style="color: #F6F4EE;">
                                <i class="fas fa-map-marker-alt me-2" style="color: #AC9C7C;"></i>
                                2617 Tepee Circle, Fremont, NE
                            </span>
                            <span style="color: #F6F4EE; margin-left: 20px;">
                                <i class="fas fa-globe me-2" style="color: #AC9C7C;"></i>
                                <a href="http://www.turfproducers.com" target="_blank" style="color: #F6F4EE; text-decoration: none;">www.turfproducers.com</a>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="footer-logo-box" style="display: inline-block; padding: 10px 18px; background-color: transparent; text-align: center;">
                            @if (hasFooterLogo && userFarm != null)
                            {
                                <img src="@Url.Action("GetLogo", "Farm", new { id = userFarm.FarmId })" alt="Farm Logo" style="height: 50px; width: auto; max-width: 180px; object-fit: contain; display: block;" />
                            }
                            else
                            {
                                <span style="color: #F6F4EE; font-size: 13px; font-weight: bold; line-height: 1.3; display: block;">TURF PRODUCERS<br>ASSOCIATION</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="copyright-bar text-center py-2" style="background-color: #1E1E1E; color: #FFFFFF;">
            <div class="container">
                <p class="mb-0" style="font-size: 14px;">&copy; @DateTime.Now.Year - All Rights Reserved | TPA™</p>
            </div>
        </div>
    </footer>

    <style>
        .organizations-footer {
            width: 100%;
        }

        .footer-section {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-section:first-child {
            border-top: none;
        }

        .organizations-footer a {
            text-decoration: none;
            transition: opacity 0.3s;
        }

        .organizations-footer a:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        .footer-contact-info {
            align-items: center;
        }

        .footer-contact-info span {
            white-space: nowrap;
        }

        .footer-logo-box {
            min-width: 150px;
        }

        .social-icons a {
            transition: transform 0.3s;
        }

        .social-icons a:hover {
            transform: scale(1.2);
        }

        .footer-section .container-fluid {
            max-width: 100%;
        }

        @@media (max-width: 768px) {
            .footer-section .container-fluid {
                padding-left: 15px !important;
                padding-right: 15px !important;
            }

            .footer-section .col-md-6,
            .footer-section .col-md-8,
            .footer-section .col-md-4 {
                text-align: center !important;
                margin-bottom: 15px;
            }

            .footer-contact-info {
                justify-content: center;
            }

            .footer-logo-box {
                margin: 0 auto;
            }

            .footer-section .mb-1 span {
                display: block;
                margin-left: 0 !important;
                margin-bottom: 4px;
            }

            .footer-section > div > div > div > div:last-child span {
                display: block;
                margin-left: 0 !important;
                margin-bottom: 4px;
            }
        }
    </style>
}
