        }

        <!-- Default footer if user is not logged in or has no organization -->
        @if (userOrganizationName == null)
        {
            <div class="footer-section text-center py-3" style="background-color: #1E1E1E; color: #FFFFFF;">
                <div class="container">
                    <p class="mb-0">&copy; @DateTime.Now.Year - Sod Management System</p>
                </div>
            </div>
        }

        <!-- Copyright Bar - Hide for defined organizations (TPA, HGT, RTF, RTF+HGT) -->
        @* Only show copyright bar if user is not logged in or doesn't belong to defined organizations *@
        @if (userOrganizationName == null || 
             !(orgNameUpper == "TPA" || orgNameUpper == "TURF PRODUCERS ASSOCIATION" || orgNameUpper.Contains("TURF PRODUCERS") ||
               ((orgNameUpper == "HGT" || orgNameUpper == "HEALTHY GRASS TECHNOLOGY" || orgNameUpper.Contains("HEALTHY GRASS")) && !orgNameUpper.Contains("RTF")) ||
               (orgNameUpper == "RTF" || (orgNameUpper.Contains("RTF") && !orgNameUpper.Contains("HGT"))) ||
               (orgNameUpper.Contains("RTF") && orgNameUpper.Contains("HGT"))))
        {
            <div class="copyright-bar text-center py-2" style="background-color: #1E1E1E; color: #FFFFFF;">
                <div class="container">
                    <p class="mb-0" style="font-size: 14px;">
                        &copy; @DateTime.Now.Year - All Rights Reserved
                        @if (userOrganizationName != null)
                        {
                            if (orgNameUpper.Contains("TPA"))
                            {
                                <text>| TPA™</text>
                            }
                            if (orgNameUpper.Contains("HGT"))
                            {
                                <text>| HGT®</text>
                            }
                            if (orgNameUpper.Contains("RTF"))
                            {
                                <text>| RTF®</text>
                            }
                        }
                    </p>
                </div>
            </div>
        }
    </footer>

    <style>
        .organizations-footer {
            width: 100%;
        }

        .footer-section {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-section:first-child {
            border-top: none;
        }

        .organizations-footer a {
            text-decoration: none;
            transition: opacity 0.3s;
        }

        .organizations-footer a:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        .footer-contact-info {
            align-items: center;
        }

        .footer-contact-info span {
            white-space: nowrap;
        }

        .footer-logo-box {
            min-width: 150px;
        }

        .social-icons a {
            transition: transform 0.3s;
        }

        .social-icons a:hover {
            transform: scale(1.2);
        }

        .footer-section .container-fluid {
            max-width: 100%;
        }

        @@media (max-width: 768px) {
            .footer-section .container-fluid {
                padding-left: 15px !important;
                padding-right: 15px !important;
            }

            .footer-section .col-md-6,
            .footer-section .col-md-8,
            .footer-section .col-md-4 {
                text-align: center !important;
                margin-bottom: 15px;
            }

            .footer-contact-info {
                justify-content: center;
            }

            .footer-logo-box {
                margin: 0 auto;
            }

            .footer-section .mb-1 span {
                display: block;
                margin-left: 0 !important;
                margin-bottom: 4px;
            }

            .footer-section > div > div > div > div:last-child span {
                display: block;
                margin-left: 0 !important;
                margin-bottom: 4px;
            }
        }
    </style>
}
