        <!-- Generic footer for other organizations -->
        @if (userOrganizationName != null && 
             !(orgNameUpper == "TPA" || orgNameUpper == "TURF PRODUCERS ASSOCIATION" || orgNameUpper.Contains("TURF PRODUCERS") ||
               ((orgNameUpper == "HGT" || orgNameUpper == "HEALTHY GRASS TECHNOLOGY" || orgNameUpper.Contains("HEALTHY GRASS")) && !orgNameUpper.Contains("RTF")) ||
               (orgNameUpper == "RTF" || (orgNameUpper.Contains("RTF") && !orgNameUpper.Contains("HGT"))) ||
               (orgNameUpper.Contains("RTF") && orgNameUpper.Contains("HGT"))))
        {
            var orgWords = userOrganizationName.Split(' ');
            string logoLine1 = "";
            string logoLine2 = "";
            if (orgWords.Length >= 2)
            {
                int midPoint = orgWords.Length / 2;
                logoLine1 = string.Join(" ", orgWords.Take(midPoint)).ToUpper();
                logoLine2 = string.Join(" ", orgWords.Skip(midPoint)).ToUpper();
            }
            else
            {
                if (userOrganizationName.Length > 15)
                {
                    int mid = userOrganizationName.Length / 2;
                    logoLine1 = userOrganizationName.Substring(0, mid).ToUpper();
                    logoLine2 = userOrganizationName.Substring(mid).ToUpper();
                }
                else
                {
                    logoLine1 = userOrganizationName.ToUpper();
                }
            }
            
            <!-- Generic Organization Section -->
            <div class="footer-section" style="background-color: #2B2B2B; color: #F6F4EE;">
