@model TpaSodManagement.ViewModels.Address.AddressFormViewModel

@{
    ViewData["Title"] = Model.AddressId.HasValue ? $"Edit {Model.ParentEntityName} Address" : $"Add {Model.ParentEntityName} Address";
    var isEdit = Model.AddressId.HasValue;
    var showPrimaryVerified = !string.Equals(Model.ParentEntityName, "Customer", StringComparison.OrdinalIgnoreCase);
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@ViewData["Title"]</h5>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid && !ViewData.ModelState.ErrorCount.Equals(0))
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Validation Errors:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="@(isEdit ? "EditAddress" : "CreateAddress")" asp-route-id="@Model.ParentEntityId" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                        @Html.AntiForgeryToken()
                        @if (!isEdit && ViewBag.ReturnUrl != null)
                        {
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        }
                        <input type="hidden" asp-for="ParentEntityName" />
                        <input type="hidden" asp-for="ParentEntityId" />
                        @if (Model.AddressId.HasValue)
                        {
                            <input type="hidden" asp-for="AddressId" />
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AddressTypeId" class="form-label">Address Type <span class="text-danger">*</span></label>
                                @if (Model.IsAddressTypeReadOnly)
                                {
                                    <select asp-for="AddressTypeId" class="form-select" asp-items="Model.AddressTypes" disabled>
                                        <option value="">-- Select Address Type --</option>
                                    </select>
                                    <input type="hidden" asp-for="AddressTypeId" />
                                }
                                else
                                {
                                    <select asp-for="AddressTypeId" class="form-select" asp-items="Model.AddressTypes" required>
                                        <option value="">-- Select Address Type --</option>
                                    </select>
                                }
                                <span asp-validation-for="AddressTypeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label">City <span class="text-danger">*</span></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AddressLine1" class="form-label">Address Line 1 <span class="text-danger">*</span></label>
                            <input asp-for="AddressLine1" class="form-control" />
                            <span asp-validation-for="AddressLine1" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AddressLine2" class="form-label">Address Line 2</label>
                            <input asp-for="AddressLine2" class="form-control" />
                            <span asp-validation-for="AddressLine2" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StateProvinceId" class="form-label">State / Province</label>
                                <select asp-for="StateProvinceId" class="form-select" asp-items="Model.StateProvinces">
                                    <option value="">-- Select State / Province --</option>
                                </select>
                                <span asp-validation-for="StateProvinceId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PostalCode" class="form-label">Postal Code <span class="text-danger">*</span></label>
                                <input asp-for="PostalCode" class="form-control" />
                                <span asp-validation-for="PostalCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Latitude" class="form-label">Latitude</label>
                                <input asp-for="Latitude" type="number" step="0.000001" class="form-control" />
                                <span asp-validation-for="Latitude" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Longitude" class="form-label">Longitude</label>
                                <input asp-for="Longitude" type="number" step="0.000001" class="form-control" />
                                <span asp-validation-for="Longitude" class="text-danger"></span>
                            </div>
                        </div>

                        @if (showPrimaryVerified)
                        {
                            <div class="mb-3 d-flex align-items-center">
                                <label class="form-label mb-0 me-2">Primary</label>
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsPrimary" type="checkbox" class="form-check-input" />
                                </div>
                            </div>

                            <div class="mb-3 d-flex align-items-center">
                                <label class="form-label mb-0 me-2">Verified</label>
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsVerified" type="checkbox" class="form-check-input" />
                                </div>
                            </div>
                        }

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label mb-0 me-2">Active</label>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            @if (Model.ParentEntityId == 0)
                            {
                                <a asp-action="SkipAddress" asp-route-id="0" class="btn btn-secondary me-2">Skip</a>
                            }
                            else if (ViewBag.ReturnUrl != null)
                            {
                                <a href="@ViewBag.ReturnUrl" class="btn btn-secondary me-2">Skip</a>
                            }
                            else
                            {
                                <a asp-action="Index" class="btn btn-secondary me-2">Skip</a>
                            }
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
