@using System.Linq
@using TpaSodManagement.Database.Entities

@{
    var farms = ViewData["Farms"] as List<Farm> ?? new List<Farm>();
    var allFarms = farms
        .OrderBy(f => f.FarmName)
        .ToList();
}

@* Compact Login + Register partial that posts to Identity Razor Pages *@
<div class="row g-4 justify-content-center">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="col-12">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Login Form - Initially Visible -->
    <div class="col-md-9" id="loginSection">
        <div class="card auth-card">
            <div class="card-body">
                <h5 class="card-title" style="color:#2B2B2B;">Log in</h5>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <!-- CHANGED: Now uses HomeController Login method -->
                <form asp-controller="Home" asp-action="Login" method="post" class="needs-validation" id="loginForm" novalidate>
                    <div class="form-floating mb-3">
                        <input name="Input_Email" type="text" class="form-control" id="loginEmail" required />
                        <label for="loginEmail">Email / Username</label>
                        <div class="invalid-feedback">
                            Please provide a valid email or username.
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <input name="Input_Password" type="password" class="form-control" id="loginPassword" required />
                        <label for="loginPassword">Password</label>
                        <div class="invalid-feedback">
                            Please provide your password.
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input name="Input_RememberMe" class="form-check-input" type="checkbox" value="true" id="rememberMe" />
                        <label class="form-check-label" style="color:#2B2B2B;" for="rememberMe">Remember me</label>
                    </div>
                    <button type="submit" class="btn auth-btn-primary w-100" id="loginSubmitBtn">Log in</button>
                </form>

                <button type="button" onclick="showRegister()" class="btn auth-btn-outline w-100 mt-2">
                    Register
                </button>
            </div>
        </div>
    </div>

    <!-- Register Form - Initially Hidden -->
    <div class="col-md-9" id="registerSection" style="display: none;">
        <div class="card auth-card">
            <div class="card-body">
                <h5 class="card-title" style="color:#2B2B2B;">Register</h5>
                <form asp-area="Identity" asp-page="/Account/Register" method="post" class="needs-validation" novalidate>
                    <input type="hidden" name="ReturnUrl" value="@Context.Request.Path" />

                    <div class="form-floating mb-3">
                        <input name="Input.FirstName" type="text" class="form-control" id="registerFirstName" required />
                        <label for="registerFirstName">First Name</label>
                        <div class="invalid-feedback">
                            Please provide your first name.
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="Input.LastName" type="text" class="form-control" id="registerLastName" required />
                        <label for="registerLastName">Last Name</label>
                        <div class="invalid-feedback">
                            Please provide your last name.
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input name="Input.Email" type="email" class="form-control" id="registerEmail" required />
                        <label for="registerEmail">Email</label>
                        <div class="invalid-feedback">
                            Please provide a valid email.
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="registerFarm" class="form-label" style="color:#2B2B2B;">Farm</label>
                        <select name="Input.FarmId" 
                                class="form-select" 
                                id="registerFarm" 
                                required>
                            <option value="">-- Select Farm --</option>
                            @foreach (var farm in allFarms)
                            {
                                <option value="@farm.FarmId">@farm.FarmName</option>
                            }
                        </select>
                        <div class="invalid-feedback">
                            Please select a farm.
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input name="Input.Password" type="password" class="form-control" id="registerPassword" required />
                        <label for="registerPassword">Password</label>
                        <div class="invalid-feedback">
                            Please provide a password.
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input name="Input.ConfirmPassword" type="password" class="form-control" id="registerConfirm" required />
                        <label for="registerConfirm">Confirm Password</label>
                        <div class="invalid-feedback">
                            Please confirm your password.
                        </div>
                    </div>
                    
                    <button type="submit" class="btn auth-btn-primary w-100">Register</button>
                </form>
                
                <button type="button" onclick="showLogin()" class="btn auth-btn-outline w-100 mt-2">
                    Login Existing User
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function showRegister() {
        document.getElementById('loginSection').style.display = 'none';
        document.getElementById('registerSection').style.display = 'block';
    }

    function showLogin() {
        document.getElementById('registerSection').style.display = 'none';
        document.getElementById('loginSection').style.display = 'block';
    }

    (function () {
        'use strict';
        window.addEventListener('load', function () {
            Array.from(document.getElementsByClassName('needs-validation')).forEach(function (form) {
                if (form.id !== 'loginForm') {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                }
            });
        }, false);
    })();

    // Handle login form submission with AJAX for 2FA
    document.addEventListener('DOMContentLoaded', function() {
        var loginForm = document.getElementById('loginForm');
        if (loginForm) {
            // Remove any existing error messages
            var existingErrors = loginForm.querySelectorAll('.alert-danger');
            existingErrors.forEach(function(err) { err.remove(); });
            
            loginForm.addEventListener('submit', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                // Remove any existing error messages
                var existingErrors = loginForm.querySelectorAll('.alert-danger');
                existingErrors.forEach(function(err) { err.remove(); });
                
                // Check form validity
                if (!loginForm.checkValidity()) {
                    loginForm.classList.add('was-validated');
                    return false;
                }
                
                var formData = new FormData(loginForm);
                var submitBtn = document.getElementById('loginSubmitBtn');
                var originalText = submitBtn.textContent;
                submitBtn.disabled = true;
                submitBtn.textContent = 'Logging in...';

                console.log('Sending login request...');
                fetch('/Home/Login', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(response => {
                    console.log('Response received:', response.status);
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Response data:', data);
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;

                    if (data.success) {
                        if (data.requires2FA) {
                            console.log('2FA required, showing popup...');
                            // Show 2FA popup
                            show2FAPopup();
                        } else {
                            console.log('Login successful, redirecting...');
                            // Normal login success, redirect
                            window.location.href = data.redirectUrl || '/';
                        }
                    } else {
                        console.log('Login failed:', data.message);
                        // Show error message
                        var errorDiv = document.createElement('div');
                        errorDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
                        errorDiv.innerHTML = '<strong>Error:</strong> ' + (data.message || 'Login failed.') + 
                            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                        loginForm.insertBefore(errorDiv, loginForm.firstChild);
                        
                        // Remove error after 5 seconds
                        setTimeout(function() {
                            errorDiv.remove();
                        }, 5000);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                    alert('An error occurred during login. Please try again.');
                });
                
                return false;
            });
        } else {
            console.error('Login form not found!');
        }
    });

    // Make functions globally accessible
    window.show2FAPopup = function() {
        // Create modal HTML
        var modalHtml = `
            <div class="modal fade" id="twoFactorModal" tabindex="-1" aria-labelledby="twoFactorModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="twoFactorModalLabel">Two-Factor Authentication</h5>
                        </div>
                        <div class="modal-body">
                            <p id="twoFactorInstruction">Please enter the verification code from your authenticator app.</p>
                            <form id="verify2faForm">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="twoFactorCode" autocomplete="off" maxlength="50" required />
                                    <label for="twoFactorCode" id="twoFactorLabel">Verification Code</label>
                                </div>
                                <div id="twoFactorError" class="alert alert-danger" style="display: none;"></div>
                            </form>
                            <div class="text-center mt-2">
                                <button type="button" class="btn btn-link p-0" id="toggleRecoveryCodeBtn" onclick="toggleRecoveryCodeMode()">Use Recovery Code</button>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" onclick="close2FAPopup()">Cancel</button>
                            <button type="button" class="btn auth-btn-primary" id="verify2faBtn" onclick="verify2FACode()">Verify</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        // Remove existing modal if any
        var existingModal = document.getElementById('twoFactorModal');
        if (existingModal) {
            existingModal.remove();
        }
        
        // Add modal to body
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        
        // Initialize recovery code mode flag
        window.isRecoveryCodeMode = false;
        
        // Show modal
        var modal = new bootstrap.Modal(document.getElementById('twoFactorModal'));
        modal.show();
        
        // Focus on input
        setTimeout(function() {
            document.getElementById('twoFactorCode').focus();
        }, 500);
        
        // Allow Enter key to submit
        document.getElementById('twoFactorCode').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                verify2FACode();
            }
        });
    }
    
    window.toggleRecoveryCodeMode = function() {
        var isRecoveryMode = window.isRecoveryCodeMode || false;
        window.isRecoveryCodeMode = !isRecoveryMode;
        
        var codeInput = document.getElementById('twoFactorCode');
        var codeLabel = document.getElementById('twoFactorLabel');
        var instruction = document.getElementById('twoFactorInstruction');
        var toggleBtn = document.getElementById('toggleRecoveryCodeBtn');
        
        if (window.isRecoveryCodeMode) {
            // Switch to recovery code mode
            codeInput.maxLength = 50; // Recovery codes can be up to 24+ characters with formatting
            codeInput.value = '';
            codeLabel.textContent = 'Recovery Code';
            instruction.textContent = 'Please enter your recovery code.';
            toggleBtn.textContent = 'Use Verification Code';
        } else {
            // Switch to verification code mode
            codeInput.maxLength = 6; // 2FA codes are 6 digits
            codeInput.value = '';
            codeLabel.textContent = 'Verification Code';
            instruction.textContent = 'Please enter the verification code from your authenticator app.';
            toggleBtn.textContent = 'Use Recovery Code';
        }
        
        // Clear any error messages
        var errorDiv = document.getElementById('twoFactorError');
        if (errorDiv) {
            errorDiv.style.display = 'none';
        }
        
        // Focus on input
        codeInput.focus();
    }

    window.verify2FACode = function() {
        var code = document.getElementById('twoFactorCode').value;
        var errorDiv = document.getElementById('twoFactorError');
        var verifyBtn = document.getElementById('verify2faBtn');
        var isRecoveryMode = window.isRecoveryCodeMode || false;
        
        if (!code || code.trim() === '') {
            var codeType = isRecoveryMode ? 'recovery code' : 'verification code';
            errorDiv.textContent = 'Please enter a ' + codeType + '.';
            errorDiv.style.display = 'block';
            return;
        }
        
        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Verifying...';
        errorDiv.style.display = 'none';
        
        var formData = new FormData();
        formData.append('code', code);
        formData.append('isRecoveryCode', isRecoveryMode);
        
        fetch('/Home/Verify2FA', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Close modal
                close2FAPopup();
                // Redirect to home
                window.location.href = data.redirectUrl || '/';
            } else {
                errorDiv.textContent = data.message || (isRecoveryMode ? 'Invalid recovery code.' : 'Invalid verification code.');
                errorDiv.style.display = 'block';
                verifyBtn.disabled = false;
                verifyBtn.textContent = 'Verify';
                // Clear input
                document.getElementById('twoFactorCode').value = '';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            errorDiv.textContent = 'An error occurred. Please try again.';
            errorDiv.style.display = 'block';
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Verify';
        });
    }

    window.close2FAPopup = function() {
        var modalElement = document.getElementById('twoFactorModal');
        if (modalElement) {
            var modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) {
                modal.hide();
            }
            modalElement.remove();
        }
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            showLogin();
        });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            showLogin();
        });
        </text>
    }
</script>