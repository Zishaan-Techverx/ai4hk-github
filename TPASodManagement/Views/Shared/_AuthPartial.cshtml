@using System.Linq
@using TpaSodManagement.Database.Entities
@using TpaSodManagement.Services.Interfaces

@inject IOrganizationService OrganizationService

@{
    // Get ALL organizations from ViewData (loaded in HomeController)
    var organizations = ViewData["Organizations"] as List<Organization> ?? new List<Organization>();
    var allOrganizations = organizations
        .OrderBy(o => o.OrganizationName)
        .ToList();
}

@* Compact Login + Register partial that posts to Identity Razor Pages *@
<div class="row g-4 justify-content-center">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="col-12">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Login Form - Initially Visible -->
    <div class="col-md-9" id="loginSection">
        <div class="card auth-card">
            <div class="card-body">
                <h5 class="card-title" style="color:#2B2B2B;">Log in</h5>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <!-- CHANGED: Now uses HomeController Login method -->
                <form asp-controller="Home" asp-action="Login" method="post" class="needs-validation" novalidate>
                    <div class="form-floating mb-3">
                        <input name="Input_Email" type="text" class="form-control" id="loginEmail" required />
                        <label for="loginEmail">Email / Username</label>
                        <div class="invalid-feedback">
                            Please provide a valid email or username.
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <input name="Input_Password" type="password" class="form-control" id="loginPassword" required />
                        <label for="loginPassword">Password</label>
                        <div class="invalid-feedback">
                            Please provide your password.
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input name="Input_RememberMe" class="form-check-input" type="checkbox" value="true" id="rememberMe" />
                        <label class="form-check-label" style="color:#2B2B2B;" for="rememberMe">Remember me</label>
                    </div>
                    <button type="submit" class="btn auth-btn-primary w-100">Log in</button>
                </form>

                <button type="button" onclick="showRegister()" class="btn auth-btn-outline w-100 mt-2">
                    Register
                </button>
            </div>
        </div>
    </div>

    <!-- Register Form - Initially Hidden -->
    <div class="col-md-9" id="registerSection" style="display: none;">
        <div class="card auth-card">
            <div class="card-body">
                <h5 class="card-title" style="color:#2B2B2B;">Register</h5>
                <form asp-area="Identity" asp-page="/Account/Register" method="post" class="needs-validation" novalidate>
                    <input type="hidden" name="ReturnUrl" value="@Context.Request.Path" />

                    <div class="form-floating mb-3">
                        <input name="Input.FirstName" type="text" class="form-control" id="registerFirstName" required />
                        <label for="registerFirstName">First Name</label>
                        <div class="invalid-feedback">
                            Please provide your first name.
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="Input.LastName" type="text" class="form-control" id="registerLastName" required />
                        <label for="registerLastName">Last Name</label>
                        <div class="invalid-feedback">
                            Please provide your last name.
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input name="Input.Email" type="email" class="form-control" id="registerEmail" required />
                        <label for="registerEmail">Email</label>
                        <div class="invalid-feedback">
                            Please provide a valid email.
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="registerOrganization" class="form-label" style="color:#2B2B2B;">Organization Name</label>
                        <select name="Input.OrganizationName" 
                                class="form-select" 
                                id="registerOrganization" 
                                required>
                            <option value="">-- Select Organization --</option>
                            @foreach (var org in allOrganizations)
                            {
                                <option value="@org.OrganizationName">@org.OrganizationName</option>
                            }
                        </select>
                        <div class="invalid-feedback">
                            Please select an organization.
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input name="Input.Password" type="password" class="form-control" id="registerPassword" required />
                        <label for="registerPassword">Password</label>
                        <div class="invalid-feedback">
                            Please provide a password.
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input name="Input.ConfirmPassword" type="password" class="form-control" id="registerConfirm" required />
                        <label for="registerConfirm">Confirm Password</label>
                        <div class="invalid-feedback">
                            Please confirm your password.
                        </div>
                    </div>
                    
                    <button type="submit" class="btn auth-btn-primary w-100">Register</button>
                </form>
                
                <button type="button" onclick="showLogin()" class="btn auth-btn-outline w-100 mt-2">
                    Login Existing User
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function showRegister() {
        document.getElementById('loginSection').style.display = 'none';
        document.getElementById('registerSection').style.display = 'block';
    }

    function showLogin() {
        document.getElementById('registerSection').style.display = 'none';
        document.getElementById('loginSection').style.display = 'block';
    }

    (function () {
        'use strict';
        window.addEventListener('load', function () {
            Array.from(document.getElementsByClassName('needs-validation')).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            showLogin();
        });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            showLogin();
        });
        </text>
    }
</script>