@model IEnumerable<TpaSodManagement.Models.Db.Product>

@{
    ViewData["Title"] = "Index";
    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
}
<br />
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Products</h1>

    @if (User.HasPermission("Product.Create"))
    {
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    }
</div>
<br/>
<div class="row mb-3">
    <div class="col-md-6">
        <label for="pageSizeSelect" class="form-label">Page Size</label>
        <select id="pageSizeSelect" class="form-select" style="width: auto; display: inline-block;"
            onchange="changePageSize(this.value)">
            <option value="10" selected="@(pageSize == 10)">10</option>
            <option value="15" selected="@(pageSize == 15)">15</option>
            <option value="20" selected="@(pageSize == 20)">20</option>
            <option value="25" selected="@(pageSize == 25)">25</option>
            <option value="50" selected="@(pageSize == 50)">50</option>
            <option value="100" selected="@(pageSize == 100)">100</option>
        </select>
    </div>
</div>

<div class="card card-body shadow-sm">
    <table class="table">
        <thead>
            <tr>
                <th>
                    Product Code
                </th>
                <th>
                    Product Name
                </th>
                <th>
                    Unit Of Measure
                </th>
                <th>
                    Standard Price
                </th>
                <th>
                    Requires Certificate
                </th>
                <th>
                    Description
                </th>
                <th>
                    IsActive
                </th>
                <th>
                    Created Date
                </th>
                <th>
                    Certificate Type
                </th>
                <th>
                    Created By User
                </th>
                <th>
                    Currency
                </th>
                <th>
                    Product Category
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductCode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UnitOfMeasure)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StandardPrice)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RequiresCertificate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IsActive)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CertificateType.CertificateTypeId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedByUser.UserId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Currency.CurrencyId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductCategory.ProductCategoryId)
                    </td>
                    <td style="display: flex; gap: 8px; align-items: center;">
                        @if (User.HasPermission("Product.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.ProductId">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </a>
                        }
                        @if (User.HasPermission("Product.Detail"))
                        {
                            <a asp-action="Details" asp-route-id="@item.ProductId">
                                <i class="fa-solid fa-circle-info"></i>
                            </a>
                        }
                        @if (User.HasPermission("Product.Delete"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.ProductId">
                                <i class="fa-solid fa-trash-can" style="color: #ff0000;"></i>
                            </a>
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<br />
<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
            <a class="page-link"
                href="@Url.Action("Index", new { pageNumber = pageNumber - 1, pageSize = pageSize })">Previous</a>
        </li>

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = pageSize })">@i</a>
            </li>
        }

        <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
            <a class="page-link"
                href="@Url.Action("Index", new { pageNumber = pageNumber + 1, pageSize = pageSize })">Next</a>
        </li>
    </ul>
</nav>

<div class="text-muted mt-2">
    Showing @((pageNumber - 1) * pageSize + 1) to @Math.Min(pageNumber * pageSize, totalCount) of @totalCount records
</div>

<br />
<br />
<script>
    function changePageSize(selectedPageSize) {
        window.location.href = '@Url.Action("Index", new { pageNumber = 1 })' + '&pageSize=' + selectedPageSize;
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('pageSizeSelect').value = '@pageSize';
    });
</script>