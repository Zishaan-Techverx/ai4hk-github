@model IEnumerable<TpaSodManagement.Models.Db.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitOfMeasure)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StandardPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequiresCertificate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CertificateType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedByUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Currency)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductCategory)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitOfMeasure)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StandardPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequiresCertificate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CertificateType.CertificateTypeId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedByUser.UserId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Currency.CurrencyId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductCategory.ProductCategoryId)
            </td>
                <td style="display: flex; gap: 8px; align-items: center;">
                    <a asp-action="Edit" asp-route-id="@item.ProductId">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.ProductId">
                        <i class="fa-solid fa-circle-info"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.ProductId">
                        <i class="fa-solid fa-trash-can" style="color: #ff0000;"></i>
                    </a>
                </td>
        </tr>
}
    </tbody>
</table>
