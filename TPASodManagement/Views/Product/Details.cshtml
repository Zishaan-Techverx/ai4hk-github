@model TpaSodManagement.Models.Db.Product

@{
    ViewData["Title"] = "Details";
}
<br />
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
    </a>

    <h1 class="ms-4 mb-0">Details</h1>
</div>

<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Product Code
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ProductCode)
        </dd>
        <dt class = "col-sm-2">
            Product Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ProductName)
        </dd>
        <dt class = "col-sm-2">
            Unit Of Measure
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UnitOfMeasure)
        </dd>
        <dt class = "col-sm-2">
            Standard Price
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StandardPrice)
        </dd>
        <dt class = "col-sm-2">
            Requires Certificate
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RequiresCertificate)
        </dd>
        <dt class = "col-sm-2">
            Description
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            IsActive
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            Created Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class = "col-sm-2">
            Certificate Type
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CertificateType.CertificateTypeId)
        </dd>
        <dt class = "col-sm-2">
            Created By User
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedByUser.UserId)
        </dd>
        <dt class = "col-sm-2">
            Currency
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Currency.CurrencyId)
        </dd>
        <dt class = "col-sm-2">
            Product Category
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ProductCategory.ProductCategoryId)
        </dd>
    </dl>
</div>
<br />
<br />
