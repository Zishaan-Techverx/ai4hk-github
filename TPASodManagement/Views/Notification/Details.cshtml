@model TpaSodManagement.Database.Entities.Notification

@{
    bool isDetailsView = ViewBag.IsDetailsView ?? true;
    ViewData["Title"] = "Notification Details";
}

<br />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Notification Details</h5>
                </div>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Error!</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Title</label>
                            <input type="text" class="form-control" value="@Model.Title" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Message</label>
                            <textarea class="form-control" rows="5" readonly>@Model.Message</textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Is Active</label>
                            <input type="text" class="form-control" value="@(Model.IsActive ? "Yes" : "No")" readonly />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Expiry Date</label>
                            <input type="text" class="form-control" value="@(Model.ExpiryDate?.ToString("yyyy-MM-dd HH:mm") ?? "Not Set")" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Created Date</label>
                            <input type="text" class="form-control" value="@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")" readonly />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Updated Date</label>
                            <input type="text" class="form-control" value="@(Model.UpdatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Priority</label>
                            <div>
                                @{
                                    var priorityClass = Model.Priority == "Critical" ? "danger" : 
                                                       Model.Priority == "High" ? "warning" : 
                                                       Model.Priority == "Medium" ? "info" : 
                                                       Model.Priority == "Low" ? "secondary" : "secondary";
                                }
                                <span class="badge bg-@priorityClass">@Model.Priority</span>
                            </div>
                        </div>
                    </div>

                    @if (Model.NotificationUsers != null && Model.NotificationUsers.Any())
                    {
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">Recipients (@Model.NotificationUsers.Count)</label>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm">
                                        <thead>
                                            <tr>
                                                <th>User Name</th>
                                                <th>Email</th>
                                                <th>Is Read</th>
                                                <th>Read Date</th>
                                                <th>Reply</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var replies = ViewBag.Replies as List<TpaSodManagement.Database.Entities.NotificationResponse> ?? new List<TpaSodManagement.Database.Entities.NotificationResponse>();
                                            }
                                            @{
                                                var persons = ViewBag.Persons as Dictionary<long, TpaSodManagement.Database.Entities.Person> ?? new Dictionary<long, TpaSodManagement.Database.Entities.Person>();
                                            }
                                            @foreach (var notificationUser in Model.NotificationUsers)
                                            {
                                                var userReplies = replies.Where(r => r.UserId == notificationUser.UserId).ToList();
                                                var person = notificationUser.User?.PersonId.HasValue == true && persons.ContainsKey(notificationUser.User.PersonId.Value) 
                                                    ? persons[notificationUser.User.PersonId.Value] 
                                                    : null;
                                                var userNameDisplay = notificationUser.User?.UserName ?? "N/A";
                                                if (person != null)
                                                {
                                                    userNameDisplay = $"{userNameDisplay} ({person.FirstName} {person.LastName})";
                                                }
                                                <tr>
                                                    <td>@userNameDisplay</td>
                                                    <td>@(notificationUser.User?.Email ?? "N/A")</td>
                                                    <td>@(notificationUser.IsRead ? "Yes" : "No")</td>
                                                    <td>@(notificationUser.ReadDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                                                    <td>
                                                        @if (userReplies.Any())
                                                        {
                                                            <div>
                                                                @foreach (var reply in userReplies)
                                                                {
                                                                    <div class="mb-2 p-2 bg-light rounded">
                                                                        <div class="small text-muted">@reply.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
                                                                        <div>@reply.Reply</div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No reply</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back</a>
                        <button type="button" class="btn btn-warning edit-notification" 
                                data-id="@Model.NotificationId" 
                                data-title="@Model.Title" 
                                data-message="@Model.Message" 
                                data-priority="@Model.Priority"
                                data-expiry="@(Model.ExpiryDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Mark notification as viewed if it has replies
            var notificationId = @Model.NotificationId;
            var hasReplies = @((ViewBag.Replies as List<TpaSodManagement.Database.Entities.NotificationResponse> ?? new List<TpaSodManagement.Database.Entities.NotificationResponse>()).Any() ? "true" : "false");
            
            if (hasReplies) {
                // Load existing viewed notifications from localStorage (persists across app restarts)
                var viewedNotifications = JSON.parse(localStorage.getItem('superadminViewedNotifications') || '[]');
                
                // Add this notification if not already in the list
                if (viewedNotifications.indexOf(notificationId) === -1) {
                    viewedNotifications.push(notificationId);
                    localStorage.setItem('superadminViewedNotifications', JSON.stringify(viewedNotifications));
                }
            }
            
            // Edit button handler for details page
            $('.edit-notification').on('click', function() {
                var notificationId = $(this).data('id');
                
                // Redirect to home page with query parameter to trigger edit modal
                window.location.href = '@Url.Action("Index", "Home")?editNotificationId=' + notificationId;
            });
        });
    </script>
}

