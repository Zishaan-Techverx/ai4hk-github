@model List<TpaSodManagement.Database.Entities.Notification>
@{
    ViewData["Title"] = "Notifications Management";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>Notifications Management</h2>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#sendNotificationModal">
                    <i class="bi bi-plus-circle"></i> Send Notification
                </button>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>All Notifications</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="notificationsTable">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Message</th>
                                    <th>Priority</th>
                                    <th>Recipients</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var notification in Model)
                                    {
                                        <tr>
                                            <td>@notification.Title</td>
                                            <td>@(notification.Message.Length > 50 ? notification.Message.Substring(0, 50) + "..." : notification.Message)</td>
                                            <td>
                                                <span class="badge bg-@(notification.Priority == "Critical" ? "danger" : notification.Priority == "High" ? "warning" : notification.Priority == "Medium" ? "info" : "secondary")">
                                                    @notification.Priority
                                                </span>
                                            </td>
                                            <td>@notification.NotificationUsers.Count</td>
                                            <td>@notification.CreatedDate.ToString("MM/dd/yyyy h:mm tt")</td>
                                            <td>
                                                <button class="btn btn-sm btn-danger delete-notification" data-id="@notification.NotificationId">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">No notifications found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Send Notification Modal -->
<div class="modal fade" id="sendNotificationModal" tabindex="-1" aria-labelledby="sendNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="sendNotificationModalLabel">Send Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="sendNotificationForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="notificationTitle" class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="notificationTitle" required maxlength="500">
                    </div>
                    <div class="mb-3">
                        <label for="notificationMessage" class="form-label">Message <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="notificationMessage" rows="4" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="notificationPriority" class="form-label">Priority <span class="text-danger">*</span></label>
                        <select class="form-select" id="notificationPriority" required>
                            <option value="">Select Priority</option>
                            <option value="Critical">Critical</option>
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="notificationExpiryDate" class="form-label">Expiry Date (Optional)</label>
                        <input type="datetime-local" class="form-control" id="notificationExpiryDate">
                    </div>
                    <div class="mb-3">
                        <label for="organizationSelect" class="form-label">Organization</label>
                        <select class="form-select" id="organizationSelect" multiple size="5">
                            <option value="all">Select All</option>
                        </select>
                        <small class="form-text text-muted">Hold Ctrl/Cmd to select multiple organizations</small>
                    </div>
                    <div class="mb-3">
                        <label for="userSelect" class="form-label">Users <span class="text-danger">*</span></label>
                        <select class="form-select" id="userSelect" multiple size="10" required>
                            <option value="all">Select All</option>
                        </select>
                        <small class="form-text text-muted">Hold Ctrl/Cmd to select multiple users</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Send Notification</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load organizations
            loadOrganizations();
            
            // Organization change handler
            $('#organizationSelect').on('change', function() {
                var selectedOrgs = $(this).val();
                if (selectedOrgs && selectedOrgs.includes('all')) {
                    // Select all organizations
                    $(this).find('option').prop('selected', true);
                    loadAllUsers();
                } else {
                    loadUsersByOrganizations(selectedOrgs);
                }
            });
            
            // User select all handler
            $('#userSelect').on('change', function() {
                var selected = $(this).val();
                if (selected && selected.includes('all')) {
                    $(this).find('option').prop('selected', true);
                }
            });
            
            // Form submit handler
            $('#sendNotificationForm').on('submit', function(e) {
                e.preventDefault();
                sendNotification();
            });
            
            // Delete notification handler
            $('.delete-notification').on('click', function() {
                if (confirm('Are you sure you want to delete this notification?')) {
                    var notificationId = $(this).data('id');
                    deleteNotification(notificationId);
                }
            });
        });
        
        function loadOrganizations() {
            $.get('/Notification/GetOrganizations', function(data) {
                var select = $('#organizationSelect');
                select.find('option:not(:first)').remove();
                $.each(data, function(index, org) {
                    select.append($('<option>', {
                        value: org.organizationId,
                        text: org.organizationName
                    }));
                });
            });
        }
        
        function loadUsersByOrganizations(organizationIds) {
            if (!organizationIds || organizationIds.length === 0) {
                $('#userSelect').find('option:not(:first)').remove();
                return;
            }
            
            var userIds = organizationIds.filter(id => id !== 'all');
            if (userIds.length === 0) {
                loadAllUsers();
                return;
            }
            
            var select = $('#userSelect');
            select.find('option:not(:first)').remove();
            select.append('<option>Loading...</option>');
            
            // Load users for each organization
            var allUsers = [];
            var loadedCount = 0;
            
            userIds.forEach(function(orgId) {
                $.get('/Notification/GetUsersByOrganization', { organizationId: orgId }, function(data) {
                    allUsers = allUsers.concat(data);
                    loadedCount++;
                    
                    if (loadedCount === userIds.length) {
                        // Remove duplicates
                        var uniqueUsers = [];
                        var userIdSet = new Set();
                        allUsers.forEach(function(user) {
                            if (!userIdSet.has(user.id)) {
                                userIdSet.add(user.id);
                                uniqueUsers.push(user);
                            }
                        });
                        
                        select.find('option:not(:first)').remove();
                        $.each(uniqueUsers, function(index, user) {
                            select.append($('<option>', {
                                value: user.id,
                                text: user.userName + ' (' + user.email + ')'
                            }));
                        });
                    }
                });
            });
        }
        
        function loadAllUsers() {
            $.get('/Notification/GetUsersByOrganization', function(data) {
                var select = $('#userSelect');
                select.find('option:not(:first)').remove();
                $.each(data, function(index, user) {
                    select.append($('<option>', {
                        value: user.id,
                        text: user.userName + ' (' + user.email + ')'
                    }));
                });
            });
        }
        
        function sendNotification() {
            var title = $('#notificationTitle').val();
            var message = $('#notificationMessage').val();
            var priority = $('#notificationPriority').val();
            var expiryDate = $('#notificationExpiryDate').val();
            var selectedUsers = $('#userSelect').val();
            
            if (!title || !message || !priority) {
                alert('Please fill in all required fields.');
                return;
            }
            
            if (!selectedUsers || selectedUsers.length === 0 || (selectedUsers.length === 1 && selectedUsers[0] === 'all')) {
                alert('Please select at least one user.');
                return;
            }
            
            // Remove 'all' from selected users if present
            var userIds = selectedUsers.filter(id => id !== 'all').map(id => parseInt(id));
            
            var formData = {
                title: title,
                message: message,
                priority: priority,
                expiryDate: expiryDate || null,
                userIds: userIds
            };
            
            $.ajax({
                url: '/Notification/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while sending the notification.');
                }
            });
        }
        
        function deleteNotification(notificationId) {
            $.ajax({
                url: '/Notification/Delete',
                type: 'POST',
                data: { id: notificationId },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting the notification.');
                }
            });
        }
    </script>
}

