@page
@model TpaSodManagement.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    .auth-page {
        min-height: 100vh;
    }
    .auth-card {
        border: none;
        box-shadow: none;
    }
    .auth-title {
        color: #2B2B2B !important;
        text-shadow: none;
    }
    .auth-btn-primary {
        background-color: #2B2B2B;
        border-color: #2B2B2B;
        color: #F6F4EE;
    }
    .auth-btn-primary:hover {
        background-color: #1a1a1a;
        border-color: #1a1a1a;
        color: #F6F4EE;
    }
    .auth-btn-outline {
        border-color: #2B2B2B;
        color: #2B2B2B;
        background-color: transparent;
    }
    .auth-btn-outline:hover {
        background-color: #2B2B2B;
        border-color: #2B2B2B;
        color: #F6F4EE;
    }
</style>

<div class="container-fluid auth-page min-vh-100 d-flex align-items-center justify-content-center">
    <div class="row w-100 justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="text-center mb-5">
                <h1 class="display-4 auth-title">Sod Management System</h1>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-md-9">
                    <div class="card auth-card">
                        <div class="card-body">
                            <h5 class="card-title" style="color:#2B2B2B;">Log in</h5>

                            <form asp-controller="Home" asp-action="Login" method="post" id="account">
                                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                <div class="form-floating mb-3">
                                    <input name="Input_Email" type="text" class="form-control" autocomplete="username" aria-required="true" />
                                    <label for="Input_Email" class="form-label">Email / Username</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                                <div class="form-floating mb-3">
                                    <input name="Input_Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" />
                                    <label for="Input_Password" class="form-label">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" name="Input_RememberMe" value="true" />
                                    <label style="color:#2B2B2B;" class="form-check-label" for="Input_RememberMe">
                                        Remember me
                                    </label>
                                </div>
                                <button id="login-submit" type="submit" class="btn auth-btn-primary w-100">Log in</button>
                            </form>

                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn auth-btn-outline w-100 mt-2">
                                Register
                            </a>

                            @* <div class="text-center mt-3">
                                <p class="mb-1">
                                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small">Forgot your password?</a>
                                </p>
                                <p class="mb-0">
                                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-decoration-none small">Resend email confirmation</a>
                                </p>
                            </div> *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}