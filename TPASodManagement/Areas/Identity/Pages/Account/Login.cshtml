@page
@model TpaSodManagement.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    .auth-page {
        min-height: 100vh;
    }
    .auth-card {
        border: none;
        box-shadow: none;
    }
    .auth-title {
        color: #2B2B2B !important;
        text-shadow: none;
    }
    .auth-btn-primary {
        background-color: #2B2B2B;
        border-color: #2B2B2B;
        color: #F6F4EE;
    }
    .auth-btn-primary:hover {
        background-color: #1a1a1a;
        border-color: #1a1a1a;
        color: #F6F4EE;
    }
    .auth-btn-outline {
        border-color: #2B2B2B;
        color: #2B2B2B;
        background-color: transparent;
    }
    .auth-btn-outline:hover {
        background-color: #2B2B2B;
        border-color: #2B2B2B;
        color: #F6F4EE;
    }
</style>

<div class="container-fluid auth-page min-vh-100 d-flex align-items-center justify-content-center">
    <div class="row w-100 justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="text-center mb-5">
                <h1 class="display-4 auth-title">Sod Management System</h1>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-md-9">
                    <div class="card auth-card">
                        <div class="card-body">
                            <h5 class="card-title" style="color:#2B2B2B;">Log in</h5>

                            <form asp-controller="Home" asp-action="Login" method="post" id="account">
                                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                <div class="form-floating mb-3">
                                    <input name="Input_Email" type="text" class="form-control" autocomplete="username" aria-required="true" />
                                    <label for="Input_Email" class="form-label">Email / Username</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                                <div class="form-floating mb-3">
                                    <input name="Input_Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" />
                                    <label for="Input_Password" class="form-label">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" name="Input_RememberMe" value="true" />
                                    <label style="color:#2B2B2B;" class="form-check-label" for="Input_RememberMe">
                                        Remember me
                                    </label>
                                </div>
                                <button id="login-submit" type="submit" class="btn auth-btn-primary w-100">Log in</button>
                            </form>

                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn auth-btn-outline w-100 mt-2">
                                Register
                            </a>

                            @* <div class="text-center mt-3">
                                <p class="mb-1">
                                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small">Forgot your password?</a>
                                </p>
                                <p class="mb-0">
                                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-decoration-none small">Resend email confirmation</a>
                                </p>
                            </div> *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Handle login form submission with AJAX for 2FA
        document.addEventListener('DOMContentLoaded', function() {
            var loginForm = document.getElementById('account');
            if (loginForm) {
                // Remove any existing error messages
                var existingErrors = loginForm.querySelectorAll('.alert-danger');
                existingErrors.forEach(function(err) { err.remove(); });
                
                loginForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Remove any existing error messages
                    var existingErrors = loginForm.querySelectorAll('.alert-danger');
                    existingErrors.forEach(function(err) { err.remove(); });
                    
                    var formData = new FormData(loginForm);
                    var submitBtn = document.getElementById('login-submit');
                    var originalText = submitBtn.textContent;
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Logging in...';

                    console.log('Sending login request...');
                    fetch('/Home/Login', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    })
                    .then(response => {
                        console.log('Response received:', response.status);
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log('Response data:', data);
                        submitBtn.disabled = false;
                        submitBtn.textContent = originalText;

                        if (data.success) {
                            if (data.requires2FA) {
                                console.log('2FA required, showing popup...');
                                // Show 2FA popup
                                show2FAPopup();
                            } else {
                                console.log('Login successful, redirecting...');
                                // Normal login success, redirect
                                window.location.href = data.redirectUrl || '/';
                            }
                        } else {
                            console.log('Login failed:', data.message);
                            // Show error message
                            var errorDiv = document.createElement('div');
                            errorDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
                            errorDiv.innerHTML = '<strong>Error:</strong> ' + (data.message || 'Login failed.') + 
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                            loginForm.insertBefore(errorDiv, loginForm.firstChild);
                            
                            // Remove error after 5 seconds
                            setTimeout(function() {
                                errorDiv.remove();
                            }, 5000);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        submitBtn.disabled = false;
                        submitBtn.textContent = originalText;
                        alert('An error occurred during login. Please try again.');
                    });
                    
                    return false;
                });
            } else {
                console.error('Login form not found!');
            }
        });

        // Make functions globally accessible
        window.show2FAPopup = function() {
            // Create modal HTML
            var modalHtml = `
                <div class="modal fade" id="twoFactorModal" tabindex="-1" aria-labelledby="twoFactorModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="twoFactorModalLabel">Two-Factor Authentication</h5>
                            </div>
                            <div class="modal-body">
                                <p>Please enter the verification code from your authenticator app.</p>
                                <form id="verify2faForm">
                                    <div class="form-floating mb-3">
                                        <input type="text" class="form-control" id="twoFactorCode" autocomplete="off" maxlength="6" required />
                                        <label for="twoFactorCode">Verification Code</label>
                                    </div>
                                    <div id="twoFactorError" class="alert alert-danger" style="display: none;"></div>
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" onclick="close2FAPopup()">Cancel</button>
                                <button type="button" class="btn auth-btn-primary" id="verify2faBtn" onclick="verify2FACode()">Verify</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Remove existing modal if any
            var existingModal = document.getElementById('twoFactorModal');
            if (existingModal) {
                existingModal.remove();
            }
            
            // Add modal to body
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            // Show modal
            var modal = new bootstrap.Modal(document.getElementById('twoFactorModal'));
            modal.show();
            
            // Focus on input
            setTimeout(function() {
                document.getElementById('twoFactorCode').focus();
            }, 500);
            
            // Allow Enter key to submit
            document.getElementById('twoFactorCode').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    verify2FACode();
                }
            });
        }

        window.verify2FACode = function() {
            var code = document.getElementById('twoFactorCode').value;
            var errorDiv = document.getElementById('twoFactorError');
            var verifyBtn = document.getElementById('verify2faBtn');
            
            if (!code || code.trim() === '') {
                errorDiv.textContent = 'Please enter a verification code.';
                errorDiv.style.display = 'block';
                return;
            }
            
            verifyBtn.disabled = true;
            verifyBtn.textContent = 'Verifying...';
            errorDiv.style.display = 'none';
            
            var formData = new FormData();
            formData.append('code', code);
            
            fetch('/Home/Verify2FA', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close modal
                    close2FAPopup();
                    // Redirect to home
                    window.location.href = data.redirectUrl || '/';
                } else {
                    errorDiv.textContent = data.message || 'Invalid verification code.';
                    errorDiv.style.display = 'block';
                    verifyBtn.disabled = false;
                    verifyBtn.textContent = 'Verify';
                    // Clear input
                    document.getElementById('twoFactorCode').value = '';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                errorDiv.textContent = 'An error occurred. Please try again.';
                errorDiv.style.display = 'block';
                verifyBtn.disabled = false;
                verifyBtn.textContent = 'Verify';
            });
        }

        window.close2FAPopup = function() {
            var modalElement = document.getElementById('twoFactorModal');
            if (modalElement) {
                var modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) {
                    modal.hide();
                }
                modalElement.remove();
            }
        }
    </script>
}