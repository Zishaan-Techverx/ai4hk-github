@page
@model TpaSodManagement.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<style>
    .auth-page {
        min-height: 100vh;
    }
    .auth-card {
        border: none;
        box-shadow: none;
    }
    .auth-title {
        color: #2B2B2B !important;
        text-shadow: none;
    }
    .auth-btn-primary {
        background-color: #2B2B2B;
        border-color: #2B2B2B;
        color: #F6F4EE;
    }
    .auth-btn-primary:hover {
        background-color: #1a1a1a;
        border-color: #1a1a1a;
        color: #F6F4EE;
    }
    .auth-btn-outline {
        border-color: #2B2B2B;
        color: #2B2B2B;
        background-color: transparent;
    }
    .auth-btn-outline:hover {
        background-color: #2B2B2B;
        border-color: #2B2B2B;
        color: #F6F4EE;
    }
</style>

<div class="container-fluid auth-page min-vh-100 d-flex align-items-center justify-content-center">
    <div class="row w-100 justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="text-center mb-5">
                <h1 class="display-4 auth-title">Sod Management System</h1>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-md-9">
                    <div class="card auth-card">
                        <div class="card-body">
                            <h5 class="card-title" style="color:#2B2B2B;">Register</h5>

                            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.FirstName" class="form-control" id="registerFirstName" required />
                                    <label for="registerFirstName">First Name</label>
                                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                    <div class="invalid-feedback">
                                        Please provide your first name.
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.LastName" class="form-control" id="registerLastName" required />
                                    <label for="registerLastName">Last Name</label>
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                    <div class="invalid-feedback">
                                        Please provide your last name.
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" id="registerEmail" required />
                                    <label for="registerEmail">Email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    <div class="invalid-feedback">
                                        Please provide a valid email.
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.FarmId" class="form-label" style="color:#2B2B2B;">Farm</label>
                                    <select asp-for="Input.FarmId" 
                                            class="form-select" 
                                            asp-items='@(ViewData["Farms"] as SelectList)' 
                                            id="registerFarm" 
                                            required>
                                        <option value="">-- Select Farm --</option>
                                    </select>
                                    <span asp-validation-for="Input.FarmId" class="text-danger"></span>
                                    <div class="invalid-feedback">
                                        Please select a farm.
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" id="registerPassword" required />
                                    <label for="registerPassword">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                    <div class="invalid-feedback">
                                        Please provide a password.
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" id="registerConfirm" required />
                                    <label for="registerConfirm">Confirm Password</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                    <div class="invalid-feedback">
                                        Please confirm your password.
                                    </div>
                                </div>

                                <button id="registerSubmit" type="submit" class="btn auth-btn-primary w-100">Register</button>
                            </form>

                            <a href="/" class="btn auth-btn-outline w-100 mt-2">
                                Login Existing User
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                Array.from(document.getElementsByClassName('needs-validation')).forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}